+
    *pDevice = kk_device_to_handle(dev);
 
    return VK_SUCCESS;
@@ -374,6 +457,8 @@ kk_DestroyDevice(VkDevice _device, const VkAllocationCallbacks *pAllocator)
    if (!dev)
       return;
 
+   kk_device_note_lifecycle(dev, false);
+
    /* End capture before we start releasing resources. Otherwise, Metal capture
     * may run into issues. */
    if (pdev->settings.gpu_capture_enabled) {
