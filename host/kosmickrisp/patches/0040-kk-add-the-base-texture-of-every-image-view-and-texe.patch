 src/kosmickrisp/vulkan/kk_image.h          | 11 ++++++++
 src/kosmickrisp/vulkan/kk_image_view.c     |  7 ++++-
 src/kosmickrisp/vulkan/kk_wsi.c            |  4 +++
 10 files changed, 97 insertions(+), 7 deletions(-)

diff --git a/src/kosmickrisp/bridge/mtl_texture.h b/src/kosmickrisp/bridge/mtl_texture.h
index 53e016e..8501828 100644
--- a/src/kosmickrisp/bridge/mtl_texture.h
+++ b/src/kosmickrisp/bridge/mtl_texture.h
@@ -16,6 +16,11 @@ struct kk_view_layout;
 
 /* Utils*/
 uint64_t mtl_texture_get_gpu_resource_id(mtl_texture *texture);
+/* The texture a view was made from (parentTexture, recursively), else the
+ * texture itself. Not retained. Metal 4 validation accepts an attachment only
+ * when this base texture is in a residency set; the heap it was placed in or
+ * the buffer it was made from do not count. */
+mtl_texture *mtl_texture_get_base(mtl_texture *texture);
 
 /* Texture view creation */
 mtl_texture *mtl_new_texture_view_with(mtl_texture *texture,
diff --git a/src/kosmickrisp/bridge/mtl_texture.m b/src/kosmickrisp/bridge/mtl_texture.m
index c410a42..d000860 100644
--- a/src/kosmickrisp/bridge/mtl_texture.m
+++ b/src/kosmickrisp/bridge/mtl_texture.m
@@ -23,6 +23,15 @@
    }
 }
 
+mtl_texture *
+mtl_texture_get_base(mtl_texture *texture)
+{
+   id<MTLTexture> tex = (id<MTLTexture>)texture;
+   while (tex.parentTexture)
+      tex = tex.parentTexture;
+   return tex;
+}
+
 /* TODO_KOSMICKRISP This should be part of the mapping */
 static uint32_t
 mtl_texture_view_type(uint32_t type, uint8_t sample_count)
diff --git a/src/kosmickrisp/bridge/stubs/mtl_texture.c b/src/kosmickrisp/bridge/stubs/mtl_texture.c
index b05c000..6636261 100644
--- a/src/kosmickrisp/bridge/stubs/mtl_texture.c
+++ b/src/kosmickrisp/bridge/stubs/mtl_texture.c
@@ -13,6 +13,12 @@ mtl_texture_get_gpu_resource_id(mtl_texture *texture)
    return 0u;
 }
 
+mtl_texture *
+mtl_texture_get_base(mtl_texture *texture)
+{
+   return texture;
+}
+
 /* Texture view creation */
 mtl_texture *
 mtl_new_texture_view_with(mtl_texture *texture,
diff --git a/src/kosmickrisp/vulkan/kk_buffer_view.c b/src/kosmickrisp/vulkan/kk_buffer_view.c
index 51d2048..5674962 100644
--- a/src/kosmickrisp/vulkan/kk_buffer_view.c
+++ b/src/kosmickrisp/vulkan/kk_buffer_view.c
@@ -137,6 +137,7 @@ kk_CreateBufferView(VkDevice _device, const VkBufferViewCreateInfo *pCreateInfo,
          vk_buffer_view_destroy(&dev->vk, pAllocator, &view->vk);
          return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
       }
+      kk_device_add_texture_to_residency_set(dev, view->mtl_texel_buffer_handle);
    }
    view->texel_buffer_gpu_id =
       mtl_texture_get_gpu_resource_id(view->mtl_texel_buffer_handle);
@@ -158,6 +159,9 @@ kk_DestroyBufferView(VkDevice _device, VkBufferView bufferView,
 
    if (view->sparse)
       kk_buffer_view_sparse_finish(dev, view);
+   else
+      kk_device_remove_texture_from_residency_set(
+         dev, view->mtl_texel_buffer_handle);
    mtl_release(view->mtl_texel_buffer_handle);
    vk_buffer_view_destroy(&dev->vk, pAllocator, &view->vk);
 }
diff --git a/src/kosmickrisp/vulkan/kk_device.c b/src/kosmickrisp/vulkan/kk_device.c
index 78b70f6..e1d81d0 100644
--- a/src/kosmickrisp/vulkan/kk_device.c
+++ b/src/kosmickrisp/vulkan/kk_device.c
@@ -564,6 +564,22 @@ kk_device_remove_allocation_from_residency_set(struct kk_device *dev,
    simple_mtx_unlock(&dev->residency_set.mutex);
 }
 
+void
+kk_device_add_texture_to_residency_set(struct kk_device *dev,
+                                       mtl_texture *texture)
+{
+   kk_device_add_allocation_to_residency_set(dev,
+                                             mtl_texture_get_base(texture));
+}
+
+void
+kk_device_remove_texture_from_residency_set(struct kk_device *dev,
+                                            mtl_texture *texture)
+{
+   kk_device_remove_allocation_from_residency_set(
+      dev, mtl_texture_get_base(texture));
+}
+
 void
 kk_device_make_resources_resident(struct kk_device *dev)
 {
diff --git a/src/kosmickrisp/vulkan/kk_device.h b/src/kosmickrisp/vulkan/kk_device.h
index 256760c..27f6627 100644
--- a/src/kosmickrisp/vulkan/kk_device.h
+++ b/src/kosmickrisp/vulkan/kk_device.h
@@ -141,6 +141,15 @@ void kk_device_add_allocation_to_residency_set(struct kk_device *dev,
                                                mtl_allocation *allocation);
 void kk_device_remove_allocation_from_residency_set(
    struct kk_device *dev, mtl_allocation *allocation);
+/* Textures made from a heap or a buffer (and the base of views made from such
+ * a texture): Metal 4 takes an attachment as resident only when its base
+ * texture object is in a residency set, its heap or buffer does not count.
+ * Every texture the driver makes this way is added once by its owner and
+ * removed before its release. */
+void kk_device_add_texture_to_residency_set(struct kk_device *dev,
+                                            mtl_texture *texture);
+void kk_device_remove_texture_from_residency_set(struct kk_device *dev,
+                                                 mtl_texture *texture);
 void kk_device_make_resources_resident(struct kk_device *dev);
 
 /* The guest application of a device ("gamescope", "steamwebhelper (mesa
diff --git a/src/kosmickrisp/vulkan/kk_image.c b/src/kosmickrisp/vulkan/kk_image.c
index 26bed10..74c7c0c 100644
--- a/src/kosmickrisp/vulkan/kk_image.c
+++ b/src/kosmickrisp/vulkan/kk_image.c
@@ -651,11 +651,35 @@ kk_image_plane_size_align_B(struct kk_device *dev, const struct kk_image *image,
    *align_B_out = plane->layout.align_B;
 }
 
+static void
+kk_image_plane_add_to_residency_set(struct kk_device *dev,
+                                    struct kk_image_plane *plane)
+{
+   if (plane->mtl_handle)
+      kk_device_add_texture_to_residency_set(dev, plane->mtl_handle);
+   if (plane->mtl_handle_array)
+      kk_device_add_texture_to_residency_set(dev, plane->mtl_handle_array);
+   plane->resident = true;
+}
+
+void
+kk_image_plane_remove_from_residency_set(struct kk_device *dev,
+                                         struct kk_image_plane *plane)
+{
+   if (plane->mtl_handle)
+      kk_device_remove_texture_from_residency_set(dev, plane->mtl_handle);
+   if (plane->mtl_handle_array)
+      kk_device_remove_texture_from_residency_set(dev, plane->mtl_handle_array);
+   plane->resident = false;
+}
+
 static void
 kk_image_plane_finish(struct kk_device *dev, struct kk_image_plane *plane,
                       VkImageCreateFlags create_flags,
                       const VkAllocationCallbacks *pAllocator)
 {
+   if (plane->resident)
+      kk_image_plane_remove_from_residency_set(dev, plane);
    if (plane->mtl_handle != NULL)
       mtl_release(plane->mtl_handle);
    if (plane->mtl_handle_array != NULL)
@@ -701,8 +725,7 @@ kk_CreateImage(VkDevice _device, const VkImageCreateInfo *pCreateInfo,
 
    /* Sparse textures map heap pages, the texture itself must be resident */
    if (image->vk.create_flags & VK_IMAGE_CREATE_SPARSE_BINDING_BIT)
-      kk_device_add_allocation_to_residency_set(dev,
-                                                image->planes[0].mtl_handle);
+      kk_image_plane_add_to_residency_set(dev, &image->planes[0]);
 
    *pImage = kk_image_to_handle(image);
 
@@ -719,10 +742,6 @@ kk_DestroyImage(VkDevice device, VkImage _image,
    if (!image)
       return;
 
-   if (image->vk.create_flags & VK_IMAGE_CREATE_SPARSE_BINDING_BIT)
-      kk_device_remove_allocation_from_residency_set(
-         dev, image->planes[0].mtl_handle);
-
    kk_image_finish(dev, image, pAllocator);
    vk_free2(&dev->vk.alloc, pAllocator, image);
 }
@@ -1021,6 +1040,8 @@ kk_image_plane_bind(struct kk_device *dev, struct kk_image *image,
                                 image->vk.base.object_name);
    }
 
+   kk_image_plane_add_to_residency_set(dev, plane);
+
    *offset_B += plane_size_B;
 
    return VK_SUCCESS;
diff --git a/src/kosmickrisp/vulkan/kk_image.h b/src/kosmickrisp/vulkan/kk_image.h
index c4f14d2..bec0cce 100644
