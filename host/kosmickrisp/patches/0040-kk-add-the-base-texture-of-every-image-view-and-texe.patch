@@ -17,6 +17,7 @@
 
 #include "vk_image.h"
 
+struct kk_device;
 struct kk_device_memory;
 struct kk_physical_device;
 struct kk_queue;
@@ -40,6 +41,11 @@ struct kk_image_plane {
    /* Metal handle with 2D array type for 3D images */
