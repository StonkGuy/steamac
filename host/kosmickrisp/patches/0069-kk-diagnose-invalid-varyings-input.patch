From: FX Steam Launcher <dev@fxgam.es>
Subject: [PATCH] kk: diagnose malformed NIR before varyings optimization (STEAMAC-5T)

STEAMAC-5T terminated during DCE under varying optimization. The cause of
invalid NIR has not been established. Check the instruction classes, opcode
bounds and SSA sources before each bulk varying pass, recording stage and
the source BLAKE3 before rejecting malformed input. This does not change
valid shader optimization or claim to fix corruption introduced inside
varying optimization. Keep the diagnostic local to KK, not generic NIR DCE.

Generated-by: LLM

---
diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -1316,6 +1316,45 @@
    *shader_out = shader;
 
    return VK_SUCCESS;
+}
+
+static bool
+kk_nir_source_present(nir_src *src, void *data)
+{
+   return src->ssa != NULL;
+}
+
+static bool
+kk_nir_check_varyings_input(nir_shader *nir, unsigned pass)
+{
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            const char *reason = NULL;
+            if (instr->type > nir_instr_type_cmat_call)
+               reason = "invalid instruction type";
+            else if (instr->type == nir_instr_type_intrinsic &&
+                     nir_instr_as_intrinsic(instr)->intrinsic >=
+                        nir_num_intrinsics)
+               reason = "invalid intrinsic opcode";
+            else if (instr->type == nir_instr_type_alu &&
+                     nir_instr_as_alu(instr)->op >= nir_num_opcodes)
+               reason = "invalid ALU opcode";
+            else if (!nir_foreach_src(instr, kk_nir_source_present, NULL))
+               reason = "NULL SSA source";
+            if (reason) {
+               char hash[BLAKE3_HEX_LEN];
+               _mesa_blake3_format(hash, nir->info.source_blake3);
+               fprintf(stderr, "kk: invalid NIR before varyings pass %u: "
+                               "stage=%s shader=%s instruction=%u: %s\n",
+                       pass, _mesa_shader_stage_to_string(nir->info.stage),
+                       hash, instr->type, reason);
+               return false;
+            }
+         }
+      }
+   }
+   return true;
 }
 
 static void
@@ -2438,13 +2477,18 @@
                                  nir_shaders[total_shaders - 1u]);
    }
 
-   nir_opt_varyings_bulk(nir_shaders, total_shaders, true, UINT32_MAX,
