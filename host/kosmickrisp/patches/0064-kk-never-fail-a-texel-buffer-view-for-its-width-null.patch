From 1112dd6f7d9116567f82ac3eb1f8358af4b9d804 Mon Sep 17 00:00:00 2001
From: steamac <steamac@local>
Date: Fri, 23 Oct 2026 16:05:00 +0200
Subject: [PATCH] kk: never fail a texel buffer view for its width; null or
 narrowed instead

0059 returns VK_ERROR_OUT_OF_DEVICE_MEMORY for a texel buffer view of zero
elements or of more than maxTexelBufferElements, which keeps both Metal
texture-buffer constructors from aborting the VM on such a descriptor. Under
Venus that error never reaches the guest: vkCreateBufferView is asynchronous
there (vn_async_vkCreateBufferView), the guest keeps a handle for a view the
host does not have, and the first vkUpdateDescriptorSets that names it is a
command-stream error that kills the guest process ("failed to look up object
N of type 13"). Dragon's Dogma 2 died this way at the end of loading a save,
twice in a row: vkd3d-proton makes typed buffer views over a buffer's whole
range without clamping to maxTexelBufferElements (about 89M elements here,
Metal's 2^28 less a sparse page, divided by three for RGB32), and RE Engine's
buffers are larger.

A view of zero elements is now a null descriptor, as a view of an unsupported
format already is (its descriptors read zero), and a view past the limit is
narrowed to it, so that its texels past the limit read as out of bounds (what
the RGB32 path did before 0059). Each is logged once. Neither case reaches
Metal, so 0059's crashes stay fixed.

Repro texture_descriptors.c: every case now expects VK_SUCCESS; the invalid
ones are reported as accepted without Metal.

Generated-by: LLM
---
 src/kosmickrisp/vulkan/kk_buffer_view.c | 57 ++++++++++++++++++++-----
 1 file changed, 46 insertions(+), 11 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_buffer_view.c b/src/kosmickrisp/vulkan/kk_buffer_view.c
index f26286c..0b0e010 100644
--- a/src/kosmickrisp/vulkan/kk_buffer_view.c
+++ b/src/kosmickrisp/vulkan/kk_buffer_view.c
@@ -7,6 +7,8 @@
 
 #include "kk_buffer_view.h"
 
+#include <inttypes.h>
+
 #include "kk_buffer.h"
 #include "kk_descriptor_types.h"
 #include "kk_device.h"
@@ -98,6 +100,30 @@ kk_buffer_view_warn_unsupported(VkFormat format, bool sparse)
              vk_Format_to_str(format), sparse ? " in sparse buffers" : "");
 }
 
+/* Once per process each: the guest's own usage error, not a driver fault */
+static void
+kk_buffer_view_warn_zero_elements(VkFormat format)
+{
+   static atomic_bool warned;
+   if (atomic_exchange(&warned, true))
+      return;
+   mesa_logw("kk: a texel buffer view of %s has zero elements; it reads as a "
+             "null descriptor",
+             vk_Format_to_str(format));
+}
+
+static void
+kk_buffer_view_warn_oversized(VkFormat format, uint64_t elements)
+{
+   static atomic_bool warned;
+   if (atomic_exchange(&warned, true))
+      return;
+   mesa_logw("kk: a texel buffer view of %s has %" PRIu64 " elements, past "
+             "maxTexelBufferElements (%u); it is narrowed to the limit",
+             vk_Format_to_str(format), elements,
+             (unsigned)KK_MAX_TEXEL_BUFFER_ELEMENTS);
+}
+
 VKAPI_ATTR VkResult VKAPI_CALL
 kk_CreateBufferView(VkDevice _device, const VkBufferViewCreateInfo *pCreateInfo,
                     const VkAllocationCallbacks *pAllocator,
@@ -128,15 +154,25 @@ kk_CreateBufferView(VkDevice _device, const VkBufferViewCreateInfo *pCreateInfo,
 
    /* VK_WHOLE_SIZE rounds down to complete texels; it can produce zero
     * elements. The guest may also exceed maxTexelBufferElements (including
-    * with VK_WHOLE_SIZE, VUID 04059). Neither case is a Metal descriptor:
-    * fail here, before narrowing the width or calling either texture API.
-    */
-   if (view->vk.elements == 0 ||
-       view->vk.elements > KK_MAX_TEXEL_BUFFER_ELEMENTS) {
-      vk_buffer_view_destroy(&dev->vk, pAllocator, &view->vk);
-      return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
-                       "Texel buffer view has zero elements or exceeds "
-                       "maxTexelBufferElements");
+    * with VK_WHOLE_SIZE, VUID 04059; vkd3d-proton makes typed views over a
+    * buffer's whole range without clamping). Neither case is a Metal
+    * descriptor (both texture-buffer constructors abort on them), and neither
+    * may fail here: under Venus vkCreateBufferView is asynchronous
+    * (vn_async_vkCreateBufferView), so the guest never learns of an error and
+    * the first descriptor update that names the view is a command-stream
+    * error that kills the guest process (Dragon's Dogma 2 at the end of
+    * loading a save). A view of zero elements is a null descriptor, as an
+    * unsupported format is; a view past the limit is narrowed to it, and its
+    * texels past the limit read as out of bounds. */
+   if (view->vk.elements == 0) {
+      kk_buffer_view_warn_zero_elements(view->vk.format);
+      *pBufferView = kk_buffer_view_to_handle(view);
+      return VK_SUCCESS;
+   }
+   uint64_t elements = view->vk.elements;
+   if (elements > KK_MAX_TEXEL_BUFFER_ELEMENTS) {
+      kk_buffer_view_warn_oversized(view->vk.format, elements);
+      elements = KK_MAX_TEXEL_BUFFER_ELEMENTS;
    }
 
    enum mtl_texture_usage usage = MTL_TEXTURE_USAGE_SHADER_READ;
@@ -169,8 +205,7 @@ kk_CreateBufferView(VkDevice _device, const VkBufferViewCreateInfo *pCreateInfo,
       texture_offset = mtl_offset;
    }
    view->texel_offset = (mtl_offset - texture_offset) / texel_B;
-   const uint64_t width_px =
-      view->vk.elements * (rgb32 ? 3ull : 1ull) + view->texel_offset;
+   const uint64_t width_px = elements * (rgb32 ? 3ull : 1ull) + view->texel_offset;
    assert(width_px <= KK_MTL_MAX_TEXEL_BUFFER_ELEMENTS);
    if (rgb32)
       view->texel_offset |= KK_TEXEL_BUFFER_RGB32;
-- 
