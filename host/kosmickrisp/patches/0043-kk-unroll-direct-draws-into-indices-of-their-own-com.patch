From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: steamac <steamac@local>
Date: Tue, 13 Oct 2026 01:00:00 +0300
Subject: [PATCH 43/44] kk: unroll direct draws into indices of their own
 command buffer

STEAMAC-G follow-up. The unroll kernel allocated the indices it writes from
the device's 128 MB geometry heap, which the first unroll of every command
buffer and every render pass reset to its start (kk_heap). That is only safe
while the queue runs every pass after the previous one ended (end_encoder's
barrier before all queue stages), which it does today: a command buffer that
waits for a timeline semaphore at its submission and another one unrolling
other indices submitted after it keep their own colors, the second starting
after the first's 2.2 ms (host/moltenvk/repro provoking_last.c, before and
after this patch). Direct draws (indexed, or without an index buffer past the
CPU unroll's 1M indices) know their counts at recording: their unroll gets a
heap of its own in command buffer memory, sized for poly_setup_unroll_for_draw's
upper bound. No reset dispatch, nothing shared with other command buffers or
render passes, and no 128 MB device heap for processes that only unroll direct
draws (zink's). Indirect draws, tessellation and geometry shaders, whose sizes
only the GPU knows, keep the device heap.
---
 src/kosmickrisp/vulkan/kk_cmd_draw.c | 93 ++++++++++++++++++++++++----
 1 file changed, 82 insertions(+), 11 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index 46ea34e..34917cf 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -1058,13 +1058,17 @@ kk_flush_pipeline(struct kk_cmd_buffer *cmd)
    }
 }
 
+/* The device heap: GPU allocations whose sizes only the GPU knows
+ * (tessellation, geometry shaders, unrolls of indirect draws) */
+#define KK_HEAP_SIZE_B (128u * 1024u * 1024u)
+
 static void
 kk_init_heap(const void *data)
 {
    struct kk_cmd_buffer *cmd = (struct kk_cmd_buffer *)data;
    struct kk_device *dev = kk_cmd_buffer_device(cmd);
 
-   size_t size = 128 * 1024 * 1024;
+   size_t size = KK_HEAP_SIZE_B;
    kk_alloc_bo(dev, &dev->vk.base, size, 0, &dev->heap);
 
    struct poly_heap *map = (struct poly_heap *)dev->heap->cpu;
@@ -1807,10 +1811,65 @@ kk_unroll_geometry_cpu(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
    return true;
 }
 
+/* Upper bound of the indices an unroll of direct draws writes (what
+ * poly_setup_unroll_for_draw allocates for each), UINT64_MAX for indirect
+ * draws: only the GPU knows their counts. */
+static uint64_t
+kk_direct_unroll_size_B(const struct kk_draw_command *data)
+{
+   if (data->indirect)
+      return UINT64_MAX;
+
+   const uint32_t per_prim = mesa_vertices_per_prim(data->prim);
+   uint64_t size_B = 0u;
+   for (uint32_t i = 0u; i < data->draw_count; i++) {
+      const uint32_t count = data->indexed ? data->indexed_draws[i].indexCount
+                                           : data->draws[i].vertexCount;
+      size_B += align64((uint64_t)u_decomposed_prims_for_vertices(
+                           data->prim, count) *
+                           per_prim * sizeof(uint32_t),
+                        16u);
+   }
+   return size_B;
+}
+
+/* The heap an unroll allocates its indices from, and their range. Direct
+ * draws get one of their own in command buffer memory, sized for the draws
+ * (direct_size_B, kk_direct_unroll_size_B): no reset, nothing shared with
+ * other command buffers or render passes, and no device heap for processes
+ * that only unroll direct draws. The device heap is reset to its start by the
+ * first unroll of every command buffer and render pass (kk_heap), which is
+ * only safe while the queue runs every pass after the previous one ended
+ * (end_encoder's barrier). */
+static uint64_t
+kk_unroll_heap(struct kk_cmd_buffer *cmd, uint64_t direct_size_B,
+               struct kk_addr_range *indices)
+{
+   if (direct_size_B < KK_HEAP_SIZE_B) {
+      /* poly_heap_alloc_offs fails an allocation that reaches the size */
+      const uint32_t size_B = direct_size_B + 16u;
+      struct kk_ptr mem = kk_pool_alloc(cmd, size_B, 16u);
+      struct kk_ptr heap = kk_pool_alloc(cmd, sizeof(struct poly_heap), 16u);
+      if (likely(mem.gpu && heap.gpu)) {
+         *(struct poly_heap *)heap.cpu = (struct poly_heap){
+            .base = mem.gpu,
+            .size = size_B,
+         };
+         *indices = (struct kk_addr_range){.addr = mem.gpu, .range = size_B};
+         return heap.gpu;
+      }
+   }
+
+   const uint64_t heap = kk_heap(cmd);
+   *indices = kk_heap_indices(cmd);
+   return heap;
+}
+
