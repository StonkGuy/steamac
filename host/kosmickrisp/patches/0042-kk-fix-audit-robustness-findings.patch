diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index cc99c3e..875fdf9 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -2640,7 +2640,13 @@ msl_split_sparse_fetch(nir_builder *b, nir_instr *instr, void *data)
       nir_instr *user = nir_src_use_instr(src);
       if (user == nir_def_instr(code))
          continue;
-      assert(!nir_src_is_if(src) && user->type == nir_instr_type_alu);
+      /* -Db_ndebug=true drops the assert, so a non-ALU user (a surviving
+       * phi, a tex/intrinsic, an if-condition) would make container_of()
+       * yield a bogus nir_alu_src and the swizzle writes below corrupt
+       * memory. Such a user never reads the residency code the way an ALU
+       * swizzle does, so leave it (and its def) alone. */
+      if (nir_src_is_if(src) || user->type != nir_instr_type_alu)
+         continue;
       nir_alu_instr *alu = nir_instr_as_alu(user);
       nir_alu_src *alu_src = container_of(src, nir_alu_src, src);
       const unsigned srcn = alu_src - alu->src;
diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index 41dde3d..aa7bee0 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -2906,6 +2906,14 @@ kk_begin_end_xfb(struct kk_cmd_buffer *cmd, uint32_t first_counter,
          continue;
 
       uint32_t idx = first_counter + i;
+      /* params is libkk_xfb_counter_copy with fixed src[4]/dest[4] and the
+       * copy kernel indexes both by the same slot, so an index past the
+       * last stream buffer would write out of bounds (the host stack
+       * here). Only POLY_MAX_SO_BUFFERS streams exist, so ignore a
+       * firstCounterRange past them (invalid per the spec's counterRange
+       * bound). */
+      if (idx >= POLY_MAX_SO_BUFFERS)
+         continue;
       if (begin) {
          params.src[idx] = addr;
       } else {
