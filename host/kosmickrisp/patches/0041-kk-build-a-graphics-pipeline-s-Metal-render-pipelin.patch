+
+/* MESA_KK_ASYNC_PIPELINES: one job per program. The job owns the copies of the
+ * MSL and the descriptor inputs, so it neither reads nor holds the program: the
+ * program can be created, used (draws skip it while this runs) and even be
+ * destroyed while the job runs, as long as something waits for it
+ * (kk_shader_destroy). */
+struct kk_async_job {
+   struct kk_device *dev;
+   struct kk_async_pipeline *async;
+};
+
+static void
+kk_async_pipeline_free(struct kk_async_pipeline *async)
+{
+   /* The MSL copies are ralloc children of the pipeline */
+   ralloc_free(async->vs_msl.code);
+   ralloc_free(async->vs_msl.entrypoint_name);
+   ralloc_free(async->fs_msl.code);
+   ralloc_free(async->fs_msl.entrypoint_name);
+   ralloc_free(async);
+}
+
+/* Builds the render pipeline state. Only a worker thread runs this, so no
+ * recording or submission thread ever waits for Metal. Reads the MSL copy the
+ * state owns and publishes the handle through pipe->gfx.render. */
+static bool
+kk_async_pipeline_build(struct kk_device *dev, struct kk_async_pipeline *async)
+{
+   struct kk_pipeline_handles *pipe = async->pipe;
+   mtl_render_pipeline_state *render = kk_new_render_pipeline(
+      dev, pipe, async->topology, async->rt_formats, async->view_mask,
+      async->sample_count, async->has_ms, &async->vs_msl, &async->fs_msl);
+
+   if (render == NULL)
+      return false;
+
+   /* Publish once: a draw may already have taken the state for ready and there
+    * must be no second handle left behind. */
+   if (p_atomic_cmpxchg_ptr(&pipe->gfx.render, NULL, render) != NULL) {
+      mtl_release(render);
+      return true;
+   }
+   return true;
+}
+
+static void
+kk_async_pipeline_worker(void *job_data, void *gdata, int thread_index)
+{
+   struct kk_async_job *job = job_data;
+   struct kk_async_pipeline *async = job->async;
+
+   const bool built = kk_async_pipeline_build(job->dev, async);
+   p_atomic_set(&async->status,
+                built ? (unsigned)KK_ASYNC_READY : (unsigned)KK_ASYNC_FAILED);
+}
+
+/* Called by util_queue when the job is dropped instead of run: the queue is
+ * being destroyed with it still queued, so no worker will run it. The job is
+ * left failed: only the worker builds the state, and a device that is shutting
+ * down has no draw left that could care. It is also called by the worker right
+ * after the job ran, where the status check returns immediately.
+ *
+ * This is the job's only owner after util_queue_add_job: the queue stores the
+ * job pointer, not a copy (u_queue.c), so the allocation has to outlive the
+ * queue's reference to it and is freed here, on either of the two paths above
+ * (the worker runs this after signalling the fence; a drop calls it). */
+static void
+kk_async_pipeline_cleanup(void *job_data, void *gdata, int thread_index)
+{
+   struct kk_async_job *job = job_data;
+   struct kk_async_pipeline *async = job->async;
+
+   if (p_atomic_read(&async->status) == KK_ASYNC_PENDING)
+      p_atomic_set(&async->status, (unsigned)KK_ASYNC_FAILED);
+
+   vk_free(&job->dev->vk.alloc, job);
+}
+
+/* Queues the state's compilation. The job only carries the pointer to the
+ * state and is owned by the queue from util_queue_add_job on: it is released by
+ * kk_async_pipeline_cleanup once the worker ran it, or in util_queue_drop_job
+ * (kk_shader_destroy, device teardown). The fence is only signalled after the
+ * state is published and before the job is freed. */
+static void
+kk_async_pipeline_start(struct kk_device *dev, struct kk_async_pipeline *async)
+{
+   struct kk_async_job *job = vk_alloc(&dev->vk.alloc, sizeof(*job), 8,
+                                       VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (unlikely(job == NULL)) {
+      /* Nothing to queue the job with: leave the state failed rather than build
+       * it here, so that even this thread never waits for Metal. */
+      p_atomic_set(&async->status, (unsigned)KK_ASYNC_FAILED);
+      return;
+   }
+
+   job->dev = dev;
+   job->async = async;
+
+   util_queue_add_job(&dev->pipeline_queue, job, &async->fence,
+                      kk_async_pipeline_worker, kk_async_pipeline_cleanup,
+                      sizeof(*job));
+
+   if (KK_DEBUG(ASYNC))
+      mesa_logi("kk: async render pipeline state queued");
+}
