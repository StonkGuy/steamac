+/* MESA_KK_ASYNC_PIPELINES: the Metal render pipeline state (the expensive part
+ * of a graphics pipeline) is built by a worker thread through the same
+ * synchronous Metal call the default path uses, so this changes only when it
+ * happens, never how. The other handles of kk_pipeline_handles.gfx (pre-render
+ * compute, GS, depth/stencil) are still built at creation: they are cheap next
+ * to the render pipeline.
+ *
+ * One instance per program (its VS), stored in kk_shader.async. Created by the
+ * pipeline creation thread before the program is visible to any other thread,
+ * waited for by kk_shader_destroy before the program releases (and thus before
+ * anything the worker writes is freed). No other thread takes a reference: a
+ * draw either finds the state ready, or skips the draw (kk_cmd_shader_pipeline)
+ * without touching this. */
+struct kk_async_pipeline {
+   /* Where the worker publishes the state: the program's handles. */
+   struct kk_pipeline_handles *pipe;
+
+   /* The render pipeline descriptor's inputs and the two stages' MSL, copied
+    * so the worker never reads the program (its MSL may be freed while the job
+    * runs). */
+   enum mtl_primitive_topology_class topology;
+   enum mtl_pixel_format rt_formats[MAX_DRAW_BUFFERS];
+   uint32_t view_mask;
+   uint32_t sample_count;
+   bool has_ms;
+   struct msl_compile_data vs_msl;
+   struct msl_compile_data fs_msl;
+
+   /* Signalled by the worker after pipe->gfx.render is set, or by the queue
+    * when the job is dropped without running (device teardown). Only a
+    * submission that already re-recorded a command buffer (mode 1) and the
+    * program's own destruction wait on it; a draw never does. */
+   struct util_queue_fence fence;
+   /* KK_ASYNC_PENDING, KK_ASYNC_READY or KK_ASYNC_FAILED; read by every draw
+    * without waiting (kk_shader_async_draw_ok). */
+   unsigned status;
+};
+
+enum kk_async_status {
+   /* Still compiling: pipe->gfx.render is not usable yet */
+   KK_ASYNC_PENDING = 0,
+   KK_ASYNC_READY,
+   KK_ASYNC_FAILED,
+};
