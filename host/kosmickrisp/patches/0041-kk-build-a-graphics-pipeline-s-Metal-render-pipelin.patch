+enum kk_async_action
+kk_shader_async_draw_ok(struct kk_cmd_buffer *cmd, struct kk_shader *program,
+                        bool *not_ready)
+{
+   struct kk_async_pipeline *async = program->async;
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+
+   /* MESA_KK_ASYNC_PIPELINES=2: never wait for the compile, anywhere. A draw it
+    * is not ready for is dropped here and on every replay; the state is used by
+    * command buffers recorded after it is published. */
+   if (unlikely(kk_async_pipelines_never_wait(dev))) {
+      if (async == NULL || p_atomic_read(&async->status) == KK_ASYNC_READY)
+         return KK_ASYNC_ACTION_RECORD;
+      if (p_atomic_read(&async->status) == KK_ASYNC_FAILED) {
+         /* Metal could not build the state. Unlike mode 1 there is no replay
+          * that could retry it, and the program is unusable for the rest of the
+          * device's life, so say so on this command buffer instead of rendering
+          * nothing silently. Nothing has been recorded for the draw yet. */
+         vk_command_buffer_set_error(&cmd->vk, VK_ERROR_INVALID_SHADER_NV);
+         return KK_ASYNC_ACTION_DROP;
+      }
+      /* Still compiling: drop the draw; no thread waits for Metal. A command
+       * buffer recorded or submitted after the state is published records it. */
+      if (KK_DEBUG(ASYNC) && !*not_ready) {
+         mesa_logi("kk: draw dropped: its pipeline's render pipeline state is "
+                   "still being built (MESA_KK_ASYNC_PIPELINES=2 never waits)");
+         *not_ready = true;
+      }
+      return KK_ASYNC_ACTION_DROP;
+   }
+
+   if (async == NULL || p_atomic_read(&async->status) != KK_ASYNC_PENDING)
+      return KK_ASYNC_ACTION_RECORD;
+
+   /* The command queue's replay must not drop the draw a second time, and it
+    * can wait: the compile was already paid for by the first recording of this
+    * command buffer. */
+   if (!cmd->replay) {
+      if (KK_DEBUG(ASYNC) && !*not_ready)
+         mesa_logi("kk: draw skipped: its pipeline's render pipeline state is "
+                   "still being built");
+      *not_ready = true;
+      return KK_ASYNC_ACTION_REPLAY;
+   }
+
+   /* The worker signals the fence after publishing the status (through
+    * p_atomic_set, a release store), so a status other than pending here means
+    * pipe->gfx.render is visible to this thread. The job also runs on the
+    * thread that drops it at device teardown, where the fence is signalled just
+    * the same. */
+   util_queue_fence_wait(&async->fence);
+
+   if (unlikely(p_atomic_read(&async->status) != KK_ASYNC_READY)) {
+      /* Metal could not build the state (it reports out of memory by returning
+       * nil) or the queue was gone before a worker could run the job. Nothing
+       * more can be done for this draw. */
+      vk_command_buffer_set_error(&cmd->vk, VK_ERROR_INVALID_SHADER_NV);
+      return KK_ASYNC_ACTION_DROP;
+   }
+   return KK_ASYNC_ACTION_RECORD;
+}
