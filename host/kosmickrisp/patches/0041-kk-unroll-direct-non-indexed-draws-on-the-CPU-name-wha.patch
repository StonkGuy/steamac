+struct kk_queue_in_flight {
+   const struct kk_device *failed_dev;
+   uint64_t failed_seq;
+   /* GPU start of the failed command buffer, its feedback (host seconds) */
+   double failed_start, failed_feedback;
+   int64_t now;
