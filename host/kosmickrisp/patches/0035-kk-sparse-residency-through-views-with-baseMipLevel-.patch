@@ -178,6 +178,17 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
          view_layout.array_len = subres_layout.layers;
       }
 
+      /* Metal reports the residency of a view with baseMipLevel > 0 for the
