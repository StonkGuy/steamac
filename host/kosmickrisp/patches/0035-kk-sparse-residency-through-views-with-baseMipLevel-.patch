diff --git a/src/kosmickrisp/vulkan/kk_image_view.h b/src/kosmickrisp/vulkan/kk_image_view.h
index 16ef404..7fecf94 100644
--- a/src/kosmickrisp/vulkan/kk_image_view.h
+++ b/src/kosmickrisp/vulkan/kk_image_view.h
@@ -44,6 +44,14 @@ struct kk_image_view {
       /* Used if view has to create its own alias of a specific subresource */
       mtl_texture *mtl_handle_subres;
 
+      /* Views with baseMipLevel > 0 of sparse residency images: the sampled
