+
+void MVKPipeline::recordShaderLibrary(spv::ExecutionModel stage, MVKShaderLibrary* library) {
+	for (uint32_t i = 0; i < kMVKShaderStageCount; i++) {
+		if (spvExecModelForStage(static_cast<MVKShaderStage>(i)) == stage) {
+			_diagnosticShaderLibraries[i] = library;
+			break;
+		}
+	}
+}
+
+void MVKPipeline::logFailedPipelineShaders() {
+	for (uint32_t i = 0; i < kMVKShaderStageCount; i++) {
+		if (_diagnosticShaderLibraries[i]) { _diagnosticShaderLibraries[i]->logPipelineFailureSource(i); }
+	}
 }
 
