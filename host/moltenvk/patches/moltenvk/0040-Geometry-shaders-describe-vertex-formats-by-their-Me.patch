From: steamac
Subject: [PATCH] Geometry shaders: describe vertex formats by their Metal vertex format

The object stage took component counts from a VkFormat-indexed table covering only plain
8/16/32-bit formats: packed and A8B8G8R8/sRGB formats had 0 components, B10G11R11,
E5B9G9R9 and A8_UNORM indexed past its end, and B8G8R8A8 was read as float4. Derive count,
normalization and memory layout from the MTLVertexFormat MoltenVK selects (packed layouts
are unpacked by SPIRV-Cross).
---
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm b/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
index b0daded..cc298a2 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
@@ -1855,88 +1855,63 @@ static MSLShaderVariableFormat mvkMSLMeshVertexMemoryFormat(MTLVertexFormat mtlF
 			return MSL_SHADER_VARIABLE_FORMAT_UINT32;
 		case MTLVertexFormatInt: case MTLVertexFormatInt2: case MTLVertexFormatInt3: case MTLVertexFormatInt4:
 			return MSL_SHADER_VARIABLE_FORMAT_INT32;
+		// Formats whose components are not separate memory elements: the object stage unpacks them.
+		case MTLVertexFormatUChar4Normalized_BGRA:
+			return MSL_SHADER_VARIABLE_FORMAT_UINT8_BGRA;
+		case MTLVertexFormatUInt1010102Normalized:
+			return MSL_SHADER_VARIABLE_FORMAT_UNORM1010102;
+		case MTLVertexFormatInt1010102Normalized:
+			return MSL_SHADER_VARIABLE_FORMAT_SNORM1010102;
+		case MTLVertexFormatFloatRG11B10:
+			return MSL_SHADER_VARIABLE_FORMAT_FLOAT_RG11B10;
+		case MTLVertexFormatFloatRGB9E5:
+			return MSL_SHADER_VARIABLE_FORMAT_FLOAT_RGB9E5;
 		default:
 			return MSL_SHADER_VARIABLE_FORMAT_OTHER;
 	}
 }
 
 struct MSLVertexFormatInfo {
-	uint8_t num_elements : 7;
-	bool normalized : 1;
+	uint32_t num_elements;
+	bool normalized;
 };
 
