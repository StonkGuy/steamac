+// Component count and normalization of a vertex format, for the geometry-shader (mesh) object stage.
+// Derived from the Metal vertex format MoltenVK selects for the Vulkan one, so every vertex format
+// the device accepts is described, and unsupported ones (MTLVertexFormatInvalid) have no components.
+static MSLVertexFormatInfo mvkMSLMeshVertexFormatInfo(MTLVertexFormat mtlFormat) {
+	switch (mtlFormat) {
+		case MTLVertexFormatUChar: case MTLVertexFormatChar: case MTLVertexFormatUShort: case MTLVertexFormatShort:
+		case MTLVertexFormatHalf: case MTLVertexFormatFloat: case MTLVertexFormatUInt: case MTLVertexFormatInt:
+			return {1, false};
+		case MTLVertexFormatUCharNormalized: case MTLVertexFormatCharNormalized:
+		case MTLVertexFormatUShortNormalized: case MTLVertexFormatShortNormalized:
+			return {1, true};
+		case MTLVertexFormatUChar2: case MTLVertexFormatChar2: case MTLVertexFormatUShort2: case MTLVertexFormatShort2:
+		case MTLVertexFormatHalf2: case MTLVertexFormatFloat2: case MTLVertexFormatUInt2: case MTLVertexFormatInt2:
+			return {2, false};
+		case MTLVertexFormatUChar2Normalized: case MTLVertexFormatChar2Normalized:
+		case MTLVertexFormatUShort2Normalized: case MTLVertexFormatShort2Normalized:
+			return {2, true};
+		case MTLVertexFormatUChar3: case MTLVertexFormatChar3: case MTLVertexFormatUShort3: case MTLVertexFormatShort3:
+		case MTLVertexFormatHalf3: case MTLVertexFormatFloat3: case MTLVertexFormatUInt3: case MTLVertexFormatInt3:
+		case MTLVertexFormatFloatRG11B10: case MTLVertexFormatFloatRGB9E5:
+			return {3, false};
+		case MTLVertexFormatUChar3Normalized: case MTLVertexFormatChar3Normalized:
+		case MTLVertexFormatUShort3Normalized: case MTLVertexFormatShort3Normalized:
+			return {3, true};
+		case MTLVertexFormatUChar4: case MTLVertexFormatChar4: case MTLVertexFormatUShort4: case MTLVertexFormatShort4:
+		case MTLVertexFormatHalf4: case MTLVertexFormatFloat4: case MTLVertexFormatUInt4: case MTLVertexFormatInt4:
+			return {4, false};
+		case MTLVertexFormatUChar4Normalized: case MTLVertexFormatChar4Normalized:
+		case MTLVertexFormatUShort4Normalized: case MTLVertexFormatShort4Normalized:
+		case MTLVertexFormatUChar4Normalized_BGRA:
+		case MTLVertexFormatUInt1010102Normalized: case MTLVertexFormatInt1010102Normalized:
+			return {4, true};
+		default:
+			return {0, false};
+	}
+}
 
