From: steamac
Subject: [PATCH] MSL: Packed vertex formats in the GS object stage

The geometry-shader (mesh) object stage fetches vertex attributes itself, but only knew
formats whose components are separate memory elements: A2B10G10R10 UNORM/SNORM failed
with "Invalid component count: 0" (American Truck Simulator's GL_INT_2_10_10_10_REV normals
through zink's provoking-vertex geometry shader). Unpack B8G8R8A8 UNORM, A2B10G10R10
UNORM/SNORM, B10G11R11 UFLOAT and E5B9G9R9 UFLOAT words with extract_bits.
---
diff --git a/spirv_msl.cpp b/spirv_msl.cpp
index 4582db2..c3e91b8 100644
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -2429,13 +2429,73 @@ void CompilerMSL::emit_mesh_wrapper()
 			std::string parent_type_str = type_to_glsl(get<SPIRType>(type.parent_type), var.self);
 			uint32_t load_elements = std::min<uint32_t>(variable.vecsize, parent_type.vecsize);
 
+			std::string address = "(vb" + std::to_string(variable.binding) + " + " + std::to_string(variable.offset) + " + spvFetchIndex(drawInfo, " + std::to_string(variable.binding) + ", vertexIndex, positionInGrid.y) * drawInfo->vertexStrides[" + std::to_string(variable.binding) + "])";
+
+			// Packed formats: one memory element holds all components; unpack them to float (Vulkan's
+			// UNORM c / (2^n - 1), SNORM max(c / (2^(n-1) - 1), -1), unsigned 11/10-bit floats, shared
+			// exponent), keep the components the shader has, then fill the rest with (0, 0, 0, 1).
+			uint32_t packed_elements = 0;
+			std::string unpacked;
+			std::string word = "spvPacked" + std::to_string(id);
+			switch (variable.format)
+			{
+			case MSL_SHADER_VARIABLE_FORMAT_UINT8_BGRA:
+				packed_elements = 4;
+				unpacked = "float4((*(device packed_uchar4 *)" + address + ").zyxw) * (1.f/255.f)";
+				break;
+			case MSL_SHADER_VARIABLE_FORMAT_UNORM1010102:
+				packed_elements = 4;
+				unpacked = "float4(extract_bits(" + word + ", 0, 10), extract_bits(" + word + ", 10, 10), extract_bits(" +
+				           word + ", 20, 10), extract_bits(" + word + ", 30, 2)) * float4(1.f/1023.f, 1.f/1023.f, 1.f/1023.f, 1.f/3.f)";
+				break;
+			case MSL_SHADER_VARIABLE_FORMAT_SNORM1010102:
+				packed_elements = 4;
+				unpacked = "max(float4(extract_bits(int(" + word + "), 0, 10), extract_bits(int(" + word + "), 10, 10), extract_bits(int(" +
+				           word + "), 20, 10), extract_bits(int(" + word + "), 30, 2)) * float4(1.f/511.f, 1.f/511.f, 1.f/511.f, 1.f), -1.f)";
+				break;
+			case MSL_SHADER_VARIABLE_FORMAT_FLOAT_RG11B10:
+				// 5-bit exponent and 6 or 5 mantissa bits, no sign: the bits of a half shifted down.
+				packed_elements = 3;
+				unpacked = "float3(float(as_type<half>(ushort(extract_bits(" + word + ", 0, 11) << 4))), float(as_type<half>(ushort(extract_bits(" +
+				           word + ", 11, 11) << 4))), float(as_type<half>(ushort(extract_bits(" + word + ", 22, 10) << 5))))";
+				break;
+			case MSL_SHADER_VARIABLE_FORMAT_FLOAT_RGB9E5:
+				packed_elements = 3;
+				unpacked = "float3(extract_bits(" + word + ", 0, 9), extract_bits(" + word + ", 9, 9), extract_bits(" + word +
+				           ", 18, 9)) * exp2(float(int(extract_bits(" + word + ", 27, 5)) - 24))";
+				break;
+			default:
+				break;
+			}
+			if (packed_elements)
+			{
+				if (variable.format != MSL_SHADER_VARIABLE_FORMAT_UINT8_BGRA)
+					statement("uint ", word, " = *(device uint *)", address, ";");
+				uint32_t elements = std::min<uint32_t>(packed_elements, parent_type.vecsize);
+				static const char *const swizzles[] = { "", ".x", ".xy", ".xyz" };
+				std::string value = elements < packed_elements ? "(" + unpacked + ")" + swizzles[elements] : unpacked;
+				auto loaded_type = parent_type;
+				loaded_type.vecsize = elements;
+				loaded_type.columns = 1;
+				value = type_to_glsl(loaded_type) + "(" + value + ")";
+				if (elements != parent_type.vecsize)
+				{
+					value = parent_type_str + "(" + value;
+					for (uint32_t i = elements; i < parent_type.vecsize; i++)
+						value += (i == 3) ? ", 1" : ", 0";
+					value += ")";
+				}
+				statement(to_name(var.self), " = ", value, ";");
+				return;
+			}
+
 			// Load the format's components from memory, convert them to the shader's component type
 			// (integers to float for SCALED formats), normalize NORM formats, then fill the components
 			// the format does not have with (0, 0, 0, 1).
 			std::string type_name = get_variable_format_string(variable.format);
 			std::string component = type_name + get_vertex_loader_component_suffix(load_elements);
 			std::string packed = load_elements > 1 ? "packed_" : "";
-			std::string load_string = "*(device " + packed + component + " *)(vb" + std::to_string(variable.binding) + " + " + std::to_string(variable.offset) + " + spvFetchIndex(drawInfo, " + std::to_string(variable.binding) + ", vertexIndex, positionInGrid.y) * drawInfo->vertexStrides[" + std::to_string(variable.binding) + "])";
+			std::string load_string = "*(device " + packed + component + " *)" + address;
 			auto loaded_type = parent_type;
 			loaded_type.vecsize = load_elements;
 			loaded_type.columns = 1;
diff --git a/spirv_msl.hpp b/spirv_msl.hpp
index ba18f8e..02a094b 100644
--- a/spirv_msl.hpp
+++ b/spirv_msl.hpp
@@ -52,6 +52,14 @@ enum MSLShaderVariableFormat
 	MSL_SHADER_VARIABLE_FORMAT_ANY16 = 9,
 	MSL_SHADER_VARIABLE_FORMAT_ANY32 = 10,
 
+	// Packed vertex formats, unpacked by the geometry-shader object stage (for_mesh_pipeline):
+	// B8G8R8A8 UNORM, A2B10G10R10 UNORM/SNORM, B10G11R11 UFLOAT, E5B9G9R9 UFLOAT.
+	MSL_SHADER_VARIABLE_FORMAT_UINT8_BGRA = 11,
+	MSL_SHADER_VARIABLE_FORMAT_UNORM1010102 = 12,
+	MSL_SHADER_VARIABLE_FORMAT_SNORM1010102 = 13,
+	MSL_SHADER_VARIABLE_FORMAT_FLOAT_RG11B10 = 14,
+	MSL_SHADER_VARIABLE_FORMAT_FLOAT_RGB9E5 = 15,
+
 	// Deprecated aliases.
 	MSL_VERTEX_FORMAT_OTHER = MSL_SHADER_VARIABLE_FORMAT_OTHER,
 	MSL_VERTEX_FORMAT_UINT8 = MSL_SHADER_VARIABLE_FORMAT_UINT8,
