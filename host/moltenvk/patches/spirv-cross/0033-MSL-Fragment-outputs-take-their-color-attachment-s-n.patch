+// The base type a fragment output needs at location for the numeric type of its color attachment (see
+// Options::frag_output_float_mask): the type's own, unless the attachment's numeric type is known and differs.
+// The width stays, except that 8-bit integers become half.
+SPIRType::BaseType CompilerMSL::get_fragment_output_base_type(StorageClass storage, uint32_t location,
+                                                              const SPIRType &type) const
+{
+	if (storage != StorageClassOutput || get_execution_model() != ExecutionModelFragment || location >= 32)
+		return type.basetype;
+
+	uint32_t bit = 1u << location;
+	bool is_float = type.basetype == SPIRType::Half || type.basetype == SPIRType::Float;
+	bool is_sint = type.basetype == SPIRType::SByte || type.basetype == SPIRType::Short || type.basetype == SPIRType::Int;
+	bool is_uint = type.basetype == SPIRType::UByte || type.basetype == SPIRType::UShort || type.basetype == SPIRType::UInt;
+	if (!is_float && !is_sint && !is_uint)
+		return type.basetype;
+
+	if ((msl_options.frag_output_float_mask & bit) && !is_float)
+		return type.width == 32 ? SPIRType::Float : SPIRType::Half;
+	if ((msl_options.frag_output_sint_mask & bit) && !is_sint)
+		return type.width == 8 ? SPIRType::SByte : type.width == 16 ? SPIRType::Short : SPIRType::Int;
+	if ((msl_options.frag_output_uint_mask & bit) && !is_uint)
+		return type.width == 8 ? SPIRType::UByte : type.width == 16 ? SPIRType::UShort : SPIRType::UInt;
+	return type.basetype;
+}
+
+static uint32_t base_type_width(SPIRType::BaseType basetype)
+{
+	switch (basetype)
+	{
+	case SPIRType::SByte:
+	case SPIRType::UByte:
+		return 8;
+	case SPIRType::Short:
+	case SPIRType::UShort:
+	case SPIRType::Half:
+		return 16;
+	default:
+		return 32;
+	}
+}
+
+// A scalar or vector type of components components and base type basetype, for a fragment output member.
+uint32_t CompilerMSL::build_fragment_output_type(uint32_t type_id, uint32_t components, SPIRType::BaseType basetype)
+{
+	assert(is_scalar(get<SPIRType>(type_id)) || is_vector(get<SPIRType>(type_id)));
+	uint32_t new_type_id;
+	if (components > 1)
+		new_type_id = build_extended_vector_type(type_id, components, basetype);
+	else
+	{
+		new_type_id = ir.increase_bound_by(1);
+		auto &type = set<SPIRType>(new_type_id, get<SPIRType>(type_id));
+		type.basetype = basetype;
+		type.self = new_type_id;
+	}
+	get<SPIRType>(new_type_id).width = base_type_width(basetype);
+	return new_type_id;
+}
+
+// expr, a value of the scalar or vector type type, converted to basetype: bit cast where the widths match.
+std::string CompilerMSL::to_fragment_output_value(const SPIRType &type, SPIRType::BaseType basetype,
+                                                  const std::string &expr)
+{
+	if (type.basetype == basetype)
+		return expr;
+	SPIRType out_type = type;
+	out_type.basetype = basetype;
+	out_type.width = base_type_width(basetype);
+	out_type.array.clear();
+	out_type.array_size_literal.clear();
+	if (out_type.width == type.width)
+		return bitcast_expression(out_type, type.basetype, expr);
+	return join(type_to_glsl(out_type), "(", expr, ")");
+}
