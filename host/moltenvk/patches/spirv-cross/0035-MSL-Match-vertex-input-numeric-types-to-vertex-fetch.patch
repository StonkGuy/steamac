@@ -4850,7 +4865,9 @@
 					}
 					if (orig_vecsize != UINT32_MAX)
 						swizzle = vector_swizzle(orig_vecsize, 0);
-					statement(var_chain, " = ", ib_var_ref, ".", mbr_name, lerp_call, swizzle, ";");
+					auto physical_basetype = this->get<SPIRType>(mbr_type_id).basetype;
+					statement(var_chain, " = ", to_vertex_input_value(*usable_type, physical_basetype,
+					          join(ib_var_ref, ".", mbr_name, lerp_call, swizzle)), ";");
 				});
 				break;
 
@@ -4978,6 +4995,7 @@
 	else if (!meta.strip_array && meta.allow_local_declaration)
 	{
 		// Unflatten or flatten from [[stage_in]] or [[stage_out]] as appropriate.
+		uint32_t logical_type_id = var_type.member_types[mbr_idx];
 		switch (storage)
 		{
 		case StorageClassInput:
@@ -4986,7 +5004,9 @@
 				// Insert swizzle for widened interface block vector from interface matching
 				if (orig_vecsize != UINT32_MAX)
 					swizzle = vector_swizzle(orig_vecsize, 0);
-				statement(var_chain, " = ", qual_var_name, swizzle, ";");
+				auto physical_basetype = this->get<SPIRType>(mbr_type_id).basetype;
+				statement(var_chain, " = ", to_vertex_input_value(this->get<SPIRType>(logical_type_id),
+				          physical_basetype, join(qual_var_name, swizzle)), ";");
 			});
 			break;
 
@@ -6357,8 +6377,8 @@
 
 	uint32_t max_array_dimensions = strip_array ? 1 : 0;
 
-	// Struct and array types must match exactly.
-	if (type.basetype == SPIRType::Struct || type.array.size() > max_array_dimensions)
+	// Composite inputs are fixed up at their flattened scalar/vector members.
+	if (type.basetype == SPIRType::Struct || type.array.size() > max_array_dimensions || type.columns > 1)
 		return type_id;
 
 	auto p_va = inputs_by_location.find({location, component});
@@ -6377,6 +6397,37 @@
 
 	if (num_components == 0)
 		num_components = p_va->second.vecsize;
+
+	// Metal requires the stage_in numeric category to agree with vertex fetch. Keep the shader's
+	// width and vector size (Metal supplies absent components), and reinterpret on load. Do not
+	// change inter-stage interfaces or the manually fetched object-stage inputs.
+	if (msl_options.vertex_attribute_type_compatibility && get_execution_model() == ExecutionModelVertex &&
+	    !msl_options.vertex_for_tessellation && (type.width == 16 || type.width == 32))
+	{
+		auto basetype = type.basetype;
+		switch (p_va->second.format)
+		{
+		case MSL_SHADER_VARIABLE_FORMAT_UINT8:
+		case MSL_SHADER_VARIABLE_FORMAT_UINT16:
+		case MSL_SHADER_VARIABLE_FORMAT_UINT32:
+			basetype = to_unsigned_basetype(type.width);
+			break;
+		case MSL_SHADER_VARIABLE_FORMAT_INT8:
+		case MSL_SHADER_VARIABLE_FORMAT_INT16:
+		case MSL_SHADER_VARIABLE_FORMAT_INT32:
+			basetype = to_signed_basetype(type.width);
+			break;
+		case MSL_SHADER_VARIABLE_FORMAT_HALF:
+		case MSL_SHADER_VARIABLE_FORMAT_FLOAT:
+			basetype = type.width == 16 ? SPIRType::Half : SPIRType::Float;
+			break;
+		default:
+			break;
+		}
+		if (basetype != type.basetype || num_components > type.vecsize)
+			return build_extended_vector_type(type_id, max(num_components, type.vecsize), basetype);
+		return type_id;
+	}
 
 	switch (p_va->second.format)
 	{
@@ -22031,13 +22090,18 @@
 	// Only interested in standalone builtin variables in the switch below.
 	if (!has_decoration(source_id, DecorationBuiltIn))
 	{
-		// If the backing variable does not match our expected sign, we can fix it up here.
-		// See ensure_correct_input_type().
+		// The stage_in member may use another numeric type to match vertex fetch.
+		// See ensure_correct_input_type(). Preserve the fetched bits, not a numeric conversion.
 		if (var && var->storage == StorageClassInput)
 		{
 			auto &base_type = get<SPIRType>(var->basetype);
 			if (base_type.basetype != SPIRType::Struct && expr_type.basetype != base_type.basetype)
-				expr = join(type_to_glsl(expr_type), "(", expr, ")");
+			{
+				if (base_type.width == expr_type.width)
+					expr = bitcast_expression(expr_type, base_type.basetype, expr);
+				else
+					expr = join(type_to_glsl(expr_type), "(", expr, ")");
+			}
 		}
 		return;
 	}
