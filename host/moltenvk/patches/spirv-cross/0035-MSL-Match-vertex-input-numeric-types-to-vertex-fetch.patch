From: steamac <steamac@localhost>
Subject: [PATCH] MSL: Match vertex input numeric types to vertex fetch

STEAMAC-3N: BLUE REFLECTION's BLENDINDICES1 int4 is backed by Float3 or
Float4 vertex formats. Metal rejects those render pipelines, dropping the
character bodies. Vulkan leaves mismatched numeric inputs undefined.

Add an opt-in vertex_attribute_type_compatibility policy. Match stage_in
members to the vertex format's numeric category, preserve the shader's
width and component count, and bitcast fetched values back to the shader's
logical type. Metal supplies missing components before reinterpretation.
Handle scalar inputs as well as vectors and flattened arrays, matrices and
blocks. Keep inter-stage, tessellation and mesh object-stage inputs alone;
the latter already fetch their own attributes.

---
diff --git a/spirv_msl.cpp b/spirv_msl.cpp
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -3954,7 +3954,7 @@
 
 uint32_t CompilerMSL::build_extended_vector_type(uint32_t type_id, uint32_t components, SPIRType::BaseType basetype)
 {
-	assert(components > 1);
+	assert(components >= 1);
 	uint32_t new_type_id = ir.increase_bound_by(1);
 	const auto *p_old_type = &get<SPIRType>(type_id);
 	const SPIRType *old_ptr_t = nullptr;
@@ -3974,14 +3974,16 @@
 
 	auto *type = &set<SPIRType>(new_type_id, *p_old_type);
 	assert(is_scalar(*type) || is_vector(*type));
-	type->op = OpTypeVector;
+	type->op = components > 1 ? OpTypeVector :
+	           (basetype == SPIRType::Float || basetype == SPIRType::Half ? OpTypeFloat : OpTypeInt);
 	type->vecsize = components;
 	if (basetype != SPIRType::Unknown)
 		type->basetype = basetype;
 	type->self = new_type_id;
 	// We want parent type to point to the scalar type.
-	type->parent_type = is_scalar(*p_old_type) ? TypeID(p_old_type->self) : p_old_type->parent_type;
-	assert(is_scalar(get<SPIRType>(type->parent_type)));
+	type->parent_type = components > 1 ?
+	                   (is_scalar(*p_old_type) ? TypeID(p_old_type->self) : p_old_type->parent_type) : TypeID(0);
+	assert(components == 1 || is_scalar(get<SPIRType>(type->parent_type)));
 	type->array.clear();
 	type->array_size_literal.clear();
 	type->pointer = false;
@@ -4085,6 +4087,17 @@
 	if (out_type.width == type.width)
 		return bitcast_expression(out_type, type.basetype, expr);
 	return join(type_to_glsl(out_type), "(", expr, ")");
+}
+
+// Undo the stage_in numeric-category fixup after fetch, including flattened input arrays and blocks.
+std::string CompilerMSL::to_vertex_input_value(const SPIRType &type, SPIRType::BaseType physical_basetype,
+                                              const std::string &expr)
+{
+	if (msl_options.vertex_attribute_type_compatibility && get_execution_model() == ExecutionModelVertex &&
+	    !msl_options.vertex_for_tessellation && !msl_options.for_mesh_pipeline &&
+	    type.basetype != physical_basetype)
+		return bitcast_expression(type, physical_basetype, expr);
+	return expr;
 }
 
 uint32_t CompilerMSL::build_msl_interpolant_type(uint32_t type_id, bool is_noperspective)
@@ -4571,6 +4584,7 @@
 		// Only flatten/unflatten IO composites for non-tessellation cases where arrays are not stripped.
 		if (!meta.strip_array)
 		{
+			auto input_basetype = get<SPIRType>(ib_type.member_types[ib_mbr_idx]).basetype;
 			switch (storage)
 			{
 			case StorageClassInput:
@@ -4588,7 +4602,8 @@
 					}
 					else
 					{
-						statement(to_name(var.self), "[", i, "] = ", ib_var_ref, ".", mbr_name, ";");
+						statement(to_name(var.self), "[", i, "] = ",
+						          to_vertex_input_value(*usable_type, input_basetype, join(ib_var_ref, ".", mbr_name)), ";");
 					}
