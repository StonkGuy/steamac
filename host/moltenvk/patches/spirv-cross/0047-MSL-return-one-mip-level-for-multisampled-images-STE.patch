From 352750fe9bfb0cebbaeb79c0acc99f9d33f3dc3a Mon Sep 17 00:00:00 2001
From: georgii pl <gp@fx.gl>
Date: Sun, 1 Nov 2026 11:17:18 +0300
Subject: [PATCH] MSL: return one mip level for multisampled images
 (STEAMAC-5K)

OpImageQueryLevels is legal for multisampled sampled images, which have one mip level. Metal texture2d_ms and texture2d_ms_array expose no get_num_mip_levels method. Emit the typed constant one while retaining the null descriptor guard so null images still report zero. Keep sample-count queries and ordinary mip-level queries unchanged.

Original steamac change on top of 939b40b3 plus steamac 0001-0037; not an upstream cherry-pick. Validated reconstructed SPIR-V with spirv-val, reproduced the exact Metal missing-member diagnostic before, and compiled both guarded and unguarded generated MSL after with the private SPIRV-Cross build.
---
 spirv_msl.cpp | 42 +++++++++++++++++++++---------------------
 1 file changed, 21 insertions(+), 21 deletions(-)

diff --git a/spirv_msl.cpp b/spirv_msl.cpp
index 31b8f32..54d0b5f 100644
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -11993,30 +11993,30 @@ void CompilerMSL::emit_instruction(const Instruction &instruction)
 		break;
 	}
 
-#define MSL_ImgQry(qrytype)                                                                 \
-	do                                                                                      \
-	{                                                                                       \
-		uint32_t rslt_type_id = ops[0];                                                     \
-		auto &rslt_type = get<SPIRType>(rslt_type_id);                                      \
-		uint32_t id = ops[1];                                                               \
-		uint32_t img_id = ops[2];                                                           \
-		string img_exp = to_expression(img_id);                                             \
-		string expr = type_to_glsl(rslt_type) + "(" + img_exp + ".get_num_" #qrytype "())"; \
-		if (msl_options.robust_image_access2 || msl_options.null_descriptor)                \
-		{                                                                                   \
-			string zero_expr = type_to_glsl(rslt_type) + "(0)";                             \
-			expr = join("(is_null_texture(", img_exp, ") ? ", zero_expr, " : ", expr, ")"); \
-		}                                                                                   \
-		emit_op(rslt_type_id, id, expr, should_forward(img_id));                            \
-	} while (false)
-
 	case OpImageQueryLevels:
-		MSL_ImgQry(mip_levels);
-		break;
-
 	case OpImageQuerySamples:
-		MSL_ImgQry(samples);
+	{
+		uint32_t rslt_type_id = ops[0];
+		auto &rslt_type = get<SPIRType>(rslt_type_id);
+		uint32_t id = ops[1];
+		uint32_t img_id = ops[2];
+		string img_exp = to_expression(img_id);
+		string expr;
+		// Multisampled images have only one mip level, and Metal's multisampled
+		// texture types do not expose get_num_mip_levels().
+		if (opcode == OpImageQueryLevels && expression_type(img_id).image.ms)
+			expr = type_to_glsl(rslt_type) + "(1)";
+		else
+			expr = join(type_to_glsl(rslt_type), "(", img_exp,
+			            opcode == OpImageQueryLevels ? ".get_num_mip_levels())" : ".get_num_samples())");
+		if (msl_options.robust_image_access2 || msl_options.null_descriptor)
+		{
+			string zero_expr = type_to_glsl(rslt_type) + "(0)";
+			expr = join("(is_null_texture(", img_exp, ") ? ", zero_expr, " : ", expr, ")");
+		}
+		emit_op(rslt_type_id, id, expr, should_forward(img_id));
 		break;
+	}
 
 	case OpImage:
 	{
