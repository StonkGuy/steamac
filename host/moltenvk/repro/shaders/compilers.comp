#version 450
// compilers.c: every specialization of K is a distinct Metal compile
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint K = 1u;
layout(set = 0, binding = 0) buffer B { uint v[]; };

void main()
{
	uint i = gl_GlobalInvocationID.x;
	uint x = v[i];
	for (uint j = 0u; j < (x & 7u); j++)
		x = x * 1664525u + K;
	v[i] = x;
}
