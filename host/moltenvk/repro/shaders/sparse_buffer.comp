#version 460
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Input { uint words[]; } src;
layout(std430, set = 0, binding = 1) writeonly buffer Output { uint words[]; } dst;
layout(push_constant) uniform Params { uint count; } p;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < p.count) dst.words[i] = src.words[i];
}
