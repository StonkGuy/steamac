#version 460
// Texel buffer views of a sparse buffer (vkd3d-proton's typed UAV/SRV of a reserved buffer, ClearUnorderedAccessViewUint).
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, r32ui) uniform uimageBuffer view;
layout(std430, set = 0, binding = 1) writeonly buffer Output { uint words[]; } dst;
layout(set = 0, binding = 2) uniform usamplerBuffer ro;
// mode 0: imageLoad, 1: texelFetch, other: imageStore(mode + i)
layout(push_constant) uniform Params { uint count; uint mode; } p;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) return;
    if (p.mode == 0) dst.words[i] = imageLoad(view, int(i)).x;
    else if (p.mode == 1) dst.words[i] = texelFetch(ro, int(i)).x;
    else imageStore(view, int(i), uvec4(p.mode + i));
}
