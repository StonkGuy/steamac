; Single-element standalone array reproduces the compiler's suggested scalar member.
OpCapability Shader
OpCapability CullDistance
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %main "main" %position %cull
OpName %cull "gl_CullDistance"
OpDecorate %position BuiltIn Position
OpDecorate %cull BuiltIn CullDistance
%void = OpTypeVoid
%fn = OpTypeFunction %void
%float = OpTypeFloat 32
%uint = OpTypeInt 32 0
%v4float = OpTypeVector %float 4
%zero = OpConstant %uint 0
%one = OpConstant %uint 1
%fzero = OpConstant %float 0
%fone = OpConstant %float 1
%pos = OpConstantComposite %v4float %fzero %fzero %fzero %fone
%array = OpTypeArray %float %one
%ptr_position = OpTypePointer Output %v4float
%ptr_array = OpTypePointer Output %array
%ptr_float = OpTypePointer Output %float
%position = OpVariable %ptr_position Output
%cull = OpVariable %ptr_array Output
%main = OpFunction %void None %fn
%entry = OpLabel
OpStore %position %pos
%c0 = OpAccessChain %ptr_float %cull %zero
OpStore %c0 %fone
OpReturn
OpFunctionEnd
