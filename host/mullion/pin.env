# Mullion source behind the Mullion flavour of libwmtr_host.dylib and its guest dlls, pinned. Mullion
# (https://github.com/dttdrv/mullion) is a DXMT fork with Direct3D 12; LGPL-2.1-or-later like DXMT.
# MULLION_COMMIT is the upstream base (release v0.4); host/mullion/patches/ (generated by
# scripts/export-mullion-patches.sh from the branch MULLION_FORK_BRANCH at MULLION_FORK_COMMIT, never edited by hand)
# apply on it in order.
MULLION_REPO=https://github.com/dttdrv/mullion
MULLION_COMMIT=7bcdcb4437f745ba9d5b6b876c9521008388296c
MULLION_URL=https://github.com/dttdrv/mullion/archive/7bcdcb4437f745ba9d5b6b876c9521008388296c.tar.gz
MULLION_SHA256=0dd7e76fbbd5f941b6fa16491f552ff0a07e36b1b2c0663353824c81eac4ee7e
# the patch branch is not published yet: scripts/export-mullion-patches.sh reads a local clone (MULLION_FORK_CHECKOUT)
MULLION_FORK_REPO=
MULLION_FORK_BRANCH=steamac-heap-memory
MULLION_FORK_COMMIT=591e0d1e6a4b81704c780e5457b11aa74b4218c3
# Its submodules at the commits MULLION_COMMIT records
DXHEADERS_COMMIT=9df86f2341616ef1888ae59919feaa6d4fad693d
DXHEADERS_URL=https://github.com/misyltoad/mingw-directx-headers/archive/9df86f2341616ef1888ae59919feaa6d4fad693d.tar.gz
DXHEADERS_SHA256=9c1b8bbfd2d6c758fac4d93c2808a46bc1eee429fe656b4f21b29e02615aa8aa
NVAPI_COMMIT=d08488fcc82eef313b0464db37d2955709691e94
NVAPI_URL=https://github.com/NVIDIA/nvapi/archive/d08488fcc82eef313b0464db37d2955709691e94.tar.gz
NVAPI_SHA256=436936c965f711f743c8606cb7c2621736cecf41e0fd6557555b2f1903b0350f
# The statically linked LLVM (airconv's shader compiler): Mullion's CI pins the same release as DXMT's, so the
# install is shared (host/dxmt/build.sh llvm -> work/out/host/llvm15); host/mullion/build.sh checks they agree.
LLVM_VERSION=15.0.7
