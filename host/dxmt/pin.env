# DXMT source behind libwmtr_host.dylib and the guest's DXMT dlls (the DXMT graphics path), pinned.
# DXMT_COMMIT is the upstream base; host/dxmt/patches/ (generated by scripts/export-dxmt-patches.sh from the
# StonkGuy/dxmt branch "steamac" at DXMT_FORK_COMMIT, never edited by hand) apply on it in order. DXMT is
# LGPL-2.1-or-later; scripts/gpl-sources.sh ships this tarball, the patches and wmtr/ (which builds
# winemetal_unix.c and airconv from this source into the library) with each release.
DXMT_REPO=https://github.com/3Shain/dxmt
DXMT_COMMIT=e94c312f5c054263acf261cfa109edf13e757587
DXMT_URL=https://github.com/3Shain/dxmt/archive/e94c312f5c054263acf261cfa109edf13e757587.tar.gz
DXMT_SHA256=fcdc10e14f1a7b42c8136c819807cbc42157f2d78eccdb34c82131cb3a929bf3
DXMT_FORK_REPO=https://github.com/StonkGuy/dxmt
DXMT_FORK_BRANCH=steamac
DXMT_FORK_COMMIT=17896accb64afa6b06bf1bdbc6183f6d00a35667
# The statically linked LLVM (airconv's shader compiler); licence text in LICENSES/.
LLVM_VERSION=15.0.7
