From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: StonkGuy <68372320+StonkGuy@users.noreply.github.com>
Date: Sat, 10 Oct 2026 04:23:05 +0300
Subject: [PATCH 01/27] build: prebuilt_metal_dir and build_unixlib options

prebuilt_metal_dir takes dxmt_command.metallib and air_{msad,samplepos,
tessellation}.air built from the same revision, so the tree builds where
the Xcode Metal toolchain is not installed. build_unixlib=false builds only
the Windows PE dlls (for a Linux-hosted cross build).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 meson.build               | 20 +++++++++++---------
 meson.options             |  4 +++-
 src/airconv/meson.build   | 18 +++++++++++++-----
 src/dxmt/meson.build      |  9 ++++++---
 src/winemetal/meson.build |  2 +-
 5 files changed, 34 insertions(+), 19 deletions(-)

diff --git a/meson.build b/meson.build
index e10c90191f15e4871c7b703f1f9376241f8255a0..7cf523efcea8196ba240834f6d5acd49424b407b 100644
--- a/meson.build
+++ b/meson.build
@@ -112,17 +112,19 @@ else
   wrc_generator = generator(wrc, output : [ '@BASENAME@_ignored.h' ], arguments : [ '@OUTPUT@' ] )
 endif
 
-xcrun = find_program('xcrun')
+xcrun = find_program('xcrun', required : get_option('prebuilt_metal_dir') == '')
 
-metalir_generator = generator(xcrun,
-  output    : [ '@BASENAME@.air'],
-  arguments : [ '-sdk', 'macosx', 'metal', '-o', '@OUTPUT@', '-c', '@INPUT@', '@EXTRA_ARGS@'],
-)
+if xcrun.found()
+  metalir_generator = generator(xcrun,
+    output    : [ '@BASENAME@.air'],
+    arguments : [ '-sdk', 'macosx', 'metal', '-o', '@OUTPUT@', '-c', '@INPUT@', '@EXTRA_ARGS@'],
+  )
 
-metallib_generator = generator(xcrun,
-  output    : [ '@BASENAME@.metallib'],
-  arguments : [ '-sdk', 'macosx', 'metallib', '-o', '@OUTPUT@', '@INPUT@'],
-)
+  metallib_generator = generator(xcrun,
+    output    : [ '@BASENAME@.metallib'],
+    arguments : [ '-sdk', 'macosx', 'metallib', '-o', '@OUTPUT@', '@INPUT@'],
+  )
+endif
 
 xxd = find_program('xxd')
 
diff --git a/meson.options b/meson.options
index 715b17658d4a6c917bd6ec933042b42a0671fea8..edcf082f520ac7ff4e500e289a13cb55f62a27e2 100644
--- a/meson.options
+++ b/meson.options
@@ -8,4 +8,6 @@ option('wine_builtin_dll', type : 'boolean', value : true)
 option('enable_tests', type : 'boolean', value : false)
 option('enable_nvapi', type : 'boolean', value : false)
 option('enable_nvngx', type : 'boolean', value : false)
-option('enable_d3d12', type : 'boolean', value : false)
\ No newline at end of file
+option('enable_d3d12', type : 'boolean', value : false)
+option('prebuilt_metal_dir', type : 'string', value : '', description : 'Directory with dxmt_command.metallib and air_{msad,samplepos,tessellation}.air built by the same DXMT revision; used instead of xcrun metal when the Metal toolchain is not installed')
+option('build_unixlib', type : 'boolean', value : true, description : 'Build the macOS unixlib (winemetal.so) and the native airconv library; false builds only the Windows PE dlls')
diff --git a/src/airconv/meson.build b/src/airconv/meson.build
index 8e0c8bedbe5fe672c45ddd83a40868da1b9af11e..cbb9013ba7c08286c635466572d0a4c0a5d74349 100644
--- a/src/airconv/meson.build
+++ b/src/airconv/meson.build
@@ -68,10 +68,18 @@ airconv_shaders = [
   'shaders/air_tessellation.metal',
 ]
 
-airconv_shaders_ir = metalir_generator.process(
-  airconv_shaders,
-  extra_args: ['-std=metal3.1', '--target=air64-apple-macos14.0'],
-)
+if get_option('prebuilt_metal_dir') != ''
+  airconv_shaders_ir = files(
+    join_paths(get_option('prebuilt_metal_dir'), 'air_msad.air'),
+    join_paths(get_option('prebuilt_metal_dir'), 'air_samplepos.air'),
+    join_paths(get_option('prebuilt_metal_dir'), 'air_tessellation.air'),
+  )
+else
+  airconv_shaders_ir = metalir_generator.process(
+    airconv_shaders,
+    extra_args: ['-std=metal3.1', '--target=air64-apple-macos14.0'],
+  )
+endif
 airconv_shaders_header = hexdump_generator.process(airconv_shaders_ir)
 
 airconv_src += airconv_shaders_header
@@ -106,6 +114,6 @@ executable('airconv', airconv_src + airconv_cli_src,
 
 endif
 
-if cpu_family == 'x86_64' or cpu_family == 'aarch64' or not dxmt_crossbuild
+if (cpu_family == 'x86_64' or cpu_family == 'aarch64' or not dxmt_crossbuild) and get_option('build_unixlib')
   subdir('darwin')
 endif
\ No newline at end of file
diff --git a/src/dxmt/meson.build b/src/dxmt/meson.build
index 9d5bfe2b723a8ee4129a43a3ef42c7b2eace1f39..af9628f02a01420da8cde5fe787c190f893648bc 100644
--- a/src/dxmt/meson.build
+++ b/src/dxmt/meson.build
@@ -29,9 +29,12 @@ dxmt_shaders = [
   'dxmt_command.metal'
 ]
 
-dxmt_shaders_ir = metalir_generator.process(dxmt_shaders)
-
-dxmt_shaders_lib = metallib_generator.process(dxmt_shaders_ir)
+if get_option('prebuilt_metal_dir') != ''
+  dxmt_shaders_lib = files(join_paths(get_option('prebuilt_metal_dir'), 'dxmt_command.metallib'))
+else
+  dxmt_shaders_ir = metalir_generator.process(dxmt_shaders)
+  dxmt_shaders_lib = metallib_generator.process(dxmt_shaders_ir)
+endif
 
 dxmt_shaders_header = hexdump_generator.process(dxmt_shaders_lib)
 
diff --git a/src/winemetal/meson.build b/src/winemetal/meson.build
index b3fa530d169e3080a20c6f689703813f5912be8f..7b27e297d56289fea33340d5960b33c2183c71a5 100644
--- a/src/winemetal/meson.build
+++ b/src/winemetal/meson.build
@@ -57,6 +57,6 @@ custom_target('postprocess_lib',
   build_by_default : true
 )
 
-if cpu_family == 'x86_64' or cpu_family == 'aarch64'
+if (cpu_family == 'x86_64' or cpu_family == 'aarch64') and get_option('build_unixlib')
   subdir('unix')
 endif
