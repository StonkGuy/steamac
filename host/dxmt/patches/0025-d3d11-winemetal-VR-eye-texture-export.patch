 }
+
+WINEMETAL_API uint32_t
+WMTVRSubmit(const struct WMTVRSubmitInfo *info) {
+  struct unixcall_wmtvr_submit params;
+  params.info = *info;
+  return WINE_UNIX_CALL(146, &params);
+}
