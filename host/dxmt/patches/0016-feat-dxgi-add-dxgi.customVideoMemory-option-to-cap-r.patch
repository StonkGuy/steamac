From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NerRobDog <nik@MBPSH.local>
Date: Mon, 31 Aug 2026 19:47:29 +0200
Subject: [PATCH 16/27] feat(dxgi): add dxgi.customVideoMemory option to cap
 reported VRAM

By default QueryVideoMemoryInfo reports recommendedMaxWorkingSetSize
(~75% of system RAM on unified-memory Macs) as the budget, while the
adapter descriptor reports half of it. Games sizing their streaming
pools from the budget can oversubscribe memory shared with the OS and
push the system into swap.

The new option caps both values consistently (megabytes; 0 = default).

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
(cherry picked from commit dbcc2318738ed80986f105d9e3110cbb72e434bd)
---
 dxmt.conf                 | 11 +++++++++++
 src/dxgi/dxgi_adapter.cpp |  9 +++++++--
 src/dxgi/dxgi_options.cpp |  2 ++
 src/dxgi/dxgi_options.hpp |  8 ++++++++
 4 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/dxmt.conf b/dxmt.conf
index 1e7f20000a709144938e8136cb371d19335f93ce..8851554abcea31a50360fcfa7f830ec58d50bbef 100644
--- a/dxmt.conf
+++ b/dxmt.conf
@@ -14,6 +14,17 @@
 # dxgi.customDeviceDesc = ""
 
 
+# Override the amount of video memory reported to the application, in megabytes.
+# Affects both the adapter descriptor (DedicatedVideoMemory) and the budget
+# returned by IDXGIAdapter3::QueryVideoMemoryInfo. By default the budget equals
+# recommendedMaxWorkingSetSize, which on unified-memory systems is ~75% of
+# system RAM and lets games oversubscribe memory shared with the OS.
+#
+# Supported values: Any positive integer (megabytes). 0 keeps the default.
+
+# dxgi.customVideoMemory = 0
+
+
 # Force to report a SDR display, in case of unintended behavior in HDR mode
 # This option only affects DXGI, and does not change what games see through nvapi
 # Setting to False does not imply the display will be reported as HDR
diff --git a/src/dxgi/dxgi_adapter.cpp b/src/dxgi/dxgi_adapter.cpp
index abccc658dcf5a27ee018ff82cec0217ec349bac5..b32aa1c8c42909ae87f6ec8514d31fbc17dc29d8 100644
--- a/src/dxgi/dxgi_adapter.cpp
+++ b/src/dxgi/dxgi_adapter.cpp
@@ -173,7 +173,9 @@ public:
 
     pDesc->SubSysId = 0;
     pDesc->Revision = 0;
-    if (device_.hasUnifiedMemory())
+    if (options_.customVideoMemory > 0)
+      pDesc->DedicatedVideoMemory = uint64_t(options_.customVideoMemory) << 20;
+    else if (device_.hasUnifiedMemory())
       pDesc->DedicatedVideoMemory = device_.recommendedMaxWorkingSetSize() / 2; // FIXME: use a more appropriate value
     else
       pDesc->DedicatedVideoMemory = device_.recommendedMaxWorkingSetSize();
@@ -244,7 +246,10 @@ public:
       return E_INVALIDARG;
 
     // we don't actually care about MemorySegmentGroup
-    pVideoMemoryInfo->Budget = device_.recommendedMaxWorkingSetSize();
+    if (options_.customVideoMemory > 0)
+      pVideoMemoryInfo->Budget = uint64_t(options_.customVideoMemory) << 20;
+    else
+      pVideoMemoryInfo->Budget = device_.recommendedMaxWorkingSetSize();
     pVideoMemoryInfo->CurrentUsage = device_.currentAllocatedSize();
     pVideoMemoryInfo->AvailableForReservation = 0;
     pVideoMemoryInfo->CurrentReservation =
diff --git a/src/dxgi/dxgi_options.cpp b/src/dxgi/dxgi_options.cpp
index 81c4b1cb92e78c03b9d4abf224732af914cf1cdc..9606154e0c8b7b0eddcf12364b95493f1b42a095 100644
--- a/src/dxgi/dxgi_options.cpp
+++ b/src/dxgi/dxgi_options.cpp
@@ -33,6 +33,8 @@ DxgiOptions::DxgiOptions(const Config &config) {
   this->customDeviceDesc =
       config.getOption<std::string>("dxgi.customDeviceDesc", "");
   this->forceSDR = config.getOption<bool>("dxgi.forceSDR", false);
+  this->customVideoMemory =
+      config.getOption<int>("dxgi.customVideoMemory", 0);
 }
 
 } // namespace dxmt
diff --git a/src/dxgi/dxgi_options.hpp b/src/dxgi/dxgi_options.hpp
index b5f8408f03d2451a512e7a124239550c7b51f3b5..af097a663d4ad935884d1fde0938677c82bd18ea 100644
--- a/src/dxgi/dxgi_options.hpp
+++ b/src/dxgi/dxgi_options.hpp
@@ -20,6 +20,14 @@ struct DxgiOptions {
   int32_t customDeviceId;
   std::string customDeviceDesc;
   bool forceSDR;
+
+  /// Override the amount of video memory reported to the
+  /// application, in megabytes. Affects both the adapter
+  /// descriptor and the budget returned by
+  /// QueryVideoMemoryInfo. 0 or negative keeps the default
+  /// behaviour. Useful on unified-memory systems where the
+  /// default budget lets games oversubscribe system RAM.
+  int32_t customVideoMemory;
 };
 
 } // namespace dxmt
\ No newline at end of file
