From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: StonkGuy <68372320+StonkGuy@users.noreply.github.com>
Date: Sat, 10 Oct 2026 15:14:52 +0300
Subject: [PATCH 02/27] dxmt: staging blocks write where newBuffer says the
 contents are

StagingBufferBlockAllocator placed its own malloc() under each block and
kept writing to that pointer, ignoring the WMTBufferInfo.memory that
newBuffer returns. BufferAllocation already uses the returned pointer.
With the stock unix side both are the same address; a unix side that
backs the buffer with other memory (steamac's wmtr remoting: the guest's
malloc is not visible to the host) saw argument buffers and staged
uploads as zeros, so draws rendered nothing. The block now keeps the
placed memory only for freeing and maps through the returned pointer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/dxmt/dxmt_ring_bump_allocator.hpp | 18 +++++++++++++-----
 1 file changed, 13 insertions(+), 5 deletions(-)

diff --git a/src/dxmt/dxmt_ring_bump_allocator.hpp b/src/dxmt/dxmt_ring_bump_allocator.hpp
index 5c92d92fb128d2d50af56b921351a891ab425eb5..15a1e4da54b5cd39956802697725ffa658e50aef 100644
--- a/src/dxmt/dxmt_ring_bump_allocator.hpp
+++ b/src/dxmt/dxmt_ring_bump_allocator.hpp
@@ -94,12 +94,16 @@ public:
     WMT::Reference<WMT::Buffer> buffer;
     uint64_t gpu_address;
     void *mapped_address;
+    /* the memory placed under the buffer (freed with the block); mapped_address is what newBuffer
+       returned for CPU access, which a unix side may back with other memory than the placed one */
+    void *placed_address;
 
     ~Block() {
-      if (mapped_address) {
-        free(mapped_address);
-        mapped_address = nullptr;
+      if (placed_address) {
+        free(placed_address);
+        placed_address = nullptr;
       }
+      mapped_address = nullptr;
     };
 
     Block() = default;
@@ -109,20 +113,24 @@ public:
       buffer = std::move(move.buffer);
       gpu_address = move.gpu_address;
       mapped_address = move.mapped_address;
+      placed_address = move.placed_address;
       move.mapped_address = nullptr;
+      move.placed_address = nullptr;
     };
   };
 
   Block
   allocate(size_t block_size) {
     Block block{};
-    block.mapped_address = placed_buffer_ ? malloc(block_size) : nullptr;
+    block.placed_address = placed_buffer_ ? malloc(block_size) : nullptr;
     WMTBufferInfo info;
     info.options = buffer_info_;
-    info.memory.set(block.mapped_address);
+    info.memory.set(block.placed_address);
     info.length = block_size;
     block.buffer = device_.newBuffer(info);
     block.gpu_address = info.gpu_address;
+    /* CPU writes go where newBuffer says the contents are (like BufferAllocation does) */
+    block.mapped_address = placed_buffer_ ? info.memory.get() : nullptr;
     return block;
   };
 
