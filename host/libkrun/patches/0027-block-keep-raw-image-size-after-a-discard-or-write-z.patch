+    /// A raw image is the disk: a discard or write-zeroes request that reaches the end of the
+    /// device must not shorten the file, or the next boot sees a smaller disk than the
+    /// filesystem on it (mke2fs zeroes the last 64 KiB of the device; fstrim and blkdiscard
+    /// on a whole-disk filesystem end there too).
+    #[test]
+    fn raw_image_keeps_size_after_tail_discard_and_write_zeroes() {
+        const SIZE: u64 = 4 << 20;
+        const TAIL: u64 = 64 << 10;
+        let backing = TempFile::new().expect("create backing file");
+        let path = backing.as_path().to_str().unwrap().to_string();
+        let open = || {
+            Block::new(
+                "tail".to_string(),
+                None,
+                CacheType::Unsafe,
+                path.clone(),
+                ImageType::Raw,
+                false,
+                false,
+                SyncMode::Full,
+            )
+            .expect("open raw image")
+        };
+
+        for request in ["write-zeroes", "write-zeroes+unmap", "discard"] {
+            backing.as_file().set_len(SIZE).expect("size backing file");
+            let block = open();
+            assert_eq!({ block.config.capacity }, SIZE / SECTOR_SIZE);
+            {
+                let mut disk = block.disk_image.lock().unwrap();
+                match request {
+                    "write-zeroes" => disk.write_zeroes(SIZE - TAIL, TAIL),
+                    "write-zeroes+unmap" => disk.discard_to_zero(SIZE - TAIL, TAIL),
+                    _ => disk.discard_to_any(SIZE - TAIL, TAIL),
+                }
+                .expect(request);
+            }
+            drop(block);
+
+            assert_eq!(
+                backing.as_file().metadata().unwrap().len(),
+                SIZE,
+                "{request} at the end of the disk changed the image file size"
+            );
+            assert_eq!(
+                { open().config.capacity },
+                SIZE / SECTOR_SIZE,
+                "{request} at the end of the disk shrank the disk seen on the next open"
+            );
+        }
+    }
+
     #[test]
     fn disk_image_id_accepts_empty_block_id() {
         let backing = TempFile::new().expect("create backing file");
