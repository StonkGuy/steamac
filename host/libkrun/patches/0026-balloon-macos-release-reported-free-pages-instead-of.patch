+    /// Lets the device hand reported free pages to the VMM worker, which drops them from the
+    /// VMM instead of only marking them MADV_FREE (see `release_free_pages`).
+    #[cfg(target_os = "macos")]
+    pub fn set_map_sender(&mut self, map_sender: Sender<WorkerMessage>) {
+        self.map_sender = Some(map_sender);
+    }
+
+    /// Returns free-page-reporting memory to the host.
+    ///
+    /// On macOS, MADV_FREE leaves the pages charged to the VMM (phys_footprint) until the host
+    /// is short of memory, and the guest's stage-2 mapping keeps them alive, so a guest that has
+    /// once touched all of its RAM stays at that footprint for good. With the VMM worker
+    /// available, the whole host pages of the range are discarded and remapped instead
+    /// (`HvfVm::discard_memory`); partial host pages at the edges, and any failure, fall back
+    /// to MADV_FREE.
+    #[cfg(target_os = "macos")]
+    fn release_free_pages(
+        map_sender: Option<&Sender<WorkerMessage>>,
+        mem: &GuestMemoryMmap,
+        guest_addr: GuestAddress,
+        len: usize,
+    ) {
+        let Ok(host_addr) = mem.get_host_address(guest_addr) else {
+            error!("balloon: reported range {guest_addr:?} is not guest memory");
+            return;
+        };
+        let madv_free = |addr: usize, len: usize| {
+            if len > 0 {
+                // SAFETY: a range of guest memory the guest has given up.
+                unsafe { libc::madvise(addr as *mut libc::c_void, len, libc::MADV_FREE) };
+            }
+        };
+        let start = host_addr as usize;
+        let end = start + len;
+        // SAFETY: sysconf has no preconditions.
+        let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) } as usize;
+        let (dstart, dend) = (start.next_multiple_of(page), end / page * page);
+        let discarded = match map_sender {
+            // the whole range must lie in one guest memory region (one host mapping)
+            Some(sender) if dend > dstart && mem.get_slice(guest_addr, len).is_ok() => {
+                let (reply_sender, reply_receiver) = crossbeam_channel::bounded(1);
+                let guest = guest_addr.0 + (dstart - start) as u64;
+                sender
+                    .send(WorkerMessage::DiscardMemory(
+                        reply_sender,
+                        dstart as u64,
+                        guest,
+                        (dend - dstart) as u64,
+                    ))
+                    .is_ok()
+                    && reply_receiver.recv().unwrap_or(false)
+            }
+            _ => false,
+        };
+        if discarded {
+            madv_free(start, dstart - start);
+            madv_free(dend, end - dend);
+        } else {
+            madv_free(start, len);
+        }
+    }
+
     pub fn id(&self) -> &str {
         defs::BALLOON_DEV_ID
     }
