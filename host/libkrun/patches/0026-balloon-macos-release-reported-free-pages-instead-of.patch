+#[cfg(all(test, target_arch = "aarch64"))]
+mod tests {
+    //! Needs the com.apple.security.hypervisor entitlement (see the steamac test script that
+    //! signs and runs this binary); one HVF VM per process, so a single test.
+    use super::*;
+
+    const CODE_GPA: u64 = 0x4000_0000;
+    const DATA_GPA: u64 = 0x4010_0000;
+    const DATA_SIZE: u64 = 16 << 20;
+    const STEP: u64 = 16384;
+
+    // the library crate leaves linking the framework to the final binary (libkrun's build.rs)
+    #[link(name = "Hypervisor", kind = "framework")]
+    extern "C" {}
+
+    extern "C" {
+        fn proc_pid_rusage(pid: i32, flavor: i32, buffer: *mut u64) -> i32;
+    }
+
+    /// phys_footprint of this process (rusage_info_v4: ri_phys_footprint is the 9th u64).
+    fn footprint() -> u64 {
+        let mut ri = [0u64; 64];
+        // SAFETY: RUSAGE_INFO_V4 (4) fills less than 64 u64s.
+        assert_eq!(unsafe { proc_pid_rusage(std::process::id() as i32, 4, ri.as_mut_ptr()) }, 0);
+        ri[8]
+    }
+
+    fn anon(size: u64) -> u64 {
+        // SAFETY: a fresh private anonymous mapping.
+        let p = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                size as usize,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANON,
+                -1,
+                0,
+            )
+        };
+        assert_ne!(p, libc::MAP_FAILED);
+        p as u64
+    }
+
+    /// Runs the guest loop that stores `val` into every host page of the data range; it ends
+    /// with an HVC (EC 0x16), which always exits to the host.
+    fn guest_fill(vcpu: &mut HvfVcpu, ipa: u32, val: u64) {
+        vcpu.set_initial_state(ipa, CODE_GPA, DATA_GPA).unwrap(); // pc, x0
+        vcpu.write_reg(hv_reg_t_HV_REG_X1, DATA_GPA + DATA_SIZE).unwrap();
+        vcpu.write_reg(hv_reg_t_HV_REG_X2, val).unwrap();
+        // SAFETY: a vcpu created on this thread.
+        assert_eq!(unsafe { hv_vcpu_run(vcpu.vcpuid) }, HV_SUCCESS);
+        let ec = (vcpu.vcpu_exit.exception.syndrome >> 26) & 0x3f;
+        if ec != 0x16 {
+            let r = |r| vcpu.read_sys_reg(r).unwrap_or(0);
+            panic!(
+                "guest exit ec {ec:#x}: pc {:#x} esr_el1 {:#x} elr_el1 {:#x} far_el1 {:#x}",
+                vcpu.read_reg(hv_reg_t_HV_REG_PC).unwrap_or(0),
+                r(hv_sys_reg_t_HV_SYS_REG_ESR_EL1),
+                r(hv_sys_reg_t_HV_SYS_REG_ELR_EL1),
+                r(hv_sys_reg_t_HV_SYS_REG_FAR_EL1)
+            );
+        }
+    }
+
+    fn host_all(host: u64, val: u64) -> bool {
+        // SAFETY: reads of our own mapping.
+        (0..DATA_SIZE)
+            .step_by(STEP as usize)
+            .all(|o| unsafe { std::ptr::read_volatile((host + o) as *const u64) } == val)
+    }
+
+    #[test]
+    fn discard_memory_releases_pages_and_keeps_the_guest_mapping() {
+        let mut info = ArchMemoryInfo {
+            guest_last_addr: DATA_GPA + DATA_SIZE,
+            ..Default::default()
+        };
+        let vm = HvfVm::new(&mut info, false).unwrap();
+        // str x2, [x0]; add x0, x0, #16384; cmp x0, x1; b.lt -3; hvc #0
+        let code = anon(STEP);
+        let prog: [u32; 5] = [0xf900_0002, 0x9140_1000, 0xeb01_001f, 0x54ff_ffab, 0xd400_0002];
+        // SAFETY: code is a fresh STEP-byte mapping.
+        unsafe { std::ptr::copy_nonoverlapping(prog.as_ptr(), code as *mut u32, prog.len()) };
+        vm.map_memory(code, CODE_GPA, STEP).unwrap();
+        let data = anon(DATA_SIZE);
+        vm.map_memory(data, DATA_GPA, DATA_SIZE).unwrap();
+        let mut vcpu = HvfVcpu::new(0, false).unwrap();
+
+        guest_fill(&mut vcpu, info.ipa_size, 5);
+        assert!(host_all(data, 5), "guest stores not visible to the host");
+        let before = footprint();
+
+        vm.discard_memory(data, DATA_GPA, DATA_SIZE).unwrap();
+        let after = footprint();
+        assert!(
+            before >= after + DATA_SIZE,
+            "discard released {} of {DATA_SIZE} bytes",
+            before.saturating_sub(after)
+        );
+        assert!(host_all(data, 0), "discarded memory not zero");
+
+        // the guest must now write the host's new pages, not the released ones
+        guest_fill(&mut vcpu, info.ipa_size, 9);
+        assert!(host_all(data, 9), "guest writes after discard not visible to the host");
+    }
+}
