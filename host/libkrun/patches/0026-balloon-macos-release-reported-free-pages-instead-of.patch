+
+    /// Releases the host pages behind guest memory the guest no longer uses, so the next guest
+    /// access sees fresh zero pages. `host_start_addr` must be the private anonymous mapping
+    /// that backs `guest_start_addr` (as set up by `map_memory`), both host-page aligned.
+    ///
+    /// madvise() is not enough on macOS: after MADV_FREE or MADV_DONTNEED the pages stay
+    /// charged to the task until the host runs short of memory, and the stage-2 mapping keeps
+    /// referencing them. A new anonymous mapping over the range releases them at once; the
+    /// stage-2 mapping is rebuilt on top of it because hv_vm_map() binds the pages, not the
+    /// host address range (without that, the guest would keep writing to the old pages).
+    pub fn discard_memory(
+        &self,
+        host_start_addr: u64,
+        guest_start_addr: u64,
+        size: u64,
+    ) -> Result<(), Error> {
+        self.unmap_memory(guest_start_addr, size)?;
+        // SAFETY: the range is guest RAM owned by this VMM; nothing else maps it.
+        let ret = unsafe {
+            libc::mmap(
+                host_start_addr as *mut libc::c_void,
+                size as libc::size_t,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANON | libc::MAP_FIXED,
+                -1,
+                0,
+            )
+        };
+        // Map it back either way: if mmap() failed, the old pages are still there.
+        self.map_memory(host_start_addr, guest_start_addr, size)?;
+        if ret == libc::MAP_FAILED {
+            return Err(Error::MemoryDiscard);
+        }
+        Ok(())
+    }
 }
 
