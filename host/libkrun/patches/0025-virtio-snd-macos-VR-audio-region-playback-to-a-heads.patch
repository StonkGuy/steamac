+    /// The render callback copies what it plays into the VR play ring (stereo S16 at the guest
+    /// rate), silences the device only when asked to, and leaves the ring alone without a region.
+    #[test]
+    fn render_callback_copies_playback_to_the_vr_ring() {
+        let wake = Arc::new(Semaphore::new().unwrap());
+        let shared = Shared::new(Direction::Output, false, wake);
+        shared.rate.store(44100, Ordering::Relaxed);
+        shared.limit.store(u64::MAX, Ordering::Release);
+        shared.running.store(true, Ordering::Release);
+        let feed = |value: i16| {
+            let pcm: Vec<u8> = (0..256)
+                .flat_map(|_| [value.to_le_bytes(), (-value).to_le_bytes()].concat())
+                .collect();
+            let mut off = 0;
+            // SAFETY: this thread is the only producer.
+            unsafe {
+                shared.ring.produce(pcm.len(), |dst| {
+                    dst.copy_from_slice(&pcm[off..off + dst.len()]);
+                    off += dst.len();
+                    dst.len()
+                })
+            };
+        };
+        let vr = Arc::new(VrAudio::anonymous(0));
+        let mut got = vec![0i16; 1024];
+
+        feed(1000);
+        let device = render_once(&shared);
+        assert!((device[0] - 1000.0 / 32768.0).abs() < 1e-4);
+        assert_eq!(vr.host_read_play(&mut got), 0, "no region published");
+
+        shared
+            .vr
+            .store(Arc::as_ptr(&vr) as *mut VrAudio, Ordering::Release);
+        feed(2000);
+        let device = render_once(&shared);
+        assert!((device[1] + 2000.0 / 32768.0).abs() < 1e-4, "the Mac still plays");
+        assert_eq!(vr.host_read_play(&mut got), 256);
+        assert_eq!(&got[..4], &[2000, -2000, 2000, -2000]);
+        assert_eq!(vr.play_rate(), 44100);
+
+        shared.vr_mute.store(true, Ordering::Release);
+        feed(3000);
+        let device = render_once(&shared);
+        assert!(device.iter().all(|v| *v == 0.0), "KRUN_SND_VR_MUTE_LOCAL");
+        assert_eq!(vr.host_read_play(&mut got), 256);
+        assert_eq!(&got[..2], &[3000, -3000]);
+
+        // an underrun reaches the headset as the same silence the device plays
+        let _ = render_once(&shared);
+        assert_eq!(vr.host_read_play(&mut got), 256);
+        assert!(got[..512].iter().all(|v| *v == 0));
+    }
+
+    /// Playback follows the headset: published to the callback while the region's host reports
+    /// a speaker, taken away (and unmapped, the unit being stopped) when it does not.
+    #[test]
+    fn playback_follows_the_vr_headset() {
+        let backend = backend(CTL, STALL);
+        let control = backend.inner.hosts.lock().unwrap()[0].control.clone();
+        control.set_vr_audio(Some(VrAudio::anonymous(crate::virtio::snd::VR_MUTE_LOCAL)));
+        let vr = control.vr_audio().unwrap();
+        let published = |backend: &CoreAudioBackend| {
+            let mut hosts = backend.inner.hosts.lock().unwrap();
+            hosts[0].follow_vr();
+            (
+                !hosts[0].shared.vr.load(Ordering::Acquire).is_null(),
+                hosts[0].shared.vr_mute.load(Ordering::Acquire),
+                hosts[0].vr_retired.len(),
+            )
+        };
+        assert_eq!(published(&backend), (false, false, 0), "attached, no headset");
+        vr.host_publish(HEADSET_MIC);
+        assert_eq!(published(&backend), (false, false, 0), "a headset without a speaker");
+        vr.host_publish(HEADSET_SPEAKER | HEADSET_MIC);
+        assert_eq!(published(&backend), (true, true, 0));
+        vr.host_publish(0);
+        assert_eq!(published(&backend), (false, false, 0), "headset disconnected");
+        vr.host_publish(HEADSET_SPEAKER);
+        assert_eq!(published(&backend), (true, true, 0));
+        let weak = Arc::downgrade(&vr);
+        drop(vr);
+        control.set_vr_audio(None);
+        assert_eq!(published(&backend), (false, false, 0), "detached");
+        assert!(weak.upgrade().is_none(), "the region is unmapped");
+    }
