+    /// One render callback of 256 stereo frames on `shared`; returns what the device got.
+    fn render_once(shared: &Shared) -> Vec<f32> {
+        let mut device = vec![0u8; 256 * 2 * 4];
+        let mut io = AudioBufferList {
+            mNumberBuffers: 1,
+            mBuffers: [AudioBuffer {
+                mNumberChannels: 2,
+                mDataByteSize: device.len() as u32,
+                mData: device.as_mut_ptr() as *mut c_void,
+            }],
+        };
+        let mut flags = 0u32;
+        render_output(
+            shared as *const Shared as *mut c_void,
+            &mut flags,
+            ptr::null(),
+            0,
+            256,
+            &mut io,
+        );
+        device
+            .chunks_exact(4)
+            .map(|b| f32::from_le_bytes(b.try_into().unwrap()))
+            .collect()
+    }
