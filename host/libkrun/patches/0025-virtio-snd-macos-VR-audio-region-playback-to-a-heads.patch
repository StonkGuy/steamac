+// SPDX-License-Identifier: Apache-2.0
+//
+// VR audio region: the guest's playback to steamac-vrhost and the headset microphone back, over
+// shared memory (layout: steamac-vrhost include/vraudio.h, mirrored here; contract:
+// docs/vr-interfaces.md section 6 of steamac). The region is created by the embedder and attached
+// with krun_snd_set_vr_audio(); nothing is linked across the boundary.
+//
+// Routing follows the headset, not the attachment: the host publishes in the region what the
+// connected headset offers (`headset`) and that it is alive (`beat`); see `VrAudio::headset`.
+// Without a headset, or with a host that stopped beating, the guest's audio is the Mac's.
+//
+// Playback: the CoreAudio render callback keeps clocking the guest stream exactly as without VR
+// (the Mac output device stays the clock, so the guest's hw_ptr, FIFO and latency reporting do
+// not change). While a headset with a speaker is connected the callback also downmixes what it
+// plays to stereo S16 and appends it to the play ring (lock-free, allocation-free); with
+// KRUN_SND_VR_MUTE_LOCAL the Mac speakers get silence meanwhile. Otherwise the callback pays
+// one atomic load.
+//
+// Capture: while a headset with a microphone is connected the guest records from the mic ring
+// instead of the Mac microphone (no HAL unit, no permission prompt); a running capture stream
+// switches source when the headset comes or goes. The pump thread paces it by the host clock at
+// the guest rate, resamples (linear) from the headset rate, primes a 20 ms jitter buffer, plays
+// silence when the headset is late (counted) and drops a backlog beyond 80 ms (WiVRn's own
+// microphone policy, server/audio/audio_pipewire.cpp).
+
+use std::collections::VecDeque;
+use std::io;
+use std::mem::size_of;
+use std::os::fd::RawFd;
+use std::ptr;
+use std::sync::atomic::{AtomicU32, AtomicU64, Ordering};
+
+use super::super::virtio_sound::*;
+
+pub const VRA_MAGIC: u32 = 0x3141_5256; // "VRA1"
+pub const VRA_VERSION: u32 = 1;
+pub const PLAY_CHANNELS: usize = 2;
+pub const MIC_CHANNELS: usize = 1;
+pub const PLAY_FRAMES: usize = 8192;
+pub const MIC_FRAMES: usize = 8192;
+
+/// krun_snd_set_vr_audio flag: silence the Mac output while the region is attached.
+pub const VR_MUTE_LOCAL: u32 = 1;
+
+/// `headset` bits (VRA_HEADSET_*).
+pub const HEADSET_SPEAKER: u32 = 1;
+pub const HEADSET_MIC: u32 = 2;
+/// VRA_BEAT_TIMEOUT_MS: a host whose beat stood still this long has no headset for us.
+const BEAT_TIMEOUT_NS: u64 = 1_000_000_000;
+
+#[repr(C)]
+struct RingHdr {
+    write: u64,
+    _pad0: [u8; 56],
+    read: u64,
+    _pad1: [u8; 56],
+    rate: u32,
+    channels: u32,
+    capacity: u32,
+    active: u32,
+    overruns: u64,
+    underruns: u64,
+    _pad2: [u8; 32],
+}
+
+#[repr(C)]
+struct Region {
+    magic: u32,
+    version: u32,
+    size: u32,
+    headset: u32,
+    beat: u32,
+    _pad: [u8; 44],
+    play: RingHdr,
+    mic: RingHdr,
+    play_data: [i16; PLAY_FRAMES * PLAY_CHANNELS],
+    mic_data: [i16; MIC_FRAMES * MIC_CHANNELS],
+}
+
+/// Bytes mapped (whole 16 KiB pages), VRA_REGION_BYTES in vraudio.h.
+pub const REGION_BYTES: usize = (size_of::<Region>() + 16383) & !16383;
+
+/// One side of a ring, as raw pointers into the mapping.
+struct Ring {
+    hdr: *mut RingHdr,
+    data: *mut i16,
+    channels: usize,
+    capacity: usize,
+}
+
+impl Ring {
+    fn write_idx(&self) -> &AtomicU64 {
+        // SAFETY: the header lives as long as the mapping, u64 fields are 8-byte aligned.
+        unsafe { AtomicU64::from_ptr(ptr::addr_of_mut!((*self.hdr).write)) }
+    }
+    fn read_idx(&self) -> &AtomicU64 {
+        // SAFETY: as above.
+        unsafe { AtomicU64::from_ptr(ptr::addr_of_mut!((*self.hdr).read)) }
+    }
+    fn u32_field(&self, f: fn(*mut RingHdr) -> *mut u32) -> &AtomicU32 {
+        // SAFETY: as above; u32 fields are 4-byte aligned.
+        unsafe { AtomicU32::from_ptr(f(self.hdr)) }
+    }
+    fn u64_field(&self, f: fn(*mut RingHdr) -> *mut u64) -> &AtomicU64 {
+        // SAFETY: as above.
+        unsafe { AtomicU64::from_ptr(f(self.hdr)) }
+    }
+    fn rate(&self) -> &AtomicU32 {
+        self.u32_field(|h| unsafe { ptr::addr_of_mut!((*h).rate) })
+    }
+    fn active(&self) -> &AtomicU32 {
+        self.u32_field(|h| unsafe { ptr::addr_of_mut!((*h).active) })
+    }
+    fn overruns(&self) -> &AtomicU64 {
+        self.u64_field(|h| unsafe { ptr::addr_of_mut!((*h).overruns) })
+    }
+    fn underruns(&self) -> &AtomicU64 {
+        self.u64_field(|h| unsafe { ptr::addr_of_mut!((*h).underruns) })
+    }
+
+    fn available(&self) -> usize {
+        (self.write_idx().load(Ordering::Acquire) - self.read_idx().load(Ordering::Acquire)) as usize
+    }
+
+    /// Producer. Frames that do not fit are dropped and counted.
+    fn write(&self, src: &[i16]) -> usize {
+        let frames = src.len() / self.channels;
+        let wr = self.write_idx().load(Ordering::Relaxed);
+        let free = self.capacity - (wr - self.read_idx().load(Ordering::Acquire)) as usize;
+        let n = frames.min(free);
+        let mut done = 0;
+        while done < n {
+            let off = (wr as usize + done) & (self.capacity - 1);
+            let k = (n - done).min(self.capacity - off);
+            // SAFETY: off + k <= capacity; the producer owns these slots until it publishes.
+            unsafe {
+                ptr::copy_nonoverlapping(
+                    src.as_ptr().add(done * self.channels),
+                    self.data.add(off * self.channels),
+                    k * self.channels,
+                )
+            };
+            done += k;
+        }
+        self.write_idx().store(wr + n as u64, Ordering::Release);
+        if n < frames {
+            self.overruns()
+                .fetch_add((frames - n) as u64, Ordering::Relaxed);
+        }
+        n
+    }
+
+    /// Consumer: up to dst.len() / channels frames.
+    fn read(&self, dst: &mut [i16]) -> usize {
+        let rd = self.read_idx().load(Ordering::Relaxed);
+        let avail = (self.write_idx().load(Ordering::Acquire) - rd) as usize;
+        let n = (dst.len() / self.channels).min(avail);
+        let mut done = 0;
+        while done < n {
+            let off = (rd as usize + done) & (self.capacity - 1);
+            let k = (n - done).min(self.capacity - off);
+            // SAFETY: as in write; the consumer owns published slots until it advances `read`.
+            unsafe {
+                ptr::copy_nonoverlapping(
+                    self.data.add(off * self.channels),
+                    dst.as_mut_ptr().add(done * self.channels),
+                    k * self.channels,
+                )
+            };
+            done += k;
+        }
+        self.read_idx().store(rd + n as u64, Ordering::Release);
+        n
+    }
+}
+
+/// A mapped VR audio region.
+pub struct VrAudio {
+    base: *mut Region,
+    play: Ring,
+    mic: Ring,
+    flags: u32,
+    /// Liveness of the host: the last beat seen and when it last changed (0 = never).
+    last_beat: AtomicU32,
+    beat_changed_ns: AtomicU64,
+}
+
+// SAFETY: all shared state is accessed through atomics or by the single producer/consumer of
+// each ring (the render callback produces `play`, the pump thread consumes `mic`).
+unsafe impl Send for VrAudio {}
+unsafe impl Sync for VrAudio {}
+
+impl VrAudio {
+    /// Maps `fd` (not consumed: the caller keeps or closes it).
+    pub fn map(fd: RawFd, flags: u32) -> io::Result<Self> {
+        // SAFETY: plain mmap of a caller-provided fd; checked below.
+        let p = unsafe {
+            libc::mmap(
+                ptr::null_mut(),
+                REGION_BYTES,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED,
+                fd,
+                0,
+            )
+        };
+        if p == libc::MAP_FAILED {
+            return Err(io::Error::last_os_error());
+        }
+        let vr = Self::from_base(p as *mut Region, flags);
+        if !vr.valid() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "not a VR audio region (vraudio.h version 1)",
+            ));
+        }
+        Ok(vr)
+    }
+
+    /// A private, initialised region (tests).
+    #[cfg(test)]
+    pub fn anonymous(flags: u32) -> Self {
+        // SAFETY: anonymous shared mapping.
+        let p = unsafe {
+            libc::mmap(
+                ptr::null_mut(),
+                REGION_BYTES,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED | libc::MAP_ANON,
+                -1,
+                0,
+            )
+        };
+        assert_ne!(p, libc::MAP_FAILED);
+        let r = p as *mut Region;
+        // SAFETY: freshly mapped, zeroed; vra_region_init().
+        unsafe {
+            (*r).magic = VRA_MAGIC;
+            (*r).version = VRA_VERSION;
+            (*r).size = size_of::<Region>() as u32;
+            (*r).play.channels = PLAY_CHANNELS as u32;
+            (*r).play.capacity = PLAY_FRAMES as u32;
+            (*r).mic.channels = MIC_CHANNELS as u32;
+            (*r).mic.capacity = MIC_FRAMES as u32;
+        }
+        Self::from_base(r, flags)
+    }
+
+    fn from_base(base: *mut Region, flags: u32) -> Self {
+        // SAFETY: pointers into the mapping, valid for its lifetime.
+        unsafe {
+            Self {
+                base,
+                play: Ring {
+                    hdr: ptr::addr_of_mut!((*base).play),
+                    data: ptr::addr_of_mut!((*base).play_data) as *mut i16,
+                    channels: PLAY_CHANNELS,
+                    capacity: PLAY_FRAMES,
+                },
+                mic: Ring {
+                    hdr: ptr::addr_of_mut!((*base).mic),
+                    data: ptr::addr_of_mut!((*base).mic_data) as *mut i16,
+                    channels: MIC_CHANNELS,
+                    capacity: MIC_FRAMES,
+                },
+                flags,
+                last_beat: AtomicU32::new(0),
+                beat_changed_ns: AtomicU64::new(0),
+            }
+        }
+    }
+
+    /// What the connected headset offers (HEADSET_*), 0 while there is none or the host has not
+    /// beaten for BEAT_TIMEOUT_NS. `now_ns` is any monotonic clock; called from the pump thread.
+    pub fn headset(&self, now_ns: u64) -> u32 {
+        // SAFETY: aligned u32 fields of the mapping.
+        let (beat, headset) = unsafe {
+            (
+                AtomicU32::from_ptr(ptr::addr_of_mut!((*self.base).beat)).load(Ordering::Acquire),
+                AtomicU32::from_ptr(ptr::addr_of_mut!((*self.base).headset))
+                    .load(Ordering::Acquire),
+            )
+        };
+        if self.last_beat.swap(beat, Ordering::Relaxed) != beat {
+            self.beat_changed_ns.store(now_ns.max(1), Ordering::Relaxed);
+        }
+        let changed = self.beat_changed_ns.load(Ordering::Relaxed);
+        if changed == 0 || now_ns.saturating_sub(changed) >= BEAT_TIMEOUT_NS {
+            return 0;
+        }
+        headset
+    }
+
+    fn valid(&self) -> bool {
+        // SAFETY: header read of a mapping of at least REGION_BYTES.
+        let r = unsafe { &*self.base };
+        r.magic == VRA_MAGIC
+            && r.version == VRA_VERSION
+            && r.size as usize == size_of::<Region>()
+            && r.play.channels as usize == PLAY_CHANNELS
+            && r.play.capacity as usize == PLAY_FRAMES
+            && r.mic.channels as usize == MIC_CHANNELS
+            && r.mic.capacity as usize == MIC_FRAMES
+    }
+
+    pub fn mute_local(&self) -> bool {
+        self.flags & VR_MUTE_LOCAL != 0
+    }
+
+    /// Render callback: interleaved stereo Float32 (LE bytes, as `Mixer::render` writes it) at
+    /// `rate` -> S16 into the play ring, through `tmp` (no allocation).
+    pub fn write_play_f32(&self, rate: u32, stereo_f32: &[u8], tmp: &mut [i16]) -> usize {
+        self.play.rate().store(rate, Ordering::Relaxed);
+        let n = (stereo_f32.len() / 4).min(tmp.len()) / PLAY_CHANNELS * PLAY_CHANNELS;
+        for (d, s) in tmp[..n].iter_mut().zip(stereo_f32.chunks_exact(4)) {
+            let v = f32::from_le_bytes(s.try_into().unwrap());
+            *d = (v.clamp(-1.0, 1.0) * 32767.0).round() as i16;
+        }
+        self.play.write(&tmp[..n])
+    }
+
+    pub fn set_mic_active(&self, active: bool) {
+        self.mic.active().store(active as u32, Ordering::Release);
+    }
+
+    pub fn mic_active(&self) -> bool {
+        self.mic.active().load(Ordering::Acquire) != 0
+    }
+
+    /// Headset microphone rate; 48 kHz until the host has written any.
+    pub fn mic_rate(&self) -> u32 {
+        match self.mic.rate().load(Ordering::Acquire) {
+            0 => 48000,
+            r => r,
+        }
+    }
+
+    pub fn read_mic(&self, dst: &mut [i16]) -> usize {
+        self.mic.read(dst)
+    }
+
+    pub fn mic_available(&self) -> usize {
+        self.mic.available()
+    }
+
+    fn add_mic_underruns(&self, frames: u64) {
+        self.mic.underruns().fetch_add(frames, Ordering::Relaxed);
+    }
+
+    // --- the other ends, for tests (steamac-vrhost's side) ---
+    #[cfg(test)]
+    pub fn host_read_play(&self, dst: &mut [i16]) -> usize {
+        self.play.read(dst)
+    }
+    #[cfg(test)]
+    pub fn play_rate(&self) -> u32 {
+        self.play.rate().load(Ordering::Acquire)
+    }
+    #[cfg(test)]
+    pub fn play_overruns(&self) -> u64 {
+        self.play.overruns().load(Ordering::Relaxed)
+    }
+    #[cfg(test)]
+    pub fn host_write_mic(&self, rate: u32, src: &[i16]) -> usize {
+        self.mic.rate().store(rate, Ordering::Release);
+        self.mic.write(src)
+    }
+    /// The host's tick: publish the headset and beat.
+    #[cfg(test)]
+    pub fn host_publish(&self, headset: u32) {
+        // SAFETY: as in headset().
+        unsafe {
+            AtomicU32::from_ptr(ptr::addr_of_mut!((*self.base).headset))
+                .store(headset, Ordering::Release);
+            AtomicU32::from_ptr(ptr::addr_of_mut!((*self.base).beat))
+                .fetch_add(1, Ordering::Release);
+        }
+    }
+    #[cfg(test)]
+    pub fn mic_underruns(&self) -> u64 {
+        self.mic.underruns().load(Ordering::Relaxed)
+    }
+}
+
+impl Drop for VrAudio {
+    fn drop(&mut self) {
+        // SAFETY: mapped in map()/anonymous() with this length.
+        unsafe { libc::munmap(self.base as *mut libc::c_void, REGION_BYTES) };
+    }
+}
+
+/// Guest capture from the mic ring: host-clock pacing at the guest rate, linear resampling,
+/// jitter buffer, conversion to the guest's format and channel count.
+pub struct MicStream {
+    format: u8,
+    rate: u32,
+    channels: usize,
+    start_ns: u64,
+    /// Guest frames delivered since `start_ns`.
+    produced: u64,
+    /// Mono samples at the guest rate, ready to deliver.
+    fifo: VecDeque<f32>,
+    primed: bool,
+    // resampler (headset rate -> guest rate)
+    in_rate: u32,
+    pos: f64,
+    prev: f32,
+    scratch: Vec<i16>,
+}
+
+impl MicStream {
+    /// Jitter buffer the guest is fed from once primed (WiVRn's headset sends 5 ms packets).
+    pub const PRIME_MS: u64 = 20;
+    /// Backlog beyond which the oldest audio is dropped (WiVRn server: 80 ms).
+    pub const MAX_MS: u64 = 80;
+
+    pub fn new(format: u8, rate: u32, channels: u32, now_ns: u64) -> Self {
+        Self {
+            format,
+            rate,
+            channels: channels as usize,
+            start_ns: now_ns,
+            produced: 0,
+            fifo: VecDeque::new(),
+            primed: false,
+            in_rate: 0,
+            pos: 0.0,
+            prev: 0.0,
+            scratch: vec![0; MIC_FRAMES],
+        }
+    }
+
+    pub fn frame_bytes(&self) -> usize {
+        self.channels * sample_bytes(self.format)
+    }
+
+    /// Latency the guest should be told about, in guest frames.
+    pub fn latency_frames(&self) -> u64 {
+        self.rate as u64 * Self::PRIME_MS / 1000
+    }
+
+    fn pull_ring(&mut self, vr: &VrAudio) {
+        let in_rate = vr.mic_rate();
+        if in_rate != self.in_rate {
+            self.in_rate = in_rate;
+            self.pos = 0.0;
+        }
+        loop {
+            let mut buf = std::mem::take(&mut self.scratch);
+            let n = vr.read_mic(&mut buf);
+            self.resample(&buf[..n]);
+            self.scratch = buf;
+            if n < MIC_FRAMES {
+                break;
+            }
+        }
+    }
+
+    /// Same algorithm as steamac-vrhost's pcm::Resampler: x(-1) = last frame of the previous
+    /// block, `pos` = position of the next output frame on that axis.
+    fn resample(&mut self, input: &[i16]) {
+        let n = input.len();
+        if n == 0 {
+            return;
+        }
+        if self.in_rate == self.rate {
+            self.fifo
+                .extend(input.iter().map(|&s| s as f32 / 32768.0));
+            return;
+        }
+        let step = self.in_rate as f64 / self.rate as f64;
+        let x = |i: isize| -> f32 {
+            if i < 0 {
+                self.prev
+            } else {
+                input[i as usize] as f32 / 32768.0
+            }
+        };
+        let mut out = Vec::with_capacity((n as f64 / step) as usize + 2);
+        while self.pos <= (n - 1) as f64 {
+            let i = self.pos.floor() as isize;
+            let f = (self.pos - i as f64) as f32;
+            let a = x(i);
+            let b = if f > 0.0 { x(i + 1) } else { a };
+            out.push(a + (b - a) * f);
+            self.pos += step;
+        }
+        self.pos -= n as f64;
+        self.prev = input[n - 1] as f32 / 32768.0;
+        self.fifo.extend(out);
+    }
+
+    /// Guest frames due at `now_ns` (host clock), at most `max_frames`, appended to `out` in the
+    /// guest format. Silence fills what the headset has not delivered (after priming: counted as
+    /// underruns in the ring).
+    pub fn pull(&mut self, vr: &VrAudio, now_ns: u64, max_frames: usize, out: &mut Vec<u8>) -> usize {
+        self.pull_ring(vr);
+        let prime = (self.rate as u64 * Self::PRIME_MS / 1000) as usize;
+        let max = (self.rate as u64 * Self::MAX_MS / 1000) as usize;
+        if self.fifo.len() > max {
+            let drop = self.fifo.len() - prime;
+            self.fifo.drain(..drop);
+        }
+        let elapsed = now_ns.saturating_sub(self.start_ns) as u128;
+        let due_total = (elapsed * self.rate as u128 / 1_000_000_000) as u64;
+        if due_total.saturating_sub(self.produced) > max as u64 {
+            // The guest took nothing for a while (no buffers queued, a paused VM): that time is
+            // gone, do not make it up with a burst.
+            self.produced = due_total - prime as u64;
+        }
+        let due = (due_total.saturating_sub(self.produced) as usize).min(max_frames);
+        if due == 0 {
+            return 0;
+        }
+        if !self.primed && self.fifo.len() >= prime {
+            self.primed = true;
+        }
+        let have = if self.primed { self.fifo.len().min(due) } else { 0 };
+        if self.primed && have < due {
+            vr.add_mic_underruns((due - have) as u64);
+            self.primed = false; // re-prime: a late headset costs one gap, not a stutter
+        }
+        out.reserve(due * self.frame_bytes());
+        for i in 0..due {
+            let v = if i < have {
+                self.fifo.pop_front().unwrap()
+            } else {
+                0.0
+            };
+            for _ in 0..self.channels {
+                encode(self.format, v, out);
+            }
+        }
+        self.produced += due as u64;
+        due
+    }
+}
+
+fn sample_bytes(format: u8) -> usize {
+    match format {
+        VIRTIO_SND_PCM_FMT_U8 => 1,
+        VIRTIO_SND_PCM_FMT_S16 => 2,
+        _ => 4,
+    }
+}
+
+fn encode(format: u8, v: f32, out: &mut Vec<u8>) {
+    let v = v.clamp(-1.0, 1.0);
+    match format {
+        VIRTIO_SND_PCM_FMT_U8 => out.push(((v * 127.0).round() as i16 + 128) as u8),
+        VIRTIO_SND_PCM_FMT_S16 => out.extend_from_slice(&((v * 32767.0).round() as i16).to_le_bytes()),
+        VIRTIO_SND_PCM_FMT_S32 => {
+            out.extend_from_slice(&((v as f64 * 2147483647.0).round() as i32).to_le_bytes())
+        }
+        _ => out.extend_from_slice(&v.to_le_bytes()),
+    }
+}
