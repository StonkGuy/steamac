+                    error!("krun_snd_set_vr_audio: {err}");
+                    return -libc::EINVAL;
+                }
+            }
+        };
+        with_snd_control(ctx_id, |control| {
+            control.set_vr_audio(vr);
+            KRUN_SUCCESS
+        })
+    }
+    #[cfg(not(all(feature = "snd", target_os = "macos")))]
+    {
+        let _ = (ctx_id, fd, flags);
