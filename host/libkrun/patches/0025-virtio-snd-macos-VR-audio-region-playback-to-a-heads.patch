+    /// A capture stream records from the VR headset's microphone while its host reports one:
+    /// no HAL unit, the region's mic ring paced into the guest's buffers, `active` telling the
+    /// host when the guest records.
+    #[test]
+    fn capture_records_from_the_vr_headset() {
+        let mut stream = Stream::default();
+        stream.direction = Direction::Input;
+        stream.params.rate = VIRTIO_SND_PCM_RATE_48000;
+        stream.params.format = VIRTIO_SND_PCM_FMT_S16;
+        stream.params.channels = 1;
+        stream.state = PCMState::SetParameters;
+        let streams = Arc::new(RwLock::new(vec![stream]));
+        let control = Arc::new(SndControl::default());
+        control.set_vr_audio(Some(VrAudio::anonymous(0)));
+        let vr = control.vr_audio().unwrap();
+        let backend =
+            CoreAudioBackend::with_deadlines(streams, control.clone(), CTL, STALL).unwrap();
+        vr.host_publish(HEADSET_SPEAKER | HEADSET_MIC);
+        vr.host_write_mic(48000, &[1000i16; 4000]); // 83 ms: cut to the 20 ms jitter buffer
+
+        backend.prepare(0).unwrap();
+        backend.start(0).unwrap();
+        assert!(vr.mic_active());
+        {
+            let hosts = backend.inner.hosts.lock().unwrap();
+            assert!(hosts[0].vr_mic.is_some());
+            assert!(!hosts[0].shared.starting.load(Ordering::Acquire), "no HAL unit");
+        }
+
+        // one guest period of 10 ms
+        let mem = GuestMemoryMmap::<()>::from_ranges(&[(GuestAddress(0), 0x1000)]).unwrap();
+        let interrupt =
+            InterruptTransport::new(DummyIrqChip::new().into(), "snd-test".into()).unwrap();
+        let message = Arc::new(IOMessage {
+            status: AtomicU32::new(VIRTIO_SND_S_OK),
+            used_len: 0.into(),
+            latency_bytes: 0.into(),
+            head_index: 0,
+            response_descriptor: Descriptor {
+                addr: 0x100,
+                len: 8,
+                flags: 0,
+                next: 0,
+            },
+            vring: Arc::new(Mutex::new(Vring {
+                mem,
+                queue: Queue::new(16),
+                interrupt,
+            })),
+        });
+        let queued = Instant::now();
+        backend.inner.streams.write().unwrap()[0]
+            .buffers
+            .push_back(Buffer::new(
+                Descriptor {
+                    addr: 0x200,
+                    len: 960,
+                    flags: 0,
+                    next: 0,
+                },
+                message.clone(),
+                Direction::Input,
+            ));
+        backend.read(0).unwrap();
+        wait_for("the capture period", Duration::from_millis(500), || {
+            completed(&message)
+        });
+        // paced by the clock (10 ms of audio take about 10 ms), not handed over at once
+        assert!(queued.elapsed() >= Duration::from_millis(4));
+        assert_eq!(message.status.load(Ordering::SeqCst), VIRTIO_SND_S_OK);
+        assert_eq!(message.latency_bytes.load(Ordering::Relaxed), 960 * 2);
+        let mut pcm = [0u8; 960];
+        {
+            use vm_memory::Bytes;
+            let vring = message.vring.lock().unwrap();
+            vring.mem.read_slice(&mut pcm, GuestAddress(0x200)).unwrap();
+        }
+        assert!(pcm
+            .chunks_exact(2)
+            .all(|b| (i16::from_le_bytes([b[0], b[1]]) - 1000).abs() <= 1));
+
+        // the headset goes away: the next START would record from the Mac again
+        // (checked under `hosts`, so the pump does not act on it and open the Mac microphone)
+        {
+            let hosts = backend.inner.hosts.lock().unwrap();
+            vr.host_publish(0);
+            assert!(hosts[0].vr_mic_source().is_none());
+            vr.host_publish(HEADSET_MIC);
+        }
+        backend.stop(0).unwrap();
+        assert!(!vr.mic_active());
+        assert!(backend.inner.hosts.lock().unwrap()[0].vr_mic.is_none());
+    }
