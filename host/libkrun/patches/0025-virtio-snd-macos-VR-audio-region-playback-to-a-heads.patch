+/* krun_snd_set_vr_audio flag: silence the Mac output while a headset plays the guest's audio. */
+#define KRUN_SND_VR_MUTE_LOCAL 1u
+
+/**
+ * Attaches a VR audio region: shared memory through which a VR host process plays the guest's
+ * audio on a headset and supplies the headset's microphone (two lock-free rings of S16 PCM;
+ * layout and protocol: steamac host/vrhost/include/vraudio.h). The embedder creates and
+ * initialises the region and hands the same fd to the VR host.
+ *
+ * Routing follows the headset, not the attachment. While the VR host reports a headset with a
+ * speaker, the guest's playback is also written to the region (the Mac output device stays the
+ * stream's clock; with KRUN_SND_VR_MUTE_LOCAL it gets silence). While it reports a headset with
+ * a microphone, the guest records from the region instead of the Mac microphone; a running
+ * capture stream switches over. When the headset disconnects, or the VR host stops updating the
+ * region for a second, the guest's audio is the Mac's again.
+ *
+ * Arguments:
+ *  "ctx_id" - the configuration context ID.
+ *  "fd"     - an mmap-able fd of a region initialised with vra_region_init(), or -1 to detach.
+ *             The fd is mapped, not consumed: the caller may close it after the call.
+ *  "flags"  - 0 or KRUN_SND_VR_MUTE_LOCAL.
+ *
+ * Returns -EINVAL also when the fd cannot be mapped or does not hold a VR audio region of the
+ * supported version.
+ */
+int32_t krun_snd_set_vr_audio(uint32_t ctx_id, int fd, uint32_t flags);
