+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn layout_matches_vraudio_h() {
+        assert_eq!(size_of::<RingHdr>(), 192);
+        assert_eq!(
+            size_of::<Region>(),
+            64 + 2 * 192 + 2 * (PLAY_FRAMES * 2 + MIC_FRAMES)
+        );
+        assert_eq!(std::mem::offset_of!(Region, headset), 12);
+        assert_eq!(std::mem::offset_of!(Region, beat), 16);
+        assert_eq!(std::mem::offset_of!(Region, play), 64);
+        assert_eq!(std::mem::offset_of!(RingHdr, read), 64);
+        assert_eq!(std::mem::offset_of!(RingHdr, rate), 128);
+        assert_eq!(std::mem::offset_of!(RingHdr, overruns), 144);
+        assert_eq!(REGION_BYTES, 65536);
+    }
+
+    #[test]
+    fn map_validates_the_region() {
+        let name = std::ffi::CString::new(format!("/krun-vra-{}", std::process::id())).unwrap();
+        // SAFETY: plain shm calls on a private name.
+        let fd = unsafe {
+            let fd = libc::shm_open(name.as_ptr(), libc::O_RDWR | libc::O_CREAT | libc::O_EXCL, 0o600);
+            libc::shm_unlink(name.as_ptr());
+            assert!(fd >= 0);
+            assert_eq!(libc::ftruncate(fd, REGION_BYTES as libc::off_t), 0);
+            fd
+        };
+        assert!(VrAudio::map(fd, 0).is_err(), "a zeroed region is refused");
+        // initialise through one mapping, attach through another (as steamac-vm and libkrun)
+        let init = VrAudio::from_base(
+            // SAFETY: as in map().
+            unsafe {
+                libc::mmap(
+                    ptr::null_mut(),
+                    REGION_BYTES,
+                    libc::PROT_READ | libc::PROT_WRITE,
+                    libc::MAP_SHARED,
+                    fd,
+                    0,
+                )
+            } as *mut Region,
+            0,
+        );
+        // SAFETY: freshly mapped.
+        unsafe {
+            let r = &mut *init.base;
+            r.magic = VRA_MAGIC;
+            r.version = VRA_VERSION;
+            r.size = size_of::<Region>() as u32;
+            r.play.channels = 2;
+            r.play.capacity = PLAY_FRAMES as u32;
+            r.mic.channels = 1;
+            r.mic.capacity = MIC_FRAMES as u32;
+        }
+        let vr = VrAudio::map(fd, VR_MUTE_LOCAL).unwrap();
+        assert!(vr.mute_local());
+        vr.set_mic_active(true);
+        assert!(init.mic_active(), "both mappings see the same memory");
+        // SAFETY: fd from shm_open.
+        unsafe { libc::close(fd) };
+    }
+
+    #[test]
+    fn play_ring_converts_and_wraps() {
+        let vr = VrAudio::anonymous(0);
+        let mut tmp = vec![0i16; 4096];
+        let mut f32s = Vec::new();
+        for i in 0..1000 {
+            let v = (i as f32 / 1000.0) * 2.0 - 1.0;
+            f32s.extend_from_slice(&v.to_le_bytes());
+            f32s.extend_from_slice(&(-v).to_le_bytes());
+        }
+        let mut dst = vec![0i16; 2000];
+        let mut total = 0;
+        for _ in 0..20 {
+            assert_eq!(vr.write_play_f32(44100, &f32s, &mut tmp), 1000);
+            assert_eq!(vr.host_read_play(&mut dst), 1000);
+            total += 1000;
+            assert_eq!(dst[0], -32767);
+            assert_eq!(dst[1], 32767);
+            assert_eq!(dst[1000], 0);
+        }
+        assert!(total > PLAY_FRAMES, "wrapped");
+        assert_eq!(vr.play_rate(), 44100);
+        // overrun: the free part only, the rest counted
+        for _ in 0..9 {
+            vr.write_play_f32(48000, &f32s, &mut tmp);
+        }
+        assert_eq!(vr.play_overruns(), 9000 - PLAY_FRAMES as u64);
+    }
+
+    #[test]
+    fn headset_needs_a_beating_host() {
+        let vr = VrAudio::anonymous(0);
+        let ms = 1_000_000u64;
+        assert_eq!(vr.headset(5 * ms), 0, "no host yet");
+        vr.host_publish(HEADSET_SPEAKER | HEADSET_MIC);
+        assert_eq!(vr.headset(10 * ms), HEADSET_SPEAKER | HEADSET_MIC);
+        assert_eq!(vr.headset(900 * ms), HEADSET_SPEAKER | HEADSET_MIC);
+        assert_eq!(vr.headset(1010 * ms), 0, "the host stopped beating");
+        vr.host_publish(HEADSET_SPEAKER);
+        assert_eq!(vr.headset(1020 * ms), HEADSET_SPEAKER);
+        vr.host_publish(0);
+        assert_eq!(vr.headset(1025 * ms), 0, "headset disconnected");
+    }
+
+    fn s16(out: &[u8]) -> Vec<i16> {
+        out.chunks_exact(2)
+            .map(|b| i16::from_le_bytes([b[0], b[1]]))
+            .collect()
+    }
+
+    #[test]
+    fn mic_is_paced_primed_and_converted() {
+        let vr = VrAudio::anonymous(0);
+        let ms = 1_000_000u64;
+        let mut mic = MicStream::new(VIRTIO_SND_PCM_FMT_S16, 48000, 2, 0);
+        let mut out = Vec::new();
+        // nothing from the headset yet: silence at the guest rate, paced by the clock
+        assert_eq!(mic.pull(&vr, 10 * ms, 10_000, &mut out), 480);
+        assert!(out.iter().all(|b| *b == 0));
+        assert_eq!(mic.pull(&vr, 10 * ms, 10_000, &mut out), 0, "nothing more is due");
+        // the headset delivers 30 ms of a constant: primed (20 ms), delivered as stereo
+        out.clear();
+        vr.host_write_mic(48000, &[1000i16; 1440]);
+        assert_eq!(mic.pull(&vr, 20 * ms, 10_000, &mut out), 480);
+        let v = s16(&out);
+        assert_eq!(v.len(), 960);
+        assert!(v.iter().all(|s| (*s - 1000).abs() <= 1), "{:?}", &v[..4]);
+        // late headset: 20 ms left, 30 ms due -> 10 ms of silence, counted
+        out.clear();
+        let n = mic.pull(&vr, 50 * ms, 10_000, &mut out);
+        assert_eq!(n, 1440);
+        let v = s16(&out);
+        assert!(v[..1920].iter().all(|s| (*s - 1000).abs() <= 1));
+        assert!(v[1920..].iter().all(|s| *s == 0));
+        assert_eq!(vr.mic_underruns(), 480);
+        // a backlog of 150 ms is cut to the 20 ms jitter buffer
+        out.clear();
+        vr.host_write_mic(48000, &[500i16; 7200]);
+        mic.pull(&vr, 51 * ms, 0, &mut out);
+        assert_eq!(mic.fifo.len(), 960);
+        // max_frames bounds what is delivered (the guest's free buffer space)
+        assert_eq!(mic.pull(&vr, 60 * ms, 100, &mut out), 100);
+        // a guest that took nothing for 2 s (paused VM) does not get the 2 s in a burst
+        out.clear();
+        assert_eq!(mic.pull(&vr, 2060 * ms, 100_000, &mut out), 960);
+    }
+
+    #[test]
+    fn mic_resamples_and_formats() {
+        // 44.1 kHz headset -> 48 kHz mono float guest: 1 s of a 440 Hz tone keeps its pitch
+        let vr = VrAudio::anonymous(0);
+        let tone: Vec<i16> = (0..44100)
+            .map(|k| (8000.0 * (2.0 * std::f64::consts::PI * 440.0 * k as f64 / 44100.0).sin()) as i16)
+            .collect();
+        let mut mic = MicStream::new(VIRTIO_SND_PCM_FMT_FLOAT, 48000, 1, 0);
+        let mut out = Vec::new();
+        let mut got = Vec::new();
+        for step in 1..=100u64 {
+            let k = (step as usize - 1) * 441;
+            vr.host_write_mic(44100, &tone[k..k + 441]);
+            out.clear();
+            mic.pull(&vr, step * 10_000_000, 100_000, &mut out);
+            got.extend(
+                out.chunks_exact(4)
+                    .map(|b| f32::from_le_bytes(b.try_into().unwrap())),
+            );
+        }
+        assert_eq!(got.len(), 48000);
+        let start = got.iter().position(|v| *v != 0.0).unwrap();
+        let mut rising = Vec::new();
+        for i in start + 1..got.len() {
+            if got[i - 1] < 0.0 && got[i] >= 0.0 {
+                rising.push(i);
+            }
+        }
+        let hz = (rising.len() - 1) as f64 * 48000.0
+            / (rising[rising.len() - 1] - rising[0]) as f64;
+        assert!((hz - 440.0).abs() < 2.0, "{hz}");
+        // U8 / S32 encodings
+        let mut b = Vec::new();
+        encode(VIRTIO_SND_PCM_FMT_U8, 0.0, &mut b);
+        encode(VIRTIO_SND_PCM_FMT_U8, -1.0, &mut b);
+        encode(VIRTIO_SND_PCM_FMT_S32, 1.0, &mut b);
+        assert_eq!(&b[..2], &[128, 1]);
+        assert_eq!(i32::from_le_bytes(b[2..6].try_into().unwrap()), i32::MAX);
+    }
+}
