+    /// Follow the VR region (krun_snd_set_vr_audio) and its headset: playback is copied to it
+    /// while a headset with a speaker is connected; a running capture stream moves between the
+    /// headset's microphone and the Mac's when one comes or goes.
+    fn follow_vr(&mut self) {
+        let attached = self.control.vr_audio();
+        if attached.is_none()
+            && self.vr.is_none()
+            && self.vr_mic.is_none()
+            && self.vr_retired.is_empty()
+        {
+            return;
+        }
+        // SAFETY: plain clock read.
+        let now = ticks_to_nanos(unsafe { mach_absolute_time() });
+        let headset = attached.as_ref().map_or(0, |vr| vr.headset(now));
+        let same = |a: &Option<Arc<VrAudio>>, b: Option<&Arc<VrAudio>>| match (a, b) {
+            (Some(a), Some(b)) => Arc::ptr_eq(a, b),
+            (None, None) => true,
+            _ => false,
+        };
+        match self.direction {
+            Direction::Output => {
+                let want = attached.filter(|_| headset & HEADSET_SPEAKER != 0);
+                let callbacks = self.shared.callbacks.load(Ordering::Acquire);
+                if !same(&want, self.vr.as_ref()) {
+                    let mute = want.as_ref().is_some_and(|vr| vr.mute_local());
+                    let raw = want
+                        .as_ref()
+                        .map_or(ptr::null_mut(), |vr| Arc::as_ptr(vr) as *mut VrAudio);
+                    self.shared.vr.store(raw, Ordering::Release);
+                    self.shared.vr_mute.store(mute, Ordering::Release);
+                    log::info!(
+                        "snd: stream {} {}",
+                        self.id,
+                        match (&want, mute) {
+                            (Some(_), true) => "plays on the VR headset",
+                            (Some(_), false) => "plays on the VR headset and the Mac",
+                            (None, _) => "no longer plays on the VR headset",
+                        }
+                    );
+                    if let Some(old) = std::mem::replace(&mut self.vr, want) {
+                        self.vr_retired.push((old, callbacks));
+                    }
+                }
+                if !self.vr_retired.is_empty() {
+                    let stopped =
+                        !self.unit_busy && self.slot.unit.as_ref().is_none_or(|u| !u.started);
+                    self.vr_retired.retain(|(_, at)| !stopped && callbacks == *at);
+                }
+            }
+            Direction::Input => {
+                let want = attached.filter(|_| headset & HEADSET_MIC != 0);
+                let current = self.vr_mic.as_ref().map(|(vr, _)| vr);
+                if same(&want, current)
+                    || !self.shared.running.load(Ordering::Acquire)
+                    || self.suspended
+                {
+                    return;
+                }
+                // start_capture() picks the source from the same state.
+                self.stop_unit();
+                self.shared.ring.clear();
+                if let Err(err) = self.start_unit() {
+                    log::error!("snd: stream {}: switching microphone: {err}", self.id);
+                }
+            }
         }
     }
 
+    /// Capture: the VR region to record from now, if a headset with a microphone is connected.
+    fn vr_mic_source(&self) -> Option<Arc<VrAudio>> {
+        let vr = self.control.vr_audio()?;
+        // SAFETY: plain clock read.
+        let now = ticks_to_nanos(unsafe { mach_absolute_time() });
+        (vr.headset(now) & HEADSET_MIC != 0).then_some(vr)
+    }
