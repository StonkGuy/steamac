+
+/// Wait until `ring` has been consumed up to `end` or a bounded deadline passes. Bounded by the
+/// guest's own buffer time (twice MAX_BUFFER_MS); callers must not hold the `hosts` mutex across
+/// this wait (see `CoreAudioBackend::release`).
+fn wait_played_out(ring: &Ring, end: u64) {
+    let deadline =
+        Instant::now() + Duration::from_millis(2 * SndControl::MAX_BUFFER_MS as u64 + 200);
+    while ring.consumed() < end && Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(2));
+    }
+}
+
+/// A HAL input unit with the capture callback installed.
+fn create_input_unit(refcon: *mut c_void) -> Result<Unit> {
+    let unit = Unit::new(kAudioUnitSubType_HALOutput)?;
+    unit.set(
+        kAudioOutputUnitProperty_EnableIO,
+        kAudioUnitScope_Input,
+        1,
+        &1u32,
+        "EnableIO(input)",
+    )?;
+    unit.set(
+        kAudioOutputUnitProperty_EnableIO,
+        kAudioUnitScope_Output,
+        0,
+        &0u32,
+        "EnableIO(output)",
+    )?;
+    let cb = AURenderCallbackStruct {
+        inputProc: render_input,
+        inputProcRefCon: refcon,
+    };
+    unit.set(
+        kAudioOutputUnitProperty_SetInputCallback,
+        kAudioUnitScope_Global,
+        0,
+        &cb,
+        "SetInputCallback",
+    )?;
+    Ok(unit)
+}
+
+/// Capture start worker: build, configure and start the microphone for `fmt` on the current
+/// default input device. Runs off the control-queue thread (and off `hosts`), so the guest's
+/// PCM_START can be acknowledged immediately. On success the running unit is published in
+/// `shared.capture`; `shared.running` was already set by `CoreAudioBackend::start`. On failure
+/// it logs once, clears `running` and leaves `shared.capture` empty, so the pump completes
+/// capture I/O with silence until the next START.
+fn capture_start_worker(shared: Arc<Shared>, fmt: Format, id: usize) {
+    let result = (|| -> Result<()> {
+        // A stop that arrived before this worker started must take down a unit that was
+        // still running when it did, and must not build a new one.
+        let stop_requested = shared.stop_pending.swap(false, Ordering::AcqRel);
+        let previous = if stop_requested {
+            shared.capture.lock().unwrap().take()
+        } else {
+            None
+        };
+        if let Some(mut previous) = previous {
+            // The stop runs off `hosts`, on this worker thread.
+            previous.unit.stop();
+        }
+        if stop_requested {
+            return Ok(());
+        }
+        let device: AudioObjectID = input_device()
+            .ok_or_else(|| Error::UnexpectedAudioBackendError("no input device".into()))?;
+        let rate: f64 = object_property(
+            device,
+            kAudioDevicePropertyNominalSampleRate,
+            kAudioObjectPropertyScopeGlobal,
+        )
+        .unwrap_or(48000.0);
+        let unit = create_input_unit(Arc::as_ptr(&shared) as *mut c_void)?;
+        unit.set(
+            kAudioOutputUnitProperty_CurrentDevice,
+            kAudioUnitScope_Global,
+            0,
+            &device,
+            "CurrentDevice(input)",
+        )?;
+        // The HAL unit does not resample input: take Float32 at the device rate and convert in
+        // the pump thread.
+        let dev_fmt = float_asbd(rate, fmt.channels);
+        unit.set(
+            kAudioUnitProperty_StreamFormat,
+            kAudioUnitScope_Output,
+            1,
+            &dev_fmt,
+            "StreamFormat(input)",
+        )?;
+        let mut conv = ptr::null_mut();
+        // SAFETY: valid formats and out pointer.
+        check(
+            unsafe { AudioConverterNew(&dev_fmt, &fmt.asbd(), &mut conv) },
+            "AudioConverterNew",
+        )?;
+        let mut unit = unit;
+        unit.initialize()?;
+        // Publish under the capture lock: a stop on the control thread either takes the
+        // published unit or, finding none while `starting` is set, leaves `stop_pending` for
+        // us to see here. The input callback needs the unit pointer, so it is set before the
+        // unit starts, not after.
+        let mut slot = shared.capture.lock().unwrap();
+        if shared.stop_pending.swap(false, Ordering::AcqRel) {
+            drop(slot);
+            return Ok(());
+        }
+        shared.capture_device.store(device, Ordering::Release);
+        let mut state = CaptureState {
+            unit,
+            converter: Converter {
+                conv,
+                in_frame_bytes: dev_fmt.mBytesPerFrame as usize,
+                staging: Vec::new(),
+            },
+        };
+        shared.unit.store(state.unit.au, Ordering::Release);
+        if let Err(err) = state.unit.start() {
+            shared.unit.store(ptr::null_mut(), Ordering::Release);
+            return Err(err);
+        }
+        *slot = Some(state);
+        Ok(())
+    })();
+    if let Err(err) = result {
+        log::error!("snd: stream {id}: cannot start the microphone ({err}); delivering silence");
+        shared.unit.store(ptr::null_mut(), Ordering::Release);
+        shared.running.store(false, Ordering::Release);
+    }
+    shared.starting.store(false, Ordering::Release);
+}
