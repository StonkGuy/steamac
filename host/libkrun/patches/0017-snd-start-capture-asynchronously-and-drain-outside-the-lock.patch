+    fn start_capture(&mut self) -> Result<()> {
+        let fmt = self
+            .guest_format
+            .ok_or(Error::UnexpectedAudioBackendConfiguration)?;
+        if self.control.paused() {
+            // Started by follow_pause() on resume.
+            self.suspended = true;
