+    /// A real guest descriptor, with no HAL device or recording needed by the test.
+    fn capture_fixture() -> (HostStream, RwLock<Vec<Stream>>, Arc<IOMessage>) {
+        let mut stream = Stream::default();
+        stream.direction = Direction::Input;
+        stream.state = PCMState::Start;
+        let fmt = Format {
+            format: VIRTIO_SND_PCM_FMT_U8,
+            rate: 48000,
+            channels: 1,
+        };
+        let mem = GuestMemoryMmap::<()>::from_ranges(&[(GuestAddress(0), 0x4000)]).unwrap();
+        let interrupt =
+            InterruptTransport::new(DummyIrqChip::new().into(), "capture-test".into()).unwrap();
+        let message = Arc::new(IOMessage {
+            status: AtomicU32::new(VIRTIO_SND_S_OK),
+            used_len: 0.into(),
+            latency_bytes: 0.into(),
+            head_index: 0,
+            response_descriptor: Descriptor {
+                addr: 0x100,
+                len: 8,
+                flags: 0,
+                next: 0,
+            },
+            vring: Arc::new(Mutex::new(Vring {
+                mem,
+                queue: Queue::new(16),
+                interrupt,
+            })),
+        });
+        // A 100 ms period. Its owner must retain it until capture has supplied 100 ms.
+        stream.buffers.push_back(Buffer::new(
+            Descriptor {
+                addr: 0x200,
+                len: 4800,
+                flags: 0,
+                next: 0,
+            },
+            message.clone(),
+            Direction::Input,
+        ));
+        let mut host = HostStream::new(
+            0,
+            Direction::Input,
+            Arc::new(Semaphore::new().unwrap()),
+            Arc::new(SndControl::default()),
+        );
+        host.guest_format = Some(fmt);
+        host.slot.format = Some(fmt);
+        (host, RwLock::new(vec![stream]), message)
+    }
+
+    #[test]
+    fn capture_does_not_complete_buffers_before_start_or_while_opening() {
+        let (mut host, streams, message) = capture_fixture();
+        host.pump_input(&mut None, &streams);
+        assert!(
+            !completed(&message),
+            "queued before START must not advance hw_ptr"
+        );
+        assert_eq!(streams.read().unwrap()[0].buffers[0].pos, 0);
+        host.shared.running.store(true, Ordering::Release);
+        host.shared.starting.store(true, Ordering::Release);
+        for _ in 0..20 {
+            host.pump_input(&mut None, &streams);
+        }
+        assert!(
+            !completed(&message),
+            "opening the microphone must not drain the guest ring"
+        );
+        assert_eq!(streams.read().unwrap()[0].buffers[0].pos, 0);
+        host.shared.running.store(false, Ordering::Release);
+        host.shared.starting.store(false, Ordering::Release);
+        host.pump_input(&mut None, &streams);
+        assert!(
+            !completed(&message),
+            "STOP must leave outstanding capture I/O alone"
+        );
+    }
+
+    #[test]
+    fn capture_without_a_device_paces_silence_and_uses_the_guest_format() {
+        let (mut host, streams, message) = capture_fixture();
+        host.shared.running.store(true, Ordering::Release);
+        // Put the clock in the future to make a zero-time budget deterministic.
+        host.capture_silence = Some((Instant::now() + Duration::from_secs(1), 0));
+        host.pump_input(&mut None, &streams);
+        assert!(
+            !completed(&message),
+            "silence is audio, not an instant buffer completion"
+        );
+        assert_eq!(host.next_completion(), Some(Duration::from_millis(1)));
+        // 100 ms is now due: one entire descriptor may complete, with U8 silence (128).
+        host.capture_silence = Some((Instant::now() - Duration::from_millis(100), 0));
+        host.pump_input(&mut None, &streams);
+        assert!(completed(&message));
+        let mut pcm = [0u8; 4800];
+        use vm_memory::Bytes;
+        message
+            .vring
+            .lock()
+            .unwrap()
+            .mem
+            .read_slice(&mut pcm, GuestAddress(0x200))
+            .unwrap();
+        assert!(pcm.iter().all(|&sample| sample == 128));
     }
 
