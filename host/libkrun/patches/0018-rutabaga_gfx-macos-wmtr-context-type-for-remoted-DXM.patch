+// SPDX-License-Identifier: Apache-2.0
+
+//! wmtr: a virtio-gpu context type that carries DXMT's winemetal unix calls from a guest process
+//! to a host executor (libwmtr_host.dylib, loaded at runtime) that runs them against Metal.
+//!
+//! Guest protocol (see wmtr_vgpu.h): blobs are VIRTGPU_BLOB_MEM_HOST3D with blob_id = wmtr blob
+//! number; this context backs each one with POSIX shared memory that is mapped both into the guest
+//! (by the VMM's existing SHM blob path) and into this process for the executor. EXECBUFFER carries
+//! 24-byte commands: RING (blob 0 is initialised: start the executor), KICK (wake it), WAIT (the
+//! fence of this EXECBUFFER completes when the reply slot or event queue reaches `seq`). Every WAIT
+//! of an EXECBUFFER applies to its fence; WAITs of an EXECBUFFER without a fence are dropped.
+//!
+//! Blob numbers are unique among live blobs. When the guest releases an arena blob, its
+//! CTX_DETACH_RESOURCE reaches `detach` before RESOURCE_UNREF closes the descriptor. Detach forgets
+//! the blob and replaces this context's shared-memory mapping with fresh anonymous memory, so the
+//! shm pages can be freed after the VMM unmaps and unrefs it. The old address range stays reserved
+//! until context teardown for executor pointers, and the released number can be created again.
+//! The client must release only idle arenas with no live ranges or host buffers. Blob 0 is the ring
+//! and is never released before the executor is destroyed.
+//!
+//! Each (context, ring) is an in-order timeline for libkrun and the guest: signalling a fence
+//! retires every earlier fence on its ring. Reply slots share rings (slot s waits on ring
+//! 1 + s % 62, events and slots >= 64 on ring 63, as the guest maps them), so fences on a ring
+//! are completed strictly in FIFO order: a fence whose condition already holds waits behind an
+//! earlier one that is still pending.
+//!
+//! The component only exists when STEAMAC_WMTR=1 and the library loads, so nothing changes for
+//! guests that never ask for the capset.
+
+use log::{error, info};
+use std::collections::BTreeMap;
+use std::collections::VecDeque;
+use std::ffi::c_void;
+use std::ffi::CString;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+
+use crate::rutabaga_core::RutabagaComponent;
+use crate::rutabaga_core::RutabagaContext;
+use crate::rutabaga_core::RutabagaResource;
+use crate::rutabaga_os::FromRawDescriptor;
+use crate::rutabaga_os::SafeDescriptor;
+use crate::rutabaga_utils::*;
+
+pub const RUTABAGA_CAPSET_WMTR: u32 = 30;
+
+const WMTR_VGPU_RING: u32 = 1;
+const WMTR_VGPU_KICK: u32 = 2;
+const WMTR_VGPU_WAIT: u32 = 3;
+const CMD_SIZE: usize = 24;
+/// Blob ids are wmtr blob numbers 0..MAX_BLOBS (0 is the ring); only live ids must be unique.
+const MAX_BLOBS: u64 = 1024;
+/// Largest blob, advertised to the guest as max_blob in the capset.
+const MAX_BLOB_SIZE: u64 = 4 << 30;
+
+/// Version of the interface between this context and the host library: the exported functions
+/// below and the layout of `WmtrHostOps`. The library reports its own from
+/// `wmtr_host_abi_version()`; any other value (or a library without it) is refused. Bump it on
+/// every change to either.
+const WMTR_HOST_ABI_VERSION: u32 = 1;
+
+/// Callbacks the context gives the executor (`struct wmtr_host_ops` in wmtr_host.h, ABI 1).
+///
+/// Contract for the library: callbacks may run on any executor or dispatch thread until
+/// `wmtr_host_destroy` returns, and never after; `wmtr_host_destroy` stops and joins everything
+/// that could call them. `wmtr_host_progress` must not call back into the ops, and `wake` must not
+/// be called while holding a lock that `wmtr_host_progress` takes (`wake` calls it). The ring in
+/// blob 0 and the `slot` passed to `wmtr_host_progress` come from the guest: the library checks
+/// both (any slot value, ring contents changing at any time).
+#[repr(C)]
+struct WmtrHostOps {
+    /// Host address and size of blob `blob` of this context, or null if it does not exist.
+    blob_ptr: extern "C" fn(*mut c_void, u32, *mut u64) -> *mut c_void,
+    /// A reply or event is published: re-check pending fences.
+    wake: extern "C" fn(*mut c_void, u32),
+}
+
+type HostAbiVersion = unsafe extern "C" fn() -> u32;
+type HostCreate = unsafe extern "C" fn(*mut c_void, *const WmtrHostOps, *mut c_void) -> *mut c_void;
+type HostVoid = unsafe extern "C" fn(*mut c_void);
+type HostProgress = unsafe extern "C" fn(*mut c_void, u32) -> u64;
+/// `wmtr_layout(ring_bytes, data_offset, slots_offset, slot_size)`: the ring layout in blob 0.
+type HostLayout = unsafe extern "C" fn(*mut u64, *mut u64, *mut u64, *mut u64);
+
+#[derive(Clone, Copy)]
+struct HostLib {
+    create: HostCreate,
+    kick: HostVoid,
+    destroy: HostVoid,
+    progress: HostProgress,
+    /// Smallest blob 0 the executor accepts (its ring layout, from `wmtr_layout`).
+    ring_bytes: u64,
+}
+
+unsafe impl Send for HostLib {}
+unsafe impl Sync for HostLib {}
+
+/// Binds the host API from `sym` (dlsym on the library `name`): every function must exist and
+/// the library's ABI version must be WMTR_HOST_ABI_VERSION.
+///
+/// # Safety
+/// Non-null results of `sym` must be the library's functions with the signatures above.
+unsafe fn bind_host_lib(name: &str, sym: impl Fn(&str) -> *mut c_void) -> Option<HostLib> {
+    let v = sym("wmtr_host_abi_version");
+    if v.is_null() {
+        error!("wmtr: {name} has no wmtr_host_abi_version (expected {WMTR_HOST_ABI_VERSION})");
+        return None;
+    }
+    let version = std::mem::transmute::<*mut c_void, HostAbiVersion>(v)();
+    if version != WMTR_HOST_ABI_VERSION {
+        error!("wmtr: {name} has host ABI {version}, expected {WMTR_HOST_ABI_VERSION}");
+        return None;
+    }
+    let (c, k, d, p, l) = (
+        sym("wmtr_host_create"),
+        sym("wmtr_host_kick"),
+        sym("wmtr_host_destroy"),
+        sym("wmtr_host_progress"),
+        sym("wmtr_layout"),
+    );
+    if c.is_null() || k.is_null() || d.is_null() || p.is_null() || l.is_null() {
+        error!("wmtr: {name} lacks the host API");
+        return None;
+    }
+    let (mut ring_bytes, mut data, mut slots, mut slot) = (0, 0, 0, 0);
+    std::mem::transmute::<*mut c_void, HostLayout>(l)(&mut ring_bytes, &mut data, &mut slots, &mut slot);
+    Some(HostLib {
+        ring_bytes,
+        create: std::mem::transmute::<*mut c_void, HostCreate>(c),
+        kick: std::mem::transmute::<*mut c_void, HostVoid>(k),
+        destroy: std::mem::transmute::<*mut c_void, HostVoid>(d),
+        progress: std::mem::transmute::<*mut c_void, HostProgress>(p),
+    })
+}
+
+fn load_host_lib() -> Option<HostLib> {
+    let name = std::env::var("STEAMAC_WMTR_LIB").unwrap_or_else(|_| "libwmtr_host.dylib".into());
+    let cname = CString::new(name.clone()).ok()?;
+    // SAFETY: dlopen/dlsym on the executor library; bind_host_lib checks every symbol and the
+    // ABI version before any other call.
+    unsafe {
+        let h = libc::dlopen(cname.as_ptr(), libc::RTLD_NOW | libc::RTLD_LOCAL);
+        if h.is_null() {
+            error!("wmtr: cannot load {name}");
+            return None;
+        }
+        let lib = bind_host_lib(&name, |s| {
+            let c = CString::new(s).unwrap();
+            libc::dlsym(h, c.as_ptr())
+        });
+        if lib.is_none() {
+            libc::dlclose(h);
+        }
+        lib
+    }
+}
+
+/// The host library, loaded once per process (the device's config space and the rutabaga builder
+/// must agree on whether the capset exists). None unless STEAMAC_WMTR=1 and the library loads.
+fn host_lib() -> Option<HostLib> {
+    if std::env::var("STEAMAC_WMTR").ok().as_deref() != Some("1") {
+        return None;
+    }
+    static LIB: OnceLock<Option<HostLib>> = OnceLock::new();
+    *LIB.get_or_init(load_host_lib)
+}
+
+/// Whether the wmtr capset is offered: the virtio-gpu device adds it to `num_capsets`.
+pub fn enabled() -> bool {
+    host_lib().is_some()
+}
+
+/// A fence on one ring's timeline; `wait` holds the (slot, seq) of every WAIT of its EXECBUFFER.
+struct Waiter {
+    fence: RutabagaFence,
+    wait: Vec<(u32, u64)>,
+}
+
+/// State shared with the executor's callbacks (which run on executor/dispatch threads).
+struct Shared {
+    lib: HostLib,
+    blobs: Mutex<BTreeMap<u32, (usize, u64)>>,
+    /// Fences not yet completed, per ring, in submission order.
+    waiters: Mutex<BTreeMap<u8, VecDeque<Waiter>>>,
+    host: Mutex<usize>,
+    fence_handler: RutabagaFenceHandler,
+}
+
+extern "C" fn cb_blob_ptr(ctx: *mut c_void, blob: u32, size: *mut u64) -> *mut c_void {
+    // SAFETY: ctx is the Shared the context keeps alive until the executor is destroyed.
+    let s = unsafe { &*(ctx as *const Shared) };
+    match s.blobs.lock().unwrap().get(&blob) {
+        Some(&(p, n)) => {
+            // SAFETY: size points to the caller's u64.
+            unsafe { *size = n };
+            p as *mut c_void
+        }
+        None => std::ptr::null_mut(),
+    }
+}
+
+extern "C" fn cb_wake(ctx: *mut c_void, _slot: u32) {
+    // SAFETY: as above.
+    let s = unsafe { &*(ctx as *const Shared) };
+    s.signal_ready();
+}
+
+impl Shared {
+    /// The executor's progress on `slot`, 0 once teardown has begun. The handle lock is held
+    /// across the call, so Drop cannot destroy the executor underneath it.
+    fn progress(&self, slot: u32) -> u64 {
+        let host = self.host.lock().unwrap();
+        if *host == 0 {
+            return 0;
+        }
+        // SAFETY: host is a live executor handle: Drop zeroes it under this lock before destroy.
+        unsafe { (self.lib.progress)(*host as *mut c_void, slot) }
+    }
+
+    /// Completes the fences at the head of `queue` whose condition holds, in order, stopping at
+    /// the first one that is still pending (later fences on the ring wait behind it).
+    fn complete_ready(&self, queue: &mut VecDeque<Waiter>) {
+        while let Some(w) = queue.front() {
+            if !w.wait.iter().all(|&(slot, seq)| self.progress(slot) >= seq) {
+                break;
+            }
+            let w = queue.pop_front().unwrap();
+            self.fence_handler.call(w.fence);
+        }
+    }
+
+    /// A reply arrived: any ring's head may now be ready (rings are shared between slots).
+    fn signal_ready(&self) {
+        let mut rings = self.waiters.lock().unwrap();
+        for queue in rings.values_mut() {
+            self.complete_ready(queue);
+        }
+    }
+}
+
+pub struct WmtrContext {
+    shared: Arc<Shared>,
+    ops: Box<WmtrHostOps>,
+    /// WAITs of the EXECBUFFER being submitted, for the fence created right after it.
+    pending: Vec<(u32, u64)>,
+    /// All address ranges this context mapped, including released blobs; unmapped on teardown.
+    maps: Vec<(usize, u64)>,
+    /// Resource id -> (blob number, address, size) for blobs the guest still holds.
+    resource_blobs: BTreeMap<u32, (u32, usize, u64)>,
+}
+
+// SAFETY: the raw pointers are only host addresses of mappings this context owns.
+unsafe impl Send for WmtrContext {}
+
+impl WmtrContext {
+    fn host(&self) -> *mut c_void {
+        *self.shared.host.lock().unwrap() as *mut c_void
+    }
+}
+
+impl RutabagaContext for WmtrContext {
+    fn context_create_blob(
+        &mut self,
+        resource_id: u32,
+        resource_create_blob: ResourceCreateBlob,
+        _handle_opt: Option<RutabagaHandle>,
+    ) -> RutabagaResult<RutabagaResource> {
+        // Checked before narrowing: blob_id is a u64 and 1 << 32 must not alias the ring (blob 0).
+        let id = resource_create_blob.blob_id;
+        let size = resource_create_blob.size;
+        if id >= MAX_BLOBS || size == 0 || size > MAX_BLOB_SIZE {
+            return Err(RutabagaError::SpecViolation("wmtr: bad blob"));
+        }
+        let blob = id as u32;
+        // A live id cannot be replaced: the executor may still use its mapping. Detach removes
+        // released arena blobs from this table, allowing the guest to reuse their numbers.
+        if self.shared.blobs.lock().unwrap().contains_key(&blob) {
+            return Err(RutabagaError::SpecViolation("wmtr: blob id in use"));
+        }
+        let name = CString::new(format!("/wmtr.{}.{}.{}", std::process::id(), resource_id, blob)).unwrap();
+        // SAFETY: plain POSIX shm calls; every result is checked.
+        let (fd, ptr) = unsafe {
+            let fd = libc::shm_open(name.as_ptr(), libc::O_RDWR | libc::O_CREAT | libc::O_EXCL, 0o600);
+            if fd < 0 {
+                return Err(RutabagaError::SpecViolation("wmtr: shm_open failed"));
+            }
+            libc::shm_unlink(name.as_ptr());
+            if libc::ftruncate(fd, size as libc::off_t) != 0 {
+                libc::close(fd);
+                return Err(RutabagaError::SpecViolation("wmtr: ftruncate failed"));
+            }
+            let p = libc::mmap(
+                std::ptr::null_mut(),
+                size as usize,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED,
+                fd,
+                0,
+            );
+            if p == libc::MAP_FAILED {
+                libc::close(fd);
+                return Err(RutabagaError::SpecViolation("wmtr: mmap failed"));
+            }
+            (fd, p as usize)
+        };
+        self.shared.blobs.lock().unwrap().insert(blob, (ptr, size));
+        self.maps.push((ptr, size));
+        self.resource_blobs.insert(resource_id, (blob, ptr, size));
+        // SAFETY: fd is a fresh descriptor we own.
+        let os_handle = unsafe { SafeDescriptor::from_raw_descriptor(fd) };
+        Ok(RutabagaResource {
+            resource_id,
+            handle: Some(Arc::new(RutabagaHandle {
+                os_handle,
+                handle_type: RUTABAGA_MEM_HANDLE_TYPE_SHM,
+            })),
+            blob: true,
+            blob_mem: resource_create_blob.blob_mem,
+            blob_flags: resource_create_blob.blob_flags,
+            map_info: Some(RUTABAGA_MAP_CACHE_CACHED | RUTABAGA_MAP_ACCESS_RW),
+            info_2d: None,
+            info_3d: None,
+            vulkan_info: None,
+            backing_iovecs: None,
+            component_mask: 1 << (RutabagaComponentType::Wmtr as u8),
+            size,
+            mapping: None,
+        })
+    }
+
+    fn submit_cmd(&mut self, commands: &mut [u8], _fence_ids: &[u64]) -> RutabagaResult<()> {
+        // libkrun creates an EXECBUFFER's fence right after submitting it, also when the submit
+        // failed: WAITs left from an EXECBUFFER without a fence, or from a refused one, must not
+        // hold that fence or a later one.
+        self.pending.clear();
+        if commands.len() % CMD_SIZE != 0 {
+            return Err(RutabagaError::SpecViolation("wmtr: partial command"));
+        }
+        let result = self.run_commands(commands);
+        if result.is_err() {
+            self.pending.clear();
+        }
+        result
+    }
+
+    fn attach(&mut self, _resource: &mut RutabagaResource) {}
+
+    /// CTX_DETACH_RESOURCE stops this context using a blob; RESOURCE_UNREF later drops the VMM's
+    /// mapping and descriptor but does not call the context. Forget idle arenas here, while keeping
+    /// the ring alive until executor teardown and keeping old executor addresses mapped.
+    fn detach(&mut self, resource: &RutabagaResource) {
+        let Some(&(blob, ptr, size)) = self.resource_blobs.get(&resource.resource_id) else {
+            return;
+        };
+        if blob == 0 {
+            return;
+        }
+        self.resource_blobs.remove(&resource.resource_id);
+        {
+            let mut blobs = self.shared.blobs.lock().unwrap();
+            if blobs.get(&blob) == Some(&(ptr, size)) {
+                blobs.remove(&blob);
+            }
+        }
+        // SAFETY: replaces this context's own mapping. The range remains reserved until Drop,
+        // so stale executor pointers see anonymous memory instead of an unmapped address.
+        let p = unsafe {
+            libc::mmap(
+                ptr as *mut c_void,
+                size as usize,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_FIXED | libc::MAP_ANON | libc::MAP_PRIVATE,
+                -1,
+                0,
+            )
+        };
+        if p == libc::MAP_FAILED {
+            error!("wmtr: cannot release blob {blob} ({size} bytes)");
+        }
+    }
+
+    fn context_create_fence(&mut self, fence: RutabagaFence) -> RutabagaResult<()> {
+        let wait = std::mem::take(&mut self.pending);
+        // Enqueue and check under the waiter lock: the executor publishes progress before it
+        // takes this lock in cb_wake, so a reply cannot slip between the push and the check.
+        let mut rings = self.shared.waiters.lock().unwrap();
+        let queue = rings.entry(fence.ring_idx).or_default();
+        queue.push_back(Waiter { fence, wait });
+        self.shared.complete_ready(queue);
+        Ok(())
+    }
+
+    fn component_type(&self) -> RutabagaComponentType {
+        RutabagaComponentType::Wmtr
+    }
+}
+
+impl WmtrContext {
+    fn run_commands(&mut self, commands: &[u8]) -> RutabagaResult<()> {
+        for c in commands.chunks_exact(CMD_SIZE) {
+            let ty = u32::from_le_bytes(c[0..4].try_into().unwrap());
+            let slot = u32::from_le_bytes(c[4..8].try_into().unwrap());
+            let seq = u64::from_le_bytes(c[8..16].try_into().unwrap());
+            match ty {
+                WMTR_VGPU_RING => {
+                    if !self.host().is_null() {
+                        return Err(RutabagaError::SpecViolation("wmtr: ring already started"));
+                    }
+                    let ring = match self.shared.blobs.lock().unwrap().get(&0) {
+                        Some(&(p, n)) if n >= self.shared.lib.ring_bytes => p,
+                        // the guest sizes blob 0; the executor reads and writes the ring at fixed
+                        // offsets up to its layout, so a shorter blob never reaches it
+                        Some(_) => return Err(RutabagaError::SpecViolation("wmtr: ring blob too small")),
+                        None => return Err(RutabagaError::SpecViolation("wmtr: no ring blob")),
+                    };
+                    let ctx = Arc::as_ptr(&self.shared) as *mut c_void;
+                    // SAFETY: ring is our mapping of blob 0; ops and ctx outlive the executor
+                    // (destroyed in Drop before they are freed).
+                    let h = unsafe { (self.shared.lib.create)(ring as *mut c_void, &*self.ops, ctx) };
+                    if h.is_null() {
+                        return Err(RutabagaError::SpecViolation("wmtr: executor start failed"));
+                    }
+                    *self.shared.host.lock().unwrap() = h as usize;
+                    // A reply published before the handle was stored read progress 0 in its
+                    // wake: re-check the fences queued so far.
+                    self.shared.signal_ready();
+                }
+                WMTR_VGPU_KICK => {
+                    let h = self.host();
+                    if !h.is_null() {
+                        // SAFETY: live executor.
+                        unsafe { (self.shared.lib.kick)(h) };
+                    }
+                }
+                WMTR_VGPU_WAIT => self.pending.push((slot, seq)),
+                _ => return Err(RutabagaError::SpecViolation("wmtr: unknown command")),
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Drop for WmtrContext {
+    fn drop(&mut self) {
+        // Retire the handle under the lock first: a wake from an executor or dispatch thread
+        // during destroy then sees 0 and never calls into the executor being freed.
+        let h = std::mem::take(&mut *self.shared.host.lock().unwrap()) as *mut c_void;
+        if !h.is_null() {
+            // SAFETY: live executor, no longer reachable through `shared`. Once destroy returns
+            // no callback runs (the WmtrHostOps contract), so `ops`, `shared` and the blob
+            // mappings can be released below.
+            unsafe { (self.shared.lib.destroy)(h) };
+        }
+        // complete anything still waiting (in ring order) so guest pollers do not hang
+        for queue in self.shared.waiters.lock().unwrap().values_mut() {
+            for w in queue.drain(..) {
+                self.shared.fence_handler.call(w.fence);
+            }
+        }
+        for &(p, n) in &self.maps {
+            // SAFETY: our own mappings.
+            unsafe { libc::munmap(p as *mut c_void, n as usize) };
+        }
+    }
+}
+
+pub struct Wmtr {
+    lib: HostLib,
+    fence_handler: RutabagaFenceHandler,
+}
+
+impl Wmtr {
+    /// Returns the component when STEAMAC_WMTR=1 and the host library loads.
+    pub fn init(fence_handler: RutabagaFenceHandler) -> Option<Box<dyn RutabagaComponent>> {
+        let lib = host_lib()?;
+        info!("wmtr: context type enabled (capset {RUTABAGA_CAPSET_WMTR})");
+        Some(Box::new(Wmtr { lib, fence_handler }))
+    }
+}
+
+impl RutabagaComponent for Wmtr {
+    fn get_capset_info(&self, _capset_id: u32) -> (u32, u32) {
+        (1, 16)
+    }
+
+    fn get_capset(&self, _capset_id: u32, _version: u32) -> Vec<u8> {
+        // struct wmtr_vgpu_caps { u32 version, page_size; u64 max_blob; }
+        let mut v = Vec::with_capacity(16);
+        v.extend_from_slice(&1u32.to_le_bytes());
+        v.extend_from_slice(&16384u32.to_le_bytes());
+        v.extend_from_slice(&MAX_BLOB_SIZE.to_le_bytes());
+        v
+    }
+
+    fn create_fence(&mut self, fence: RutabagaFence) -> RutabagaResult<()> {
+        self.fence_handler.call(fence);
+        Ok(())
+    }
+
+    fn create_context(
+        &self,
+        _ctx_id: u32,
+        _context_init: u32,
+        _context_name: Option<&str>,
+        fence_handler: RutabagaFenceHandler,
+    ) -> RutabagaResult<Box<dyn RutabagaContext>> {
+        Ok(Box::new(self.new_context(fence_handler)))
+    }
+}
+
+impl Wmtr {
+    fn new_context(&self, fence_handler: RutabagaFenceHandler) -> WmtrContext {
+        let ops = Box::new(WmtrHostOps {
+            blob_ptr: cb_blob_ptr,
+            wake: cb_wake,
+        });
+        WmtrContext {
+            shared: Arc::new(Shared {
+                lib: self.lib,
+                blobs: Mutex::new(BTreeMap::new()),
+                waiters: Mutex::new(BTreeMap::new()),
+                host: Mutex::new(0),
+                fence_handler,
+            }),
+            ops,
+            pending: Vec::new(),
+            maps: Vec::new(),
+            resource_blobs: BTreeMap::new(),
+        }
+    }
+}
