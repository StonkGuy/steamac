+#[cfg(test)]
+mod tests {
+    //! The context against a stand-in executor (no Metal, no host library): blob 0 backs the ring,
+    //! RING starts the executor, a WAIT fence completes exactly when the executor reports progress.
+    use super::*;
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    struct Fake {
+        ops: *const WmtrHostOps,
+        ctx: *mut c_void,
+        ring: *mut c_void,
+    }
+    unsafe impl Send for Fake {}
+    static FAKE: Mutex<Option<Fake>> = Mutex::new(None);
+    /// done_seq per reply slot (0..64) and the event queue (64)
+    static PROGRESS: [AtomicU64; 65] = [const { AtomicU64::new(0) }; 65];
+    static KICKS: AtomicU64 = AtomicU64::new(0);
+    /// set while the stand-in destroy runs; progress calls during it are counted in LATE
+    static DESTROYING: AtomicU64 = AtomicU64::new(0);
+    static LATE: AtomicU64 = AtomicU64::new(0);
+    const SLOT: u32 = 5;
+    /// The stand-in executor is process-global: tests that start it run one at a time.
+    static SERIAL: Mutex<()> = Mutex::new(());
+
+    fn serial() -> std::sync::MutexGuard<'static, ()> {
+        let g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+        for p in &PROGRESS {
+            p.store(0, Ordering::SeqCst);
+        }
+        KICKS.store(0, Ordering::SeqCst);
+        LATE.store(0, Ordering::SeqCst);
+        g
+    }
+
+    /// The executor finishes the next call on `slot`: publish progress, then wake (its order).
+    fn reply(slot: u32) {
+        let (ops, ctx) = {
+            let f = FAKE.lock().unwrap();
+            let f = f.as_ref().unwrap();
+            (f.ops, f.ctx)
+        };
+        PROGRESS[slot as usize].fetch_add(1, Ordering::SeqCst);
+        // SAFETY: ops/ctx are the live context's, as for the real executor.
+        unsafe { ((*ops).wake)(ctx, slot) };
+    }
+
+    unsafe extern "C" fn create(ring: *mut c_void, ops: *const WmtrHostOps, ctx: *mut c_void) -> *mut c_void {
+        *FAKE.lock().unwrap() = Some(Fake { ops, ctx, ring });
+        ring
+    }
+    /// One kick = one reply on SLOT: publish progress, then wake (the real executor's order).
+    unsafe extern "C" fn kick(_h: *mut c_void) {
+        KICKS.fetch_add(1, Ordering::SeqCst);
+        reply(SLOT);
+    }
+    /// A dispatch thread still delivers a wake while the executor is being destroyed.
+    unsafe extern "C" fn destroy(_h: *mut c_void) {
+        DESTROYING.store(1, Ordering::SeqCst);
+        let f = FAKE.lock().unwrap().take();
+        if let Some(f) = f {
+            ((*f.ops).wake)(f.ctx, SLOT);
+        }
+        DESTROYING.store(0, Ordering::SeqCst);
+    }
+    unsafe extern "C" fn progress(_h: *mut c_void, slot: u32) -> u64 {
+        if DESTROYING.load(Ordering::SeqCst) != 0 {
+            LATE.fetch_add(1, Ordering::SeqCst);
+        }
+        PROGRESS.get(slot as usize).map_or(0, |p| p.load(Ordering::SeqCst))
+    }
+
+    fn component(done: Arc<Mutex<Vec<u64>>>) -> (Wmtr, RutabagaFenceHandler) {
+        let handler = RutabagaFenceHandler::new(move |f: RutabagaFence| done.lock().unwrap().push(f.fence_id));
+        let lib = HostLib {
+            create,
+            kick,
+            destroy,
+            progress,
+            ring_bytes: 65536,
+        };
+        (Wmtr { lib, fence_handler: handler.clone() }, handler)
+    }
+
+    fn cmd(ty: u32, slot: u32, seq: u64) -> Vec<u8> {
+        let mut v = Vec::with_capacity(CMD_SIZE);
+        v.extend_from_slice(&ty.to_le_bytes());
+        v.extend_from_slice(&slot.to_le_bytes());
+        v.extend_from_slice(&seq.to_le_bytes());
+        v.extend_from_slice(&0u64.to_le_bytes());
+        v
+    }
+
+    fn blob(id: u64, size: u64) -> ResourceCreateBlob {
+        ResourceCreateBlob { blob_mem: 2, blob_flags: 3, blob_id: id, size }
+    }
+
+    fn fence(id: u64, ring_idx: u8) -> RutabagaFence {
+        RutabagaFence { flags: RUTABAGA_FLAG_INFO_RING_IDX, fence_id: id, ctx_id: 1, ring_idx }
+    }
+
+    #[test]
+    fn off_unless_enabled() {
+        std::env::remove_var("STEAMAC_WMTR");
+        assert!(!enabled());
+        assert!(Wmtr::init(RutabagaFenceHandler::new(|_| {})).is_none());
+    }
+
+    #[test]
+    fn wait_fence_completes_on_reply() {
+        let _serial = serial();
+        let done = Arc::new(Mutex::new(Vec::new()));
+        let (comp, handler) = component(done.clone());
+        assert_eq!(comp.get_capset(RUTABAGA_CAPSET_WMTR, 1).len(), 16);
+        let mut ctx = comp.create_context(1, RUTABAGA_CAPSET_WMTR, None, handler).unwrap();
+
+        // the ring blob is shared memory the guest maps through the SHM handle
+        let res = ctx.context_create_blob(1, blob(0, 65536), None).unwrap();
+        let handle = res.handle.as_ref().unwrap();
+        assert_eq!(handle.handle_type, RUTABAGA_MEM_HANDLE_TYPE_SHM);
+        assert_eq!(res.size, 65536);
+
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_RING, 0, 0), &[]).unwrap();
+        assert!(FAKE.lock().unwrap().as_ref().is_some_and(|f| !f.ring.is_null()));
+
+        // WAIT slot 5 seq 1 (ring 6) before any reply: the fence stays pending
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_WAIT, SLOT, 1), &[]).unwrap();
+        ctx.context_create_fence(fence(77, 6)).unwrap();
+        assert!(done.lock().unwrap().is_empty(), "fence completed before the reply");
+
+        // the reply completes it
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_KICK, 0, 0), &[]).unwrap();
+        assert_eq!(*done.lock().unwrap(), vec![77]);
+
+        // a WAIT already satisfied completes at once
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_WAIT, SLOT, 1), &[]).unwrap();
+        ctx.context_create_fence(fence(78, 6)).unwrap();
+        // a fence on a ring without a WAIT completes at once
+        ctx.context_create_fence(fence(79, 0)).unwrap();
+        assert_eq!(*done.lock().unwrap(), vec![77, 78, 79]);
+
+        // a WAIT that never gets its reply is completed when the context goes away
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_WAIT, SLOT, 100), &[]).unwrap();
+        ctx.context_create_fence(fence(80, 6)).unwrap();
+        assert_eq!(done.lock().unwrap().len(), 3);
+        drop(ctx);
+        assert_eq!(*done.lock().unwrap(), vec![77, 78, 79, 80]);
+        assert!(FAKE.lock().unwrap().is_none(), "executor not destroyed");
+        assert_eq!(KICKS.load(Ordering::SeqCst), 1);
+    }
+
+    #[test]
+    fn rejects_malformed_requests() {
+        let (comp, handler) = component(Arc::new(Mutex::new(Vec::new())));
+        let mut ctx = comp.create_context(2, RUTABAGA_CAPSET_WMTR, None, handler).unwrap();
+        assert!(ctx.context_create_blob(1, blob(0, 0), None).is_err());
+        assert!(ctx.context_create_blob(1, blob(1024, 4096), None).is_err());
+        assert!(ctx.context_create_blob(1, blob(1, MAX_BLOB_SIZE + 1), None).is_err());
+        // RING before blob 0 exists, then an unknown command
+        assert!(ctx.submit_cmd(&mut cmd(WMTR_VGPU_RING, 0, 0), &[]).is_err());
+        assert!(ctx.submit_cmd(&mut cmd(9, 0, 0), &[]).is_err());
+        // KICK without an executor is ignored
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_KICK, 0, 0), &[]).unwrap();
+        // a command cut short is refused, not silently dropped
+        let mut partial = cmd(WMTR_VGPU_KICK, 0, 0);
+        partial.extend_from_slice(&[0; 8]);
+        assert!(ctx.submit_cmd(&mut partial, &[]).is_err());
+    }
+
+    unsafe extern "C" fn layout(ring: *mut u64, data: *mut u64, slots: *mut u64, slot: *mut u64) {
+        (*ring, *data, *slots, *slot) = (65536, 4096, 32768, 512);
+    }
+
+    unsafe extern "C" fn abi_current() -> u32 {
+        WMTR_HOST_ABI_VERSION
+    }
+    unsafe extern "C" fn abi_next() -> u32 {
+        WMTR_HOST_ABI_VERSION + 1
+    }
+
+    /// Teardown retires the executor handle before destroying it: a wake that arrives during
+    /// wmtr_host_destroy must not reach wmtr_host_progress with the handle being freed.
+    #[test]
+    fn teardown_retires_handle_before_destroy() {
+        let _serial = serial();
+        let done = Arc::new(Mutex::new(Vec::new()));
+        let (comp, handler) = component(done.clone());
+        let mut ctx = comp.create_context(4, RUTABAGA_CAPSET_WMTR, None, handler).unwrap();
+        ctx.context_create_blob(1, blob(0, 65536), None).unwrap();
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_RING, 0, 0), &[]).unwrap();
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_WAIT, SLOT, 1), &[]).unwrap();
+        ctx.context_create_fence(fence(40, 6)).unwrap();
+        assert!(done.lock().unwrap().is_empty());
+        drop(ctx);
+        assert_eq!(LATE.load(Ordering::SeqCst), 0, "progress called during destroy");
+        assert!(FAKE.lock().unwrap().is_none(), "executor not destroyed");
+        assert_eq!(*done.lock().unwrap(), vec![40]);
+    }
+
+    /// The library is used only if it reports this ABI version and exports the whole API.
+    #[test]
+    fn host_lib_abi_version_checked() {
+        let table = |abi: Option<HostAbiVersion>, with_progress: bool, with_layout: bool| {
+            move |s: &str| -> *mut c_void {
+                match s {
+                    "wmtr_host_abi_version" => abi.map_or(std::ptr::null_mut(), |f| f as *mut c_void),
+                    "wmtr_host_create" => create as *mut c_void,
+                    "wmtr_host_kick" => kick as *mut c_void,
+                    "wmtr_host_destroy" => destroy as *mut c_void,
+                    "wmtr_host_progress" if with_progress => progress as *mut c_void,
+                    "wmtr_layout" if with_layout => layout as *mut c_void,
+                    _ => std::ptr::null_mut(),
+                }
+            }
+        };
+        // SAFETY: the table holds this module's stand-in functions with the right signatures.
+        unsafe {
+            let lib = bind_host_lib("test", table(Some(abi_current), true, true));
+            assert_eq!(lib.map(|l| l.ring_bytes), Some(65536));
+            assert!(bind_host_lib("test", table(None, true, true)).is_none(), "unversioned library");
+            assert!(bind_host_lib("test", table(Some(abi_next), true, true)).is_none(), "other ABI");
+            assert!(bind_host_lib("test", table(Some(abi_current), false, true)).is_none(), "partial API");
+            assert!(bind_host_lib("test", table(Some(abi_current), true, false)).is_none(), "no ring layout");
+        }
+        // the ops struct carries exactly the two callbacks of ABI 1
+        assert_eq!(std::mem::size_of::<WmtrHostOps>(), 2 * std::mem::size_of::<usize>());
+    }
+
+    /// Live blob ids are unique and only below MAX_BLOBS: a duplicate or one that truncates to
+    /// a smaller u32 (1 << 32 would alias the ring) is rejected and leaves the existing blob alone.
+    #[test]
+    fn blob_ids_are_unique_and_in_range() {
+        // resource ids differ from the other tests' (shm names are per pid/resource/blob)
+        let (comp, handler) = component(Arc::new(Mutex::new(Vec::new())));
+        let mut ctx = comp.new_context(handler);
+        ctx.context_create_blob(11, blob(0, 65536), None).unwrap();
+        let ring = ctx.shared.blobs.lock().unwrap()[&0];
+        assert!(ctx.context_create_blob(12, blob(0, 65536), None).is_err());
+        assert!(ctx.context_create_blob(13, blob(1 << 32, 4096), None).is_err());
+        assert!(ctx.context_create_blob(14, blob(u64::MAX, 4096), None).is_err());
+        assert_eq!(ctx.shared.blobs.lock().unwrap()[&0], ring);
+        assert_eq!(ctx.maps.len(), 1);
+        // the last valid id works; the guest is told the size limit
+        ctx.context_create_blob(15, blob(MAX_BLOBS - 1, 4096), None).unwrap();
+        let caps = comp.get_capset(RUTABAGA_CAPSET_WMTR, 1);
+        assert_eq!(u64::from_le_bytes(caps[8..16].try_into().unwrap()), MAX_BLOB_SIZE);
+    }
+
+    fn footprint() -> u64 {
+        // SAFETY: an all-zero rusage_info_v2 is a valid out-parameter.
+        let mut usage: libc::rusage_info_v2 = unsafe { std::mem::zeroed() };
+        // SAFETY: usage has the type and size written by RUSAGE_INFO_V2.
+        let rc = unsafe {
+            libc::proc_pid_rusage(
+                std::process::id() as i32,
+                libc::RUSAGE_INFO_V2,
+                &mut usage as *mut _ as *mut libc::rusage_info_t,
+            )
+        };
+        assert_eq!(rc, 0);
+        usage.ri_phys_footprint
+    }
+
+    fn resolve(ctx: &WmtrContext, blob: u32) -> (*mut u8, u64) {
+        let mut size = 0;
+        let ptr = cb_blob_ptr(Arc::as_ptr(&ctx.shared) as *mut c_void, blob, &mut size);
+        (ptr as *mut u8, size)
+    }
+
+    /// Detach removes the executor's mapping of the shm object; unref drops the last descriptor.
+    /// The physical pages must then leave the footprint, without waiting for context teardown.
+    #[test]
+    fn detach_releases_the_blob_memory() {
+        let _serial = serial();
+        let (comp, handler) = component(Arc::new(Mutex::new(Vec::new())));
+        let mut ctx = comp.new_context(handler);
+        let size = 64 << 20;
+        let resource = ctx.context_create_blob(81, blob(3, size), None).unwrap();
+        let (ptr, bytes) = resolve(&ctx, 3);
+        assert!(!ptr.is_null());
+        assert_eq!(bytes, size);
+        // SAFETY: ptr is the context's writable mapping of size bytes.
+        unsafe { std::ptr::write_bytes(ptr, 0x5a, size as usize) };
+        let before = footprint();
+        ctx.detach(&resource);
+        drop(resource); // the VMM's unref closes its descriptor
+        let after = footprint();
+        assert!(
+            before >= after + size * 9 / 10,
+            "footprint {} -> {} MiB after releasing a {} MiB blob",
+            before >> 20,
+            after >> 20,
+            size >> 20
+        );
+    }
+
+    /// Stale executor addresses remain readable and writable, but resolve no longer finds the blob.
+    #[test]
+    fn detach_stops_resolving_and_reserves_address() {
+        let (comp, handler) = component(Arc::new(Mutex::new(Vec::new())));
+        let mut ctx = comp.new_context(handler);
+        let resource = ctx.context_create_blob(82, blob(4, 16384), None).unwrap();
+        let (ptr, size) = resolve(&ctx, 4);
+        // SAFETY: ptr is our writable mapping of size bytes.
+        unsafe { std::ptr::write_bytes(ptr, 0x5a, size as usize) };
+        ctx.detach(&resource);
+        assert!(resolve(&ctx, 4).0.is_null(), "released blob still resolves");
+        assert_eq!(ctx.maps, vec![(ptr as usize, size)], "address range must stay reserved");
+        // SAFETY: detach keeps the range mapped as fresh anonymous memory until context teardown.
+        unsafe {
+            assert!(std::slice::from_raw_parts(ptr, size as usize).iter().all(|&b| b == 0));
+            ptr.write_volatile(0xa5);
+            assert_eq!(ptr.read_volatile(), 0xa5);
+        }
+        ctx.detach(&resource); // repeated detach is harmless
+    }
+
+    #[test]
+    fn released_blob_number_can_be_created_again() {
+        let (comp, handler) = component(Arc::new(Mutex::new(Vec::new())));
+        let mut ctx = comp.new_context(handler);
+        let resource = ctx.context_create_blob(83, blob(5, 16384), None).unwrap();
+        let old = resolve(&ctx, 5);
+        ctx.detach(&resource);
+        drop(resource);
+        let again = ctx.context_create_blob(84, blob(5, 32768), None).unwrap();
+        let current = resolve(&ctx, 5);
+        assert!(!current.0.is_null());
+        assert_ne!(current.0, old.0, "old range must stay reserved");
+        assert_eq!(current.1, 32768);
+        assert!(ctx.context_create_blob(85, blob(5, 16384), None).is_err(), "live duplicate");
+        ctx.detach(&again);
+        assert!(resolve(&ctx, 5).0.is_null());
+    }
+
+    #[test]
+    fn ring_survives_detach() {
+        let _serial = serial();
+        let (comp, handler) = component(Arc::new(Mutex::new(Vec::new())));
+        let mut ctx = comp.new_context(handler);
+        let ring = ctx.context_create_blob(86, blob(0, 65536), None).unwrap();
+        let original = resolve(&ctx, 0);
+        // SAFETY: blob 0 is a writable mapping of 65536 bytes.
+        unsafe { original.0.write_volatile(0x5a) };
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_RING, 0, 0), &[]).unwrap();
+        ctx.detach(&ring);
+        drop(ring);
+        assert_eq!(resolve(&ctx, 0), original);
+        // SAFETY: the ring mapping survives detach and unref until the executor is destroyed.
+        unsafe { assert_eq!(original.0.read_volatile(), 0x5a) };
+        assert!(ctx.context_create_blob(87, blob(0, 65536), None).is_err());
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_KICK, 0, 0), &[]).unwrap();
+        assert_eq!(KICKS.load(Ordering::SeqCst), 1);
+        drop(ctx);
+        assert!(FAKE.lock().unwrap().is_none());
+    }
+
+    /// RING on a blob 0 smaller than the executor's ring layout is refused before the executor is
+    /// created: it reads and writes the ring at fixed offsets up to that size.
+    #[test]
+    fn short_ring_is_refused() {
+        let _serial = serial();
+        let (comp, handler) = component(Arc::new(Mutex::new(Vec::new())));
+        let mut ctx = comp.create_context(5, RUTABAGA_CAPSET_WMTR, None, handler).unwrap();
+        ctx.context_create_blob(51, blob(0, 16384), None).unwrap();
+        assert!(ctx.submit_cmd(&mut cmd(WMTR_VGPU_RING, 0, 0), &[]).is_err());
+        assert!(FAKE.lock().unwrap().is_none(), "executor started on a short ring");
+        drop(ctx);
+    }
+
+    /// Slots 0 and 62 share ring 1. A ring is an in-order timeline, so a satisfied WAIT (and a
+    /// fence without one) must not complete ahead of an earlier fence that is still pending:
+    /// signalling it would retire the pending one before its reply exists.
+    #[test]
+    fn shared_ring_completes_in_order() {
+        let _serial = serial();
+        let done = Arc::new(Mutex::new(Vec::new()));
+        let (comp, handler) = component(done.clone());
+        let mut ctx = comp.create_context(3, RUTABAGA_CAPSET_WMTR, None, handler).unwrap();
+        ctx.context_create_blob(1, blob(0, 65536), None).unwrap();
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_RING, 0, 0), &[]).unwrap();
+
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_WAIT, 0, 1), &[]).unwrap();
+        ctx.context_create_fence(fence(10, 1)).unwrap();
+        // slot 62 seq 0 already holds, but ring 1 still has fence 10 pending
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_WAIT, 62, 0), &[]).unwrap();
+        ctx.context_create_fence(fence(11, 1)).unwrap();
+        ctx.context_create_fence(fence(12, 1)).unwrap();
+        // the event queue and slots >= 64 share ring 63 the same way
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_WAIT, 64, 1), &[]).unwrap();
+        ctx.context_create_fence(fence(20, 63)).unwrap();
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_WAIT, 70, 0), &[]).unwrap();
+        ctx.context_create_fence(fence(21, 63)).unwrap();
+        // another ring is independent
+        ctx.context_create_fence(fence(30, 2)).unwrap();
+        assert_eq!(*done.lock().unwrap(), vec![30]);
+
+        // a reply on another slot of the ring changes nothing
+        reply(62);
+        assert_eq!(*done.lock().unwrap(), vec![30]);
+        reply(0);
+        assert_eq!(*done.lock().unwrap(), vec![30, 10, 11, 12]);
+        reply(64);
+        assert_eq!(*done.lock().unwrap(), vec![30, 10, 11, 12, 20, 21]);
+        drop(ctx);
+    }
+
+    /// Every WAIT of an EXECBUFFER holds its fence (slots 0 and 62 both map to ring 1): the second
+    /// must not replace the first, or the fence completes before slot 0 has replied.
+    #[test]
+    fn all_waits_of_an_execbuffer_hold_its_fence() {
+        let _serial = serial();
+        let done = Arc::new(Mutex::new(Vec::new()));
+        let (comp, handler) = component(done.clone());
+        let mut ctx = comp.create_context(6, RUTABAGA_CAPSET_WMTR, None, handler).unwrap();
+        ctx.context_create_blob(1, blob(0, 65536), None).unwrap();
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_RING, 0, 0), &[]).unwrap();
+
+        let mut both = cmd(WMTR_VGPU_WAIT, 0, 1);
+        both.extend(cmd(WMTR_VGPU_WAIT, 62, 1));
+        ctx.submit_cmd(&mut both, &[]).unwrap();
+        ctx.context_create_fence(fence(60, 1)).unwrap();
+        reply(62);
+        assert!(done.lock().unwrap().is_empty(), "fence completed before slot 0 replied");
+        reply(0);
+        assert_eq!(*done.lock().unwrap(), vec![60]);
+        drop(ctx);
+    }
+
+    /// WAITs belong to the fence of their own EXECBUFFER: those of an EXECBUFFER without a fence,
+    /// or of one that was refused (libkrun still creates its fence), hold no later fence.
+    #[test]
+    fn waits_do_not_outlive_their_execbuffer() {
+        let _serial = serial();
+        let done = Arc::new(Mutex::new(Vec::new()));
+        let (comp, handler) = component(done.clone());
+        let mut ctx = comp.create_context(7, RUTABAGA_CAPSET_WMTR, None, handler).unwrap();
+        ctx.context_create_blob(1, blob(0, 65536), None).unwrap();
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_RING, 0, 0), &[]).unwrap();
+
+        // no fence for this one
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_WAIT, SLOT, 100), &[]).unwrap();
+        ctx.submit_cmd(&mut Vec::new(), &[]).unwrap();
+        ctx.context_create_fence(fence(70, 6)).unwrap();
+        // refused after its WAIT
+        let mut refused = cmd(WMTR_VGPU_WAIT, SLOT, 100);
+        refused.extend(cmd(9, 0, 0));
+        assert!(ctx.submit_cmd(&mut refused, &[]).is_err());
+        ctx.context_create_fence(fence(71, 6)).unwrap();
+        assert_eq!(*done.lock().unwrap(), vec![70, 71]);
+        drop(ctx);
+    }
+
+    /// The executor replies from inside wmtr_host_create, before the context has stored its
+    /// handle (so that wake reads progress 0).
+    unsafe extern "C" fn create_replying(ring: *mut c_void, ops: *const WmtrHostOps, ctx: *mut c_void) -> *mut c_void {
+        *FAKE.lock().unwrap() = Some(Fake { ops, ctx, ring });
+        reply(SLOT);
+        ring
+    }
+
+    /// A reply that arrives while RING is still storing the executor handle is not lost: the
+    /// fence waiting for it completes when RING returns, not at the next wake.
+    #[test]
+    fn reply_during_executor_start_is_not_lost() {
+        let _serial = serial();
+        let done = Arc::new(Mutex::new(Vec::new()));
+        let (mut comp, handler) = component(done.clone());
+        comp.lib.create = create_replying;
+        let mut ctx = comp.create_context(8, RUTABAGA_CAPSET_WMTR, None, handler).unwrap();
+        ctx.context_create_blob(1, blob(0, 65536), None).unwrap();
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_WAIT, SLOT, 1), &[]).unwrap();
+        ctx.context_create_fence(fence(90, 6)).unwrap();
+        ctx.submit_cmd(&mut cmd(WMTR_VGPU_RING, 0, 0), &[]).unwrap();
+        assert_eq!(*done.lock().unwrap(), vec![90]);
+        drop(ctx);
+    }
+}
