+    #[test]
+    fn test_frame_damage_owes_every_buffer_the_flushed_rect() {
+        use super::{DamageRect, FrameDamage};
+
+        let rect = |x0: u32, y0: u32, x1: u32, y1: u32| DamageRect { x0, y0, x1, y1 };
+        let whole = rect(0, 0, 8, 8);
+
+        // The buffer a flush lands in is the backend's choice and rotates. The guest
+        // changed the resource over the flushed rect, and that change is in no buffer
+        // yet, so every buffer owes it; the one being written owes what it missed too.
+        let mut damage = FrameDamage::default();
+        // A slot never written is unknown everywhere: the whole scanout.
+        assert_eq!(damage.for_flush(0, 0, Some(rect(0, 0, 1, 1)), whole), Some(whole));
+        // The flush into buffer 1 leaves buffer 0 owing the rect it skipped.
+        assert_eq!(damage.for_flush(0, 1, Some(rect(4, 4, 6, 8)), whole), Some(whole));
+        // Buffer 0 is written now: it owes what it missed, plus its own rect.
+        assert_eq!(
+            damage.for_flush(0, 0, Some(rect(1, 1, 2, 2)), whole),
+            Some(rect(1, 1, 6, 8))
+        );
+        // Another fresh slot: the whole scanout again.
+        assert_eq!(damage.for_flush(0, 2, Some(rect(3, 3, 4, 4)), whole), Some(whole));
+        // It is current now, so it owes only its own rect.
+        assert_eq!(
+            damage.for_flush(0, 2, Some(rect(0, 0, 1, 1)), whole),
+            Some(rect(0, 0, 1, 1))
+        );
+
+        // An unchecked flush fills the target whole and leaves every other buffer
+        // owing the whole scanout (nothing can be narrowed to).
+        assert_eq!(damage.for_flush(0, 1, None, whole), None);
+        assert_eq!(damage.for_flush(0, 0, Some(rect(3, 3, 4, 4)), whole), Some(whole));
+
+        // A reconfigure discards the damage: the buffers are new.
+        damage.reset(0);
+        assert_eq!(damage.for_flush(0, 0, Some(rect(5, 5, 6, 6)), whole), Some(whole));
+
+        // The table is per scanout: another scanout's damage is not visible here.
+        let mut damage = FrameDamage::default();
+        assert_eq!(damage.for_flush(0, 0, Some(rect(2, 2, 3, 3)), whole), Some(whole));
+        assert_eq!(damage.for_flush(1, 0, Some(rect(0, 0, 1, 1)), whole), Some(whole));
+        assert_eq!(damage.for_flush(1, 1, Some(rect(4, 4, 5, 5)), whole), Some(whole));
+        // Verifier scenario: the first flush on a second scanout must not be reported as
+        // the first scanout's buffer. Scanout 1's slot 0 owes only its own scanout's
