+    /// The model test: random flush/skip sequences against a full-copy oracle.
+    ///
+    /// The guest updates the resource inside the rect it flushes (the virtio contract),
+    /// so everything that changed in a buffer since it was last written lies inside the
+    /// flush rects issued meanwhile. After each flush the buffer that was written must
+    /// therefore equal the resource *everywhere* — not just over the rect it was given.
+    /// The old rule (accumulate onto the target slot only) fails this: a slot the
+    /// rotation skipped keeps stale pixels.
+    #[test]
+    fn test_frame_damage_matches_a_full_copy_under_random_flushes() {
+        use super::{DamageRect, FrameDamage};
+
+        const W: u32 = 8;
+        const H: u32 = 8;
+        const BPP: usize = 4;
+        const SLOTS: usize = 3;
+        const ITERATIONS: u32 = 5000;
+
+        let stride = W as usize * BPP;
+        let whole = DamageRect { x0: 0, y0: 0, x1: W, y1: H };
+
+        // Deterministic xorshift64, so a failure is reproducible.
+        let mut rng: u64 = 0x9e37_79b9_7f4a_7c15;
+        let mut rand = move |bound: u32| -> u32 {
+            rng ^= rng << 13;
+            rng ^= rng >> 7;
+            rng ^= rng << 17;
+            (rng % bound as u64) as u32
+        };
+
+        // Resource pixels, and what the launcher holds in each frame buffer. A buffer
+        // that is kept right is a byte-for-byte copy of the resource.
+        let mut resource: Vec<u8> = (0..H as usize * stride).map(|i| i as u8).collect();
+        let mut buffers = vec![vec![0u8; H as usize * stride]; SLOTS];
+        let mut damage = FrameDamage::default();
+
+        // Copy the rect from the resource into a buffer at the same offset.
+        let copy = |buf: &mut Vec<u8>, resource: &[u8], rect: DamageRect| {
+            for y in rect.y0..rect.y1 {
+                let start = y as usize * stride + rect.x0 as usize * BPP;
+                let end = y as usize * stride + rect.x1 as usize * BPP;
+                buf[start..end].copy_from_slice(&resource[start..end]);
+            }
+        };
+
+        for i in 0..ITERATIONS {
+            // The rotation skips some slots, as the launcher's alloc_frame does.
+            let slot = if i % 7 == 3 {
+                rand(SLOTS as u32) as usize
+            } else {
+                (i as usize + rand(2) as usize) % SLOTS
+            };
+            // A flush occasionally carries no usable rect (unknown/empty).
+            let damage_rect = if i % 23 == 5 {
+                None
+            } else {
+                let x0 = rand(W);
+                let y0 = rand(H);
+                Some(DamageRect {
+                    x0,
+                    y0,
+                    x1: x0 + 1 + rand(W - x0),
+                    y1: y0 + 1 + rand(H - y0),
+                })
+            };
+
+            // The guest rendered inside the flushed rect before flushing it.
+            if let Some(rect) = damage_rect {
+                for y in rect.y0..rect.y1 {
+                    for x in rect.x0..rect.x1 {
+                        resource[y as usize * stride + x as usize * BPP] = rand(256) as u8;
+                    }
+                }
+            }
+
+            let owed = damage.for_flush(0, slot as u32, damage_rect, whole);
+            match owed {
+                // Nothing owed: the buffer is current, so nothing is copied.
+                None => {}
+                Some(region) => copy(&mut buffers[slot], &resource, region),
+            }
+            if damage_rect.is_none() {
+                copy(&mut buffers[slot], &resource, whole);
+            }
+
+            // The buffer just written must now equal the resource everywhere.
+            assert_eq!(
+                buffers[slot], resource,
+                "flush {i} into slot {slot} (rect {damage_rect:?}) left stale pixels"
+            );
+
+            // Occasionally reconfigure the scanout: the buffers are new.
+            if i % 200 == 199 {
+                damage.reset(0);
+                for buffer in &mut buffers {
+                    buffer.iter_mut().for_each(|b| *b = 0);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn test_damage_rect_clamps_to_the_scanout() {
+        use super::DamageRect;
+
+        let r = DamageRect::from_rect(krun_display::Rect {
+            x: 6,
+            y: 6,
+            width: 4,
+            height: 4,
+        });
+        assert_eq!(r.clamped(8, 8), Some(DamageRect { x0: 6, y0: 6, x1: 8, y1: 8 }));
+        // Fully outside.
+        assert_eq!(r.clamped(4, 4), None);
+        // A zero-sized rect (what a cursor flush may carry) has no damage.
+        assert_eq!(DamageRect::from_rect(krun_display::Rect { x: 0, y: 0, width: 0, height: 0 }).clamped(8, 8), None);
     }
 }
