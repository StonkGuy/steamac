+/// The damage owed to the frame buffers of one scanout.
+///
+/// A buffer owes the whole region over which it still differs from the resource. A
+/// flush lands in one buffer, but by then the guest has already changed the resource
+/// over the flushed rect, and that change landed in no buffer at all — so *every*
+/// buffer is behind by that rect, the one being written included. The buffer written
+/// therefore owes the union of (what it was already behind by) and (the current
+/// rect), while each other buffer owes the union of (what it was behind by) and (the
+/// current rect); the damage a flush owes is to all the buffers. `alloc_frame`
+/// rotates through the backend's buffers, so a slot the launcher skipped carries the
+/// union of the rects flushed since it was last written, and copying only that union
+/// leaves nothing stale. A slot that was never written, and any slot after a
+/// reconfigure (`reset`), has unknown content and is filled whole. `frame_id` is per
+/// scanout, so the table is keyed per scanout as well.
+#[derive(Default)]
+struct FrameDamageScanout {
+    /// One entry per `alloc_frame` slot, indexed by the returned `frame_id`. `None`
+    /// is a buffer that is current (owes nothing); `Some` is the region it owes.
+    slots: Vec<Option<DamageRect>>,
+}
+
+#[derive(Default)]
+struct FrameDamage {
+    scanouts: [FrameDamageScanout; VIRTIO_GPU_MAX_SCANOUTS as usize],
+}
+
+impl FrameDamage {
+    /// The buffers behind `scanout_id` are new (resize, re-attach, format change or
+    /// disable), so nothing may be carried over from the old geometry or format.
+    fn reset(&mut self, scanout_id: u32) {
+        self.scanouts[scanout_id as usize].slots.clear();
+    }
+
+    /// The region to copy into `frame_id` for this flush, or None to copy the whole
+    /// scanout. `damage` is the flush rect (already clamped to the scanout) and is
+    /// None when the driver did not bound the flush. `whole` is the whole scanout,
+    /// used for the buffers that have not been written yet.
+    fn for_flush(
+        &mut self,
+        scanout_id: u32,
+        frame_id: u32,
+        damage: Option<DamageRect>,
+        whole: DamageRect,
+    ) -> Option<DamageRect> {
+        let scanout = &mut self.scanouts[scanout_id as usize];
+        let slot = frame_id as usize;
+        if slot >= scanout.slots.len() {
+            // A slot that has never been written is unknown everywhere: it needs the
+            // whole scanout, not just the current flush's rect.
+            scanout.slots.resize(slot + 1, Some(whole));
+        }
+        let Some(damage) = damage else {
+            // No rect to narrow the flush: the target is filled whole and is thus
+            // current everywhere; every other buffer is behind by the whole scanout.
+            scanout.slots.fill(Some(whole));
+            scanout.slots[slot] = None;
+            return None;
+        };
+        // What the buffer being written owes: the region it was already behind by (what
+        // the flushes into the other buffers since it was last written changed), plus the
+        // rect just changed now — it is stale over that too.
+        let owed = match scanout.slots[slot] {
+            Some(previous) => previous.union(damage),
+            None => damage,
+        };
+        for (i, owed_by) in scanout.slots.iter_mut().enumerate() {
+            if i == slot {
+                continue;
+            }
+            *owed_by = Some(match *owed_by {
+                Some(previous) => previous.union(damage),
+                None => damage,
+            });
+        }
+        // This buffer received everything it owed and the current rect, so it is now
+        // equal to the resource everywhere.
+        scanout.slots[slot] = None;
+        Some(owed)
+    }
+}
