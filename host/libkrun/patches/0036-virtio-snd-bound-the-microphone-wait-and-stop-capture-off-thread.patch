 .../virtio/snd/audio_backends/coreaudio.rs    | 392 ++++++++++++++++--
 1 file changed, 354 insertions(+), 38 deletions(-)

diff --git a/src/devices/src/virtio/snd/audio_backends/coreaudio.rs b/src/devices/src/virtio/snd/audio_backends/coreaudio.rs
index bd7c801..f7ac11b 100644
--- a/src/devices/src/virtio/snd/audio_backends/coreaudio.rs
+++ b/src/devices/src/virtio/snd/audio_backends/coreaudio.rs
@@ -364,6 +364,44 @@ const IO_STALL: Duration = Duration::from_secs(3);
 const WATCHDOG_PERIOD: Duration = Duration::from_millis(250);
 /// Non-zero status the converter input proc returns when the ring has no more frames now.
 const NO_MORE_INPUT: OSStatus = 0x6e6f6d6f; // 'nomo'
+/// Capture: how long the guest's capture I/O waits for the microphone to open after START
+/// (a permission prompt, a stuck HAL). After that it gets clock-paced silence until the unit
+/// runs, so a recording application never waits on the Mac's microphone.
+const CAPTURE_START_WAIT: Duration = Duration::from_millis(200);
+
+#[link(name = "AVFoundation", kind = "framework")]
+extern "C" {
+    static AVMediaTypeAudio: *mut c_void;
+}
+#[link(name = "objc")]
+extern "C" {
+    fn objc_getClass(name: *const c_char) -> *mut c_void;
+    fn sel_registerName(name: *const c_char) -> *mut c_void;
+    // Only used for +[AVCaptureDevice authorizationStatusForMediaType:].
+    fn objc_msgSend(receiver: *mut c_void, selector: *mut c_void, media: *mut c_void) -> isize;
+}
+
+/// This process's microphone permission (TCC): AVAuthorizationStatus and its name.
+fn microphone_permission() -> (isize, &'static str) {
+    // SAFETY: framework class method with one NSString argument and an NSInteger result.
+    let status = unsafe {
+        objc_msgSend(
+            objc_getClass(c"AVCaptureDevice".as_ptr()),
+            sel_registerName(c"authorizationStatusForMediaType:".as_ptr()),
+            AVMediaTypeAudio,
+        )
+    };
+    (
+        status,
+        match status {
+            0 => "undetermined",
+            1 => "restricted",
+            2 => "denied",
+            3 => "authorized",
+            _ => "unknown",
+        },
+    )
+}
 
