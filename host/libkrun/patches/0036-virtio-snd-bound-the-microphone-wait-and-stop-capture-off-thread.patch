+    /// A microphone that does not open (a permission prompt, a stuck HAL) holds the guest's
+    /// capture I/O for at most CAPTURE_START_WAIT; then clock-paced silence flows until it opens.
+    /// (Before: the I/O waited for as long as the start worker did; arecord timed out.)
+    #[test]
+    fn capture_waits_for_the_microphone_at_most_the_start_bound() {
+        let (mut host, streams, message) = capture_fixture();
+        host.shared.running.store(true, Ordering::Release);
+        host.shared.starting.store(true, Ordering::Release);
+        // SAFETY: plain clock read.
+        let now = ticks_to_nanos(unsafe { mach_absolute_time() });
+        let start = Instant::now();
+        host.shared.start_requested.store(now, Ordering::Release);
+        while !completed(&message) {
+            host.pump_input(&mut None, &streams);
+            assert!(
+                start.elapsed() < Duration::from_secs(1),
+                "the 100 ms capture period was still waiting for the microphone after 1 s"
