-/// Capture start worker thread: serves start requests until none is left.
+/// Capture start worker thread: stops retired units, then serves start requests, until none
+/// is left.
 fn capture_start_thread(shared: Arc<Shared>, id: usize) {
-    while let Some(fmt) = shared.start_gate.next(&shared.starting) {
-        capture_start_worker(&shared, fmt, id);
+    while let Some(req) = shared.start_gate.next(&shared.starting) {
+        stop_retired(&shared, id);
+        if let Some(fmt) = req {
+            capture_start_worker(&shared, fmt, id);
+        }
+    }
+}
+
+/// Start worker: stop (and drop) the units taken off the stream, oldest first.
+fn stop_retired(shared: &Shared, id: usize) {
+    let retired = std::mem::take(&mut *shared.retired.lock().unwrap());
+    for mut state in retired {
+        let started = Instant::now();
+        state.stop();
+        if started.elapsed() >= SLOW_UNIT_JOB {
+            log::warn!("snd: stream {id}: stopping the microphone took {:?}", started.elapsed());
+        }
+    }
+}
+
+/// Run the stream's start worker (it serves what the gate holds); false if it could not be
+/// spawned (the gate is then reset).
+fn spawn_capture_worker(shared: &Arc<Shared>, id: usize) -> bool {
+    let worker = Arc::clone(shared);
+    match std::thread::Builder::new()
+        .name(format!("virtio-snd capture {id}"))
+        .spawn(move || capture_start_thread(worker, id))
+    {
+        Ok(_) => true,
+        Err(err) => {
+            log::error!("snd: stream {id}: cannot spawn the capture worker: {err}");
+            shared.start_gate.abandon(&shared.starting);
+            false
+        }
+    }
+}
+
+/// Hand a capture unit taken off its stream to the stream's worker, which stops it before it
+/// opens the next one. The caller (the control thread, the pump under `hosts`) never waits for
+/// `AudioOutputUnitStop`, so STOP and RELEASE complete the guest's queued I/O while the HAL is
+/// stuck. Without a worker thread the unit is stopped here.
+fn retire_capture(shared: &Arc<Shared>, state: CaptureState, id: usize) {
+    shared.retired.lock().unwrap().push(state);
+    if shared.start_gate.kick(&shared.starting) && !spawn_capture_worker(shared, id) {
+        stop_retired(shared, id);
     }
 }
 
