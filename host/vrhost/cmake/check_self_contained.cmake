# Fails when EXE links a dylib outside /usr/lib and /System (e.g. Homebrew's libcrypto).
execute_process(COMMAND otool -L ${EXE} OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
	message(FATAL_ERROR "otool -L failed")
endif()
string(REPLACE "\n" ";" lines "${out}")
list(POP_FRONT lines)
foreach(l IN LISTS lines)
	string(STRIP "${l}" l)
	if(l STREQUAL "")
		continue()
	endif()
	if(NOT l MATCHES "^(/usr/lib/|/System/)")
		message(FATAL_ERROR "non-system library: ${l}")
	endif()
	message(STATUS "${l}")
endforeach()
message(STATUS "self-contained: only /usr/lib and /System libraries")
