#!/usr/bin/python3
"""ExecStartPre of steam.service (Steam is not running): Steam's idle screensaver is off in the VM.

Steam > Settings > Display "Screensaver" (Game Mode) puts a fullscreen Steam window in front of
everything once Steam has seen no input for a few minutes: gamescope moves focus to Steam's
Screensaver_uid<n> window and the next clicks land in Steam's UI until Escape. The launcher's
mouse, tablet and keyboard reset that timer, but a game the player waits for without touching
anything (THE FINALS takes minutes to reach its menu) or plays in VR (headset input never reaches
Steam) is idle to Steam, so the screensaver came up over it. On the Mac, macOS already owns the
display's screensaver and sleep.

Steam keeps the setting in config.vdf at InstallConfigStore/Software/Valve/Steam/System,
"IdleScreensaverACSeconds" and "IdleScreensaverBatterySeconds" ("0" = never); with the
keys absent Steam uses its default timeout. This script adds "0" for each missing key,
once per Steam installation (marker config/steamac-idle-screensaver next to config.vdf),
so a screensaver chosen later in Steam's settings stays. Before Steam's first start there
is no config.vdf and a minimal one is created, which Steam reads and fills in.
"""
import os
from pathlib import Path
import re
import sys
import tempfile

STORE = ("InstallConfigStore", "Software", "Valve", "Steam", "System")
KEYS = ("IdleScreensaverACSeconds", "IdleScreensaverBatterySeconds")
EMPTY = '"InstallConfigStore"\n{\n}\n'


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as out:
            out.write(text)
        os.chmod(tmp, path.stat().st_mode & 0o777 if path.exists() else 0o644)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def vdf_unquote(token):
    if not token.startswith('"'):
        return token
    return re.sub(r'\\([\\"nrt])', lambda m: {"n": "\n", "r": "\r", "t": "\t"}.get(m[1], m[1]), token[1:-1])


def vdf_quote(value):
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t") + '"'


def vdf_entries(text):
    """Return scalar spans and block closing offsets; retain every unrelated byte."""
    tokens = [m for m in re.finditer(r'//[^\n]*|"(?:\\.|[^"\\])*"|[{}]|[^\s{}"]+', text)
              if not m[0].startswith("//")]
    values, blocks, stack = {}, {}, []
    i = 0
    while i < len(tokens):
        token = tokens[i]
        if token[0] == "}":
            if not stack:
                raise ValueError("unbalanced VDF closing brace")
            blocks[tuple(stack)] = token.start()
            stack.pop()
            i += 1
            continue
        if token[0] == "{" or i + 1 == len(tokens):
            raise ValueError("incomplete VDF key/value")
        key = vdf_unquote(token[0]).lower()
        value = tokens[i + 1]
        if value[0] == "{":
            stack.append(key)
        elif value[0] == "}":
            raise ValueError("missing VDF value")
        else:
            path = (*stack, key)
            if path in values:
                raise ValueError("duplicate VDF value")
            values[path] = (vdf_unquote(value[0]), value.start(), value.end())
        i += 2
    if stack:
        raise ValueError("unbalanced VDF opening brace")
    return values, blocks


def vdf_add(text, path, value):
    """Add a missing scalar, creating only missing containers inside the deepest existing one."""
    _, blocks = vdf_entries(text)
    key = tuple(part.lower() for part in path)
    depth = len(key) - 1
    while depth and key[:depth] not in blocks:
        depth -= 1
    if not depth:
        raise ValueError("no InstallConfigStore block")
    addition = "\t" * (len(key) - 1) + vdf_quote(path[-1]) + "\t\t" + vdf_quote(value) + "\n"
    for level in range(len(key) - 2, depth - 1, -1):
        addition = "\t" * level + vdf_quote(path[level]) + "\n" + "\t" * level + "{\n" + addition + "\t" * level + "}\n"
    pos = blocks[key[:depth]]
    # Insert on a line of its own before the container's closing brace.
    start = text.rfind("\n", 0, pos) + 1
    if text[start:pos].strip():
        addition = "\n" + addition
        start = pos
    return text[:start] + addition + text[start:]


def screensaver_off(text):
    """Return (text, added keys) with every missing KEYS value set to "0"."""
    added = []
    for name in KEYS:
        values, _ = vdf_entries(text)
        if (*(part.lower() for part in STORE), name.lower()) not in values:
            text = vdf_add(text, (*STORE, name), "0")
            added.append(name)
    return text, added


def main():
    config = Path.home() / ".local/share/Steam/config/config.vdf"
    marker = config.parent / "steamac-idle-screensaver"
    if marker.exists():
        return
    text = config.read_text() if config.exists() else ""
    changed, added = screensaver_off(text if text.strip() else EMPTY)
    if added:
        atomic_write(config, changed)
        print("steam-idle-screensaver: Steam idle screensaver off (config.vdf " + ", ".join(added) + ")", file=sys.stderr)
    else:
        print("steam-idle-screensaver: screensaver already set in config.vdf, leaving it", file=sys.stderr)
    atomic_write(marker, "1\n")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        print("steam-idle-screensaver: leaving config.vdf: " + str(error), file=sys.stderr)
