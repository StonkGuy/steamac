# steamac: the launcher's virtio-console port "fx.progress" (guest -> host
# progress messages for the FX Steam Launcher overlay) must be writable by
# the session user's fx-progress-agent (and nobody else). The /dev/virtio-ports/fx.progress symlink
# itself comes from systemd's stock 50-udev-default.rules.
SUBSYSTEM=="virtio-ports", ATTR{name}=="fx.progress", OWNER="steamos", GROUP="steamos", MODE="0660"
# steamac: the launcher's port "fx.clock" (host -> guest wall-clock time after
# a resume from suspend) is read by the root service fx-clock-sync.service;
# the device node keeps the default root-only mode.
SUBSYSTEM=="virtio-ports", ATTR{name}=="fx.clock", TAG+="systemd", ENV{SYSTEMD_WANTS}+="fx-clock-sync.service"
# steamac: the launcher's port "fx.pad" (the Mac's controller -> the guest's
# uinput gamepad, its rumble back) is served by the root service fx-pad.service;
# the device node keeps the default root-only mode.
SUBSYSTEM=="virtio-ports", ATTR{name}=="fx.pad", TAG+="systemd", ENV{SYSTEMD_WANTS}+="fx-pad.service"
# The port "fx.sleep" (guest sleep -> the launcher pauses the VM) needs no rule:
# only root's systemd-suspend.service opens it (fx-progress-agent sleep), and
# the default root-only mode is right.
