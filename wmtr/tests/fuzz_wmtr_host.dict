# wmtr wire values (little-endian 8-byte words) for fuzz_wmtr_host: seeded object handles ("WO", bit 40 clear:
# the harness maps the low byte to a valid handle), forged ones (bit 40 set), client handles, references
wo0="\x00\x00\x00\x00\x00\x00\x4f\x57"
wo1="\x01\x00\x00\x00\x00\x00\x4f\x57"
wo5="\x05\x00\x00\x00\x00\x00\x4f\x57"
wo_forged="\x01\x00\x00\x00\x00\x01\x4f\x57"
wo_gen="\x01\x00\x00\x01\x00\x00\x4f\x57"
wc_enc="\x01\x00\x00\x00\x00\x00\x43\x57"
wc_pool="\x01\x00\x00\x00\x00\x80\x43\x57"
ref_extra="\x00\x00\x00\x00\x00\x00\x52\x57"
ref_extra40="\x40\x00\x00\x00\x00\x00\x52\x57"
ref_arena="\x00\x00\x00\x00\x01\x00\x41\x57"
