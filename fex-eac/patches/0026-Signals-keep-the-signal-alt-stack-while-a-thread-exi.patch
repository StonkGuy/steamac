 static bool isHEX(char c) {
   return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
 }
diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls.h b/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls.h
index 7124a05a0..0813fca0b 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls.h
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls.h
@@ -306,6 +306,7 @@ public:
 
   void RegisterTLSState(FEX::HLE::ThreadStateObject* Thread);
   void UninstallTLSState(FEX::HLE::ThreadStateObject* Thread);
+  void ReleaseDeferredTLSState(FEX::HLE::ThreadStateObject* Thread);
 
   SourcecodeResolver* GetSourcecodeResolver() override {
     return this;
diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/ThreadManager.h b/Source/Tools/LinuxEmulation/LinuxSyscalls/ThreadManager.h
index 61fd91aae..7c86004c7 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/ThreadManager.h
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/ThreadManager.h
@@ -69,6 +69,9 @@ struct ThreadStateObject : public FEXCore::Allocator::FEXAllocOperators {
     SignalDelegator* Delegator {};
 
     void* AltStackPtr {};
+    // Set when the thread left the guest (exit) while running on AltStackPtr: the stack could not be released under
+    // itself and is released once the thread is back on its own stack (ReleaseDeferredTLSState).
+    bool AltStackReleaseDeferred {};
     stack_t GuestAltStack {
       .ss_sp = nullptr,
       .ss_flags = SS_DISABLE, // By default the guest alt stack is disabled
diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/Utils/Threads.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/Utils/Threads.cpp
index 8b9c25948..00188fcd7 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/Utils/Threads.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/Utils/Threads.cpp
@@ -347,6 +347,8 @@ namespace PThreads {
     Thread->detach();
 
     if (LongJumpExit) {
+      // Back on this thread's own stack: release the signal alt stack the exit had to keep because it ran on it.
+      FEX::HLE::_SyscallHandler->ReleaseDeferredTLSState(ThreadObject);
       // We have ownership of the thread object. Make sure to clean it up to prevent memory leaks.
       FEX::HLE::_SyscallHandler->TM.DestroyThread(ThreadObject, true);
       if (Status == 0) {
